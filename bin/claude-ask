#!/bin/bash
#
# claude-ask - Ask Claude a question from the terminal with a styled status bar
#
# Usage: claude-ask [OPTIONS] ["question"]
#
# With no question (and a terminal on stdin) it opens a chat: each answer is
# followed by a "> " prompt for the next question in the same conversation.
# At the prompt, \e composes the question in $EDITOR; exit, quit or Ctrl-D
# ends the chat; Ctrl-C stops the current answer. Piped input with no
# question is read as one question.
#
# Options:
#   -i, --interactive  Keep the chat open after answering the question
#   -r, --resume       Continue the most recent saved session (with a
#                      question: ask it there; without: chat there)
#   --theme THEME      Status bar theme: minimal, bubbles, powerline (default: minimal)
#   --pager CMD        Pager command for markdown output, run with bash -c (default: nvimpager)
#   --no-pager         Disable pager, output raw text
#   --demo-themes       Show example status bars for all themes and exit
#   --demo-output       Simulate streaming with mock responses (small/medium/large) and exit
#   --no-stream        Don't stream output; show status bar only, render markdown when complete
#   --save-raw         Also save the raw JSON stream, as NAME.jsonl beside NAME.json
#   --history          List saved sessions
#   --session [ID|N]   View a saved session by name/id or index number
#   --debug-log[=FILE] Write debug messages to FILE
#                      (default: ${XDG_STATE_HOME:-~/.local/state}/claude-ask/debug.log)
#   --version          Print the version and exit
#   -h, --help         Show this help message
#
# Examples:
#   claude-ask                                    # start a chat
#   claude-ask "What is the capital of France?"
#   claude-ask -i "Explain git rebase"            # answer, then keep chatting
#   claude-ask -r "And with --onto?"              # follow up in the last session
#   claude-ask -r                                 # continue the last session as a chat
#   git diff | claude-ask                         # piped input is the question
#   claude-ask --theme powerline "Explain git rebase"
#   claude-ask --demo-themes
#   claude-ask --no-pager "List common bash shortcuts"
#   claude-ask --history                          # list saved sessions
#   claude-ask --session 1                        # view most recent session
#   claude-ask --session git-bare                 # view session by name
#   claude-ask --debug-log "What is 2+2?"         # enable debug logging
#
# Environment:
#   SESSION_DIR        Where sessions are saved (default: ~/.local/share/claude/cli-sessions)
#   CLAUDE_ASK_BIN     The claude command to run (default: claude)
#   CLAUDE_ASK_DEMO_DELAY  Seconds between demo frames (default: 0.08 themes, 0.03 output)
#   CLAUDE_ASK_FORCE_INTERACTIVE  Chat even when stdin is not a terminal (tests)

set -euo pipefail

# Numbers are formatted with "." whatever the user's locale (the cost comes
# from jq with a "." and printf would reject it under a comma-decimal
# LC_NUMERIC; EPOCHREALTIME would use a ","). LC_ALL would
# override LC_NUMERIC, so it moves to LANG, keeping the character encoding.
if [[ -n "${LC_ALL:-}" ]]; then
  export LANG="$LC_ALL"
  unset LC_ALL
fi
export LC_NUMERIC=C

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------
THEME="minimal"
# PAGER_CMD="bat --color=always -l markdown --paging=never --wrap=auto"
PAGER_CMD='command nvimpager -c -- -c "colorscheme nord-nick | set termguicolors | set ft=markdown"'
USE_PAGER=1
STREAM_OUTPUT=1
SAVE_RAW=0
DEMO_THEMES=0
DEMO_OUTPUT=0
SHOW_HISTORY=0
VIEW_SESSION=""
INTERACTIVE=0
RESUME=0
DEBUG_LOG=""
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/claude-ask"
DEFAULT_DEBUG_LOG="$STATE_DIR/debug.log"
CHAT_HISTORY_FILE="$STATE_DIR/history"
MAX_DISPLAY_NAME=20
SESSION_DIR="${SESSION_DIR:-$HOME/.local/share/claude/cli-sessions}"
CLAUDE_BIN="${CLAUDE_ASK_BIN:-claude}"

# ---------------------------------------------------------------------------
# Debug logging (must be defined before arg parsing)
# ---------------------------------------------------------------------------
debug_log() {
  [[ -z "${DEBUG_LOG:-}" ]] && return
  local now="$EPOCHREALTIME" # seconds.microseconds, no date(1) needed
  local frac="${now#*[.,]}"
  printf '[%(%H:%M:%S)T.%s] %s\n' "${now%[.,]*}" "${frac:0:3}" "$*" >> "$DEBUG_LOG"
}

# ---------------------------------------------------------------------------
# CLI argument parsing
# ---------------------------------------------------------------------------
# Print the version from the VERSION file next to bin/ (the script is
# usually installed as a symlink into the repo, so resolve it first)
print_version() {
  local root version="unknown"
  root="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.."
  if [[ -r "$root/VERSION" ]]; then
    version=$(< "$root/VERSION")
  fi
  printf 'claude-ask %s\n' "$version"
}

usage() {
  sed -n '2,/^$/s/^# \{0,1\}//p' "$0"
  exit 0
}

POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --theme)
      [[ $# -lt 2 ]] && {
        echo "Error: --theme requires an argument" >&2
        exit 1
      }
      THEME="$2"
      if [[ ! "$THEME" =~ ^(minimal|bubbles|powerline)$ ]]; then
        echo "Error: --theme must be one of: minimal, bubbles, powerline" >&2
        exit 1
      fi
      shift 2
      ;;
    --pager)
      [[ $# -lt 2 ]] && {
        echo "Error: --pager requires an argument" >&2
        exit 1
      }
      PAGER_CMD="$2"
      shift 2
      ;;
    --no-pager)
      USE_PAGER=0
      shift
      ;;
    -i | --interactive)
      INTERACTIVE=1
      shift
      ;;
    -r | --resume)
      RESUME=1
      shift
      ;;
    --demo-themes)
      DEMO_THEMES=1
      shift
      ;;
    --demo-output)
      DEMO_OUTPUT=1
      shift
      ;;
    --no-stream)
      STREAM_OUTPUT=0
      shift
      ;;
    --save-raw)
      SAVE_RAW=1
      shift
      ;;
    --history)
      SHOW_HISTORY=1
      shift
      ;;
    --session)
      if [[ $# -ge 2 && ! "$2" =~ ^- ]]; then
        VIEW_SESSION="$2"
        shift 2
      else
        VIEW_SESSION="__SHOW_HISTORY__"
        shift
      fi
      ;;
    --debug-log)
      DEBUG_LOG="$DEFAULT_DEBUG_LOG"
      shift
      ;;
    --debug-log=*)
      DEBUG_LOG="${1#--debug-log=}"
      if [[ -z "$DEBUG_LOG" ]]; then
        echo "Error: --debug-log= requires a file name" >&2
        exit 1
      fi
      shift
      ;;
    --version)
      print_version
      exit 0
      ;;
    -h | --help)
      usage
      ;;
    --)
      shift
      POSITIONAL+=("$@")
      break
      ;;
    -*)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

if [[ -n "$DEBUG_LOG" ]]; then
  mkdir -p "$(dirname "$DEBUG_LOG")"
fi

# Fail early, with a clear message, when a required command is missing
require_cmds() {
  local cmd missing=()
  for cmd in "$@"; do
    command -v "$cmd" > /dev/null 2>&1 || missing+=("$cmd")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "claude-ask: required command not found: ${missing[*]}" >&2
    exit 127
  fi
}
require_cmds jq

debug_log "args parsed: THEME=$THEME USE_PAGER=$USE_PAGER SAVE_RAW=$SAVE_RAW SHOW_HISTORY=$SHOW_HISTORY VIEW_SESSION=$VIEW_SESSION"

question="${POSITIONAL[*]:-}"

# Chat when there is no question and a person is typing; piped input with no
# question is the question itself
if [[ "$DEMO_THEMES" -eq 0 && "$DEMO_OUTPUT" -eq 0 && "$SHOW_HISTORY" -eq 0 && -z "$VIEW_SESSION" && -z "$question" ]]; then
  if [[ -t 0 || -n "${CLAUDE_ASK_FORCE_INTERACTIVE:-}" ]]; then
    INTERACTIVE=1
  elif [[ "$INTERACTIVE" -eq 0 ]]; then
    question="$(cat)"
    debug_log "question read from stdin, length=${#question}"
    if [[ ! "$question" =~ [^[:space:]] ]]; then
      echo "No question provided." >&2
      exit 1
    fi
  fi
fi
debug_log "mode: INTERACTIVE=$INTERACTIVE RESUME=$RESUME question_len=${#question}"

# ---------------------------------------------------------------------------
# Catppuccin Mocha palette -> ANSI 256/truecolor escape sequences
# Using truecolor (24-bit) since modern terminals support it
# ---------------------------------------------------------------------------
# Foreground: \e[38;2;R;G;Bm   Background: \e[48;2;R;G;Bm
RST=$'\e[0m'
BOLD=$'\e[1m'

# Palette colors (catppuccin mocha)
FG_CLAUDE=$'\e[38;2;217;119;87m' # #D97757
BG_CLAUDE=$'\e[48;2;49;50;68m'   # #313244

FG_MODEL=$'\e[38;2;116;199;236m' # #74c7ec

FG_COST=$'\e[38;2;166;227;161m' # #a6e3a1
BG_COST=$'\e[48;2;69;71;90m'    # #45475a

FG_TOKENS=$'\e[38;2;137;220;235m' # #89dceb (directory color reused)
BG_TOKENS=$'\e[48;2;30;30;46m'    # #1e1e2e

FG_DURATION=$'\e[38;2;235;160;172m' # #eba0ac (git_branch color reused)
BG_DURATION=$'\e[48;2;49;50;68m'    # #313244

FG_DIM=$'\e[38;2;108;112;134m' # #6c7086 overlay0

# Separator characters for themed transitions
# Bubbles: round caps    Powerline: angular arrows
SEP_BUBBLE_LEFT=$'\ue0b6'  #
SEP_BUBBLE_RIGHT=$'\ue0b4' #
SEP_POWERLINE=$'\ue0b0'    #

# Spinner frames
SPINNER=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")

# ---------------------------------------------------------------------------
# Renderers and format helpers
#
# Each one writes its result into the variable named by its first argument,
# like printf -v, instead of printing it: the status bar is redrawn on every
# stream event, and calling these in $(...) cost a subshell (and often a bc)
# per value. The output variable must not share a name with the function's
# own locals, which would shadow it, so every local here starts with "_" and
# output variable names must not.
# ---------------------------------------------------------------------------

# Theme renderers: OUT spinner_char model tokens_in tokens_out cost duration status
render_minimal() {
  local _out="$1" _spin="$2" _model="$3" _tok_in="$4" _tok_out="$5" _cost="$6" _dur="$7" _status="$8"
  local _line=""
  _line+="${FG_CLAUDE}${_spin}${RST} "
  _line+="${FG_MODEL}${_model}${RST}"
  if [[ -n "$_tok_in" ]]; then
    _line+=" ${FG_DIM}|${RST} ${FG_TOKENS}in:${_tok_in}${RST}"
  fi
  if [[ -n "$_tok_out" ]]; then
    _line+=" ${FG_TOKENS}out:${_tok_out}${RST}"
  fi
  if [[ -n "$_cost" ]]; then
    _line+=" ${FG_DIM}|${RST} ${FG_COST}${_cost}${RST}"
  fi
  if [[ -n "$_dur" ]]; then
    _line+=" ${FG_DIM}|${RST} ${FG_DURATION}${_dur}${RST}"
  fi
  if [[ "$_status" == "done" ]]; then
    _line+=" ${FG_DIM}|${RST} ${FG_COST}done${RST}"
  fi
  printf -v "$_out" '%s' "$_line"
}

render_bubbles() {
  local _out="$1" _spin="$2" _model="$3" _tok_in="$4" _tok_out="$5" _cost="$6" _dur="$7" _status="$8"
  local _line=""

  # Claude bubble (spinner + model)
  _line+="${FG_CLAUDE}${SEP_BUBBLE_LEFT}${BG_CLAUDE} ${FG_CLAUDE}${_spin} ${FG_MODEL}${_model} ${RST}${FG_CLAUDE}${SEP_BUBBLE_RIGHT}${RST}"

  # Tokens bubble
  if [[ -n "$_tok_in" || -n "$_tok_out" ]]; then
    local _tok_str=""
    [[ -n "$_tok_in" ]] && _tok_str+="in:${_tok_in}"
    [[ -n "$_tok_out" ]] && _tok_str+=" out:${_tok_out}"
    _line+=" ${FG_TOKENS}${SEP_BUBBLE_LEFT}${BG_TOKENS} ${FG_TOKENS}${_tok_str} ${RST}${FG_TOKENS}${SEP_BUBBLE_RIGHT}${RST}"
  fi

  # Cost bubble
  if [[ -n "$_cost" ]]; then
    _line+=" ${FG_COST}${SEP_BUBBLE_LEFT}${BG_COST} ${FG_COST}${_cost} ${RST}${FG_COST}${SEP_BUBBLE_RIGHT}${RST}"
  fi

  # Duration bubble
  if [[ -n "$_dur" ]]; then
    _line+=" ${FG_DURATION}${SEP_BUBBLE_LEFT}${BG_DURATION} ${FG_DURATION}${_dur} ${RST}${FG_DURATION}${SEP_BUBBLE_RIGHT}${RST}"
  fi

  # Status indicator
  if [[ "$_status" == "done" ]]; then
    _line+=" ${FG_COST}${SEP_BUBBLE_LEFT}${BG_COST} ${FG_COST}done ${RST}${FG_COST}${SEP_BUBBLE_RIGHT}${RST}"
  fi

  printf -v "$_out" '%s' "$_line"
}

render_powerline() {
  local _out="$1" _spin="$2" _model="$3" _tok_in="$4" _tok_out="$5" _cost="$6" _dur="$7" _status="$8"
  local _line=""
  # Each separator arrow takes the color of the segment before it
  local _prev_fg="${FG_CLAUDE}"

  # Decorative start + claude segment
  _line+="${FG_CLAUDE}░▒▓${BG_CLAUDE} ${FG_CLAUDE}${_spin} ${FG_MODEL}${_model} ${RST}"

  # Tokens segment
  if [[ -n "$_tok_in" || -n "$_tok_out" ]]; then
    local _tok_str=""
    [[ -n "$_tok_in" ]] && _tok_str+="in:${_tok_in}"
    [[ -n "$_tok_out" ]] && _tok_str+=" out:${_tok_out}"
    _line+="${BG_TOKENS}${_prev_fg}${SEP_POWERLINE}${RST}${BG_TOKENS} ${FG_TOKENS}${_tok_str} ${RST}"
    _prev_fg="${FG_TOKENS}"
  fi

  # Cost segment
  if [[ -n "$_cost" ]]; then
    _line+="${BG_COST}${_prev_fg}${SEP_POWERLINE}${RST}${BG_COST} ${FG_COST}${_cost} ${RST}"
    _prev_fg="${FG_COST}"
  fi

  # Duration segment
  if [[ -n "$_dur" ]]; then
    _line+="${BG_DURATION}${_prev_fg}${SEP_POWERLINE}${RST}${BG_DURATION} ${FG_DURATION}${_dur} ${RST}"
    _prev_fg="${FG_DURATION}"
  fi

  # Status / end cap
  if [[ "$_status" == "done" ]]; then
    _line+="${BG_COST}${_prev_fg}${SEP_POWERLINE}${RST}${BG_COST} ${FG_COST}done ${RST}${FG_COST}${SEP_POWERLINE}${RST}"
  else
    _line+="${_prev_fg}${SEP_POWERLINE}${RST}"
  fi

  printf -v "$_out" '%s' "$_line"
}

render_status_bar() {
  case "$THEME" in
    minimal) render_minimal "$@" ;;
    bubbles) render_bubbles "$@" ;;
    powerline) render_powerline "$@" ;;
  esac
}

# OUT N DIV: N / DIV with one decimal, truncated ("19.9" for 19900 / 1000),
# in integer arithmetic; this is what bc with scale=1 used to produce
_one_decimal() {
  printf -v "$1" '%d.%d' "$(($2 / $3))" "$((($2 % $3) * 10 / $3))"
}

# OUT N: 950, 19.9k, 2.5M
_format_magnitude() {
  local _out="$1" _n="$2"
  if ((_n >= 1000000)); then
    _one_decimal "$_out" "$_n" 1000000
    printf -v "$_out" '%sM' "${!_out}"
  elif ((_n >= 1000)); then
    _one_decimal "$_out" "$_n" 1000
    printf -v "$_out" '%sk' "${!_out}"
  else
    printf -v "$_out" '%d' "$_n"
  fi
}

# OUT N: a token count; empty for none or zero
format_tokens() {
  if [[ -z "$2" || "$2" == "0" ]]; then
    printf -v "$1" '%s' ""
  else
    _format_magnitude "$1" "$2"
  fi
}

# OUT N: a character count; 0 for none
format_count() {
  _format_magnitude "$1" "${2:-0}"
}

# OUT MS: 500ms, 7.4s, 1m30s; empty for none
format_duration() {
  local _out="$1" _ms="$2"
  if [[ -z "$_ms" ]]; then
    printf -v "$_out" '%s' ""
  elif ((_ms >= 60000)); then
    printf -v "$_out" '%dm%ds' "$((_ms / 60000))" "$(((_ms % 60000) / 1000))"
  elif ((_ms >= 1000)); then
    _one_decimal "$_out" "$_ms" 1000
    printf -v "$_out" '%ss' "${!_out}"
  else
    printf -v "$_out" '%dms' "$_ms"
  fi
}

# OUT USD: $0.0950; empty for none
format_cost() {
  if [[ -z "$2" ]]; then
    printf -v "$1" '%s' ""
  else
    printf -v "$1" '$%.4f' "$2"
  fi
}

# OUT SECONDS: 42s, 3m5s, 1h2m; 0s for none or negative
format_elapsed() {
  local _out="$1" _secs="$2"
  if [[ -z "$_secs" ]] || ((_secs <= 0)); then
    printf -v "$_out" '0s'
  elif ((_secs >= 3600)); then
    printf -v "$_out" '%dh%dm' "$((_secs / 3600))" "$(((_secs % 3600) / 60))"
  elif ((_secs >= 60)); then
    printf -v "$_out" '%dm%ds' "$((_secs / 60))" "$((_secs % 60))"
  else
    printf -v "$_out" '%ds' "$_secs"
  fi
}

# OUT lines chars chunks elapsed status is_thinking [extra]: the line under
# the bar; extra (e.g. "turn 3 | $0.0412 total") is appended
render_stream_info() {
  local _out="$1" _lines="$2" _chars="$3" _chunks="$4" _elapsed="$5" _is_done="$6" _is_thinking="${7:-0}" _extra="${8:-}"
  local _info="  ${FG_DIM}" _count_str _elapsed_str
  if [[ "$_is_thinking" -eq 1 && "$_is_done" != "done" ]]; then
    _info+="thinking... ${FG_DIM}|${RST}${FG_DIM} "
  fi
  format_count _count_str "$_chars"
  _info+="${_lines} lines ${FG_DIM}|${RST}${FG_DIM} "
  _info+="${_count_str} chars ${FG_DIM}|${RST}${FG_DIM} "
  _info+="${_chunks} chunks"
  if [[ "$_is_done" != "done" && -n "$_elapsed" ]]; then
    format_elapsed _elapsed_str "$_elapsed"
    _info+=" ${FG_DIM}|${RST}${FG_DIM} ${_elapsed_str}"
  fi
  if [[ -n "$_extra" ]]; then
    _info+=" ${FG_DIM}|${RST}${FG_DIM} ${_extra}"
  fi
  _info+="${RST}"
  printf -v "$_out" '%s' "$_info"
}

# ---------------------------------------------------------------------------
# Stream parsing, shared by the main loop, --demo-output and the tests
# ---------------------------------------------------------------------------

# Shorten a model id such as "claude-opus-4-6[1m]" to "opus"
short_model_name() {
  local m="${1%%\[*}"
  case "${m,,}" in
    *haiku*) m="haiku" ;;
    *sonnet*) m="sonnet" ;;
    *opus*) m="opus" ;;
  esac
  printf '%s' "$m"
}

# Reset every variable process_stream_line writes
reset_stream_state() {
  model=""
  session_id=""
  spinner_idx=0
  input_tokens=""
  output_tokens=""
  cost=""
  duration_ms=""
  answer_text=""
  status="running" # running, done or error
  stream_error=""
  is_thinking=0
  answer_lines=0
  answer_chars=0
  text_chunks=0
  CHUNK=""
}

# One jq call per event. The fields come back NUL-terminated, so text may
# hold any character: type, model, session_id, text (every text block
# joined), has_thinking, input tokens, output tokens, cost, duration_ms,
# is_error, result text.
# shellcheck disable=SC2016 # $u is a jq variable
STREAM_FIELDS_JQ='
  (if .type == "result" then .usage else .message.usage end) as $u
  | [ .type, .model, .session_id,
      ([.message.content[]? | select(.type == "text") | .text] | join("")),
      (if any(.message.content[]?; .type == "thinking") then 1 else 0 end),
      $u.input_tokens, $u.output_tokens, .total_cost_usd, .duration_ms,
      (if .is_error == true then 1 else 0 end),
      (if .type == "result" then .result else null end) ]
  | map((. // "" | tostring) + "\u0000") | add'
STREAM_FIELD_COUNT=11

# Parse one stream-json line into the state variables. CHUNK is set to the
# answer text the line added (empty if none). Returns 1 for lines that change
# nothing on screen: blank, not JSON, no type, or a rate_limit_event.
process_stream_line() {
  local line="$1" f=()
  CHUNK=""
  [[ -n "$line" ]] || return 1
  mapfile -d '' -t f < <(printf '%s' "$line" | jq -j "$STREAM_FIELDS_JQ" 2> /dev/null)
  [[ ${#f[@]} -eq $STREAM_FIELD_COUNT && -n "${f[0]}" ]] || return 1

  case "${f[0]}" in
    system)
      if [[ -n "${f[1]}" ]]; then model=$(short_model_name "${f[1]}"); fi
      if [[ -n "${f[2]}" ]]; then session_id="${f[2]}"; fi
      ;;
    assistant)
      if [[ -n "${f[3]}" ]]; then
        is_thinking=0
        CHUNK="${f[3]}"
        answer_text+="$CHUNK"
        text_chunks=$((text_chunks + 1))
        answer_chars=$((answer_chars + ${#CHUNK}))
        local newlines="${CHUNK//[!$'\n']/}"
        answer_lines=$((answer_lines + ${#newlines}))
      elif [[ "${f[4]}" == 1 ]]; then
        is_thinking=1
      fi
      ;;
    result)
      status="done"
      if [[ -n "${f[7]}" ]]; then cost="${f[7]}"; fi
      if [[ -n "${f[8]}" ]]; then duration_ms="${f[8]}"; fi
      if [[ "${f[9]}" == 1 ]]; then
        status="error"
        stream_error="${f[10]:-claude reported an error}"
      fi
      ;;
    rate_limit_event)
      return 1
      ;;
  esac

  # Token counts: under .message for assistant events, top-level for result
  if [[ "${f[0]}" == assistant || "${f[0]}" == result ]]; then
    if [[ -n "${f[5]}" ]]; then input_tokens="${f[5]}"; fi
    if [[ -n "${f[6]}" ]]; then output_tokens="${f[6]}"; fi
  fi
  return 0
}

# Run the pager on stdin; bash -c so quotes inside PAGER_CMD are honored
run_pager() {
  bash -c "$PAGER_CMD"
}

# ---------------------------------------------------------------------------
# Session saving
# ---------------------------------------------------------------------------
# A session file holds one conversation: "turns" lists every question and
# answer; the top level keeps the first question, the last answer and the
# totals (cost, durations, tokens) so older readers still find them. Files
# saved before turns existed are read as a single turn (SESSION_TURNS_JQ).
#
# shellcheck disable=SC2016 # jq programs
SESSION_TURNS_JQ='
  def turns_of:
    if .turns then .turns
    else [{question, answer, is_error: (.is_error // false), thinking,
           cost_usd, duration_ms, duration_api_ms, usage, timestamp}]
    end;'

# Build one turn from a raw stream (NUL-free, one JSON event per line) and add
# it to $prev (the existing session, or none). The init event, not the first
# system event, has model and cwd: hook events come before it.
# shellcheck disable=SC2016 # jq program
SESSION_JQ="${SESSION_TURNS_JQ}"'
  def total(f): [.[] | f | numbers] | if length > 0 then add else null end;
  [inputs | fromjson? | objects] as $events
  | ($events | map(select(.type == "system" and .subtype == "init")) | first) as $init
  | ($events | map(select(.type == "system")) | first) as $sys
  | ($events | map(select(.type == "result")) | last) as $res
  | ($prev | first) as $p
  | {
      question: $question,
      answer: ($res.result // null),
      is_error: ($res.is_error // false),
      thinking: ([$events[] | select(.type == "assistant") | .message.content[]?
                  | select(.type == "thinking") | .thinking]
                 | if length > 0 then join("\n") else null end),
      cost_usd: ($res.total_cost_usd // null),
      duration_ms: ($res.duration_ms // null),
      duration_api_ms: ($res.duration_api_ms // null),
      usage: {
        input_tokens: ($res.usage.input_tokens // null),
        output_tokens: ($res.usage.output_tokens // null),
        cache_creation_input_tokens: ($res.usage.cache_creation_input_tokens // null),
        cache_read_input_tokens: ($res.usage.cache_read_input_tokens // null)
      },
      timestamp: (now | todate)
    } as $turn
  | (if $p then ($p | turns_of) else [] end) + [$turn] as $turns
  | {
      session_id: ($init.session_id // $sys.session_id // $p.session_id // null),
      model: ($init.model // $p.model // null),
      name: $name,
      cwd: ($p.cwd // $init.cwd // null),
      question: $turns[0].question,
      answer: ($turns | last | .answer),
      is_error: ($turns | last | .is_error),
      thinking: ($turns | last | .thinking),
      cost_usd: ($turns | total(.cost_usd)),
      duration_ms: ($turns | total(.duration_ms)),
      duration_api_ms: ($turns | total(.duration_api_ms)),
      usage: {
        input_tokens: ($turns | total(.usage.input_tokens)),
        output_tokens: ($turns | total(.usage.output_tokens)),
        cache_creation_input_tokens: ($turns | total(.usage.cache_creation_input_tokens)),
        cache_read_input_tokens: ($turns | total(.usage.cache_read_input_tokens))
      },
      turn_count: ($turns | length),
      turns: $turns,
      timestamp: $turn.timestamp
    }'

# Name for a new session file: the question's slug, or for a question with
# no ASCII letters or digits (e.g. CJK only) the session id or the time,
# rather than a hidden ".json"
new_session_name() {
  local raw="$1" question="$2" slug sid
  slug=$(slugify_question "$question")
  if [[ -z "$slug" ]]; then
    sid=$(jq -nR -r '[inputs | fromjson? | objects | select(.type == "system")]
      | first | .session_id // empty' "$raw")
    if [[ -n "$sid" ]]; then
      slug="session-${sid:0:8}"
    else
      printf -v slug 'session-%(%Y%m%d-%H%M%S)T' -1
    fi
  fi
  unique_session_name "$slug" "$SESSION_DIR"
}

# save_session RAW QUESTION [FILE]: add the turn in RAW to FILE (an existing
# session), or to a new session file named after QUESTION. With --save-raw
# the raw stream is also appended to NAME.jsonl. Prints the file's path.
save_session() {
  local raw="$1" question="$2" file="${3:-}" name prev tmp
  if [[ -n "$file" && -f "$file" ]]; then
    name=$(basename "$file" .json)
    prev="$file"
  else
    name=$(new_session_name "$raw" "$question")
    file="${SESSION_DIR}/${name}.json"
    prev=/dev/null
  fi
  debug_log "saving session turn: name=$name file=$file"
  # Written beside the target and moved, so a failed save leaves the old file
  tmp="${file}.tmp.$$"
  if jq -nR --arg question "$question" --arg name "$name" --slurpfile prev "$prev" \
    "$SESSION_JQ" "$raw" > "$tmp"; then
    mv -f "$tmp" "$file"
  else
    rm -f "$tmp"
    return 1
  fi
  if [[ "$SAVE_RAW" -eq 1 ]]; then
    cat "$raw" >> "${SESSION_DIR}/${name}.jsonl"
  fi
  printf '%s\n' "$file"
}

# ---------------------------------------------------------------------------
# Theme demo mode: show all themes with sample data and exit
# ---------------------------------------------------------------------------
run_theme_demo() {
  local themes=("minimal" "bubbles" "powerline")
  local sample_model="opus"
  local sample_in="19.9k"
  local sample_out="275"
  local sample_cost="\$0.0950"
  local sample_dur="7.4s"

  local bar_text
  for theme in "${themes[@]}"; do
    echo "${BOLD}${theme}${RST}"

    # In-progress state (with spinner)
    THEME="$theme"
    printf '  streaming: '
    local idx=0
    for _ in {1..10}; do
      local s="${SPINNER[$idx]}"
      printf '\r  streaming: '
      render_status_bar bar_text "$s" "$sample_model" "$sample_in" "$sample_out" "" "" "running"
      printf '%s' "$bar_text"
      idx=$(((idx + 1) % ${#SPINNER[@]}))
      sleep "${CLAUDE_ASK_DEMO_DELAY:-0.08}"
    done
    printf '\n'

    # Finished state
    printf '  finished:  '
    render_status_bar bar_text "✓" "$sample_model" "$sample_in" "$sample_out" "$sample_cost" "$sample_dur" "done"
    printf '%s' "$bar_text"
    printf '\n\n'
  done
}

if [[ "$DEMO_THEMES" -eq 1 ]]; then
  run_theme_demo
  exit 0
fi

# ---------------------------------------------------------------------------
# Mock stream-json data generator for demo-output mode
# Generates realistic stream-json events with configurable size and delay.
# Usage: generate_mock_stream SIZE [DELAY]
#   SIZE:  small, medium, large
#   DELAY: seconds between chunks (default: 0.05)
# ---------------------------------------------------------------------------
MOCK_SMALL_TEXT='The capital of France is **Paris**.'
MOCK_MEDIUM_TEXT='## The Capital of France

