#!/usr/bin/env bash
#
# claude-ask - Ask Claude a question from the terminal with a styled status bar
#
# Usage: claude-ask [OPTIONS] ["question"]
#
# With no question (and a terminal on stdin) it opens a chat: each answer is followed by a "> " prompt for the next question in the same conversation. At the prompt, \e composes the question in $EDITOR; /effort [LEVEL] and /model [NAME] show or change the effort level and model for the next questions ("default" clears them); /yank [code [N]] copies the last answer or its code blocks; /help lists the rest, and Tab completes them; exit, quit or Ctrl-D ends the chat; Ctrl-C stops the current answer (at the prompt, it clears the line). Piped input is read as the question, or added after the one given; with -i the chat then goes on at the terminal. When stdout is not a terminal it gets only the answer.
#
# Options (--option=VALUE also works; short flags bundle: -ir):
#   -i, --interactive        Keep the chat open after answering the question
#   -r, --resume             Continue the most recent saved session (with a question: ask it there; without: chat there); it keeps the session's effort and model unless -e or -m is given
#       --resume=ID|N        The same for the session that ID or N names (as for --session: a --history number, a name or a prefix)
#   -e, --effort LEVEL       Effort (thinking) level: low, medium, high, xhigh, max (default: claude's own, from its settings)
#   -m, --model MODEL        Model alias (opus, sonnet, haiku, fable) or full name
#   -y, --yank               Copy the answer to the clipboard (and a tmux buffer); with no question, copy the last answer of the newest session (or of --session ID|N) and exit
#   -Y, --yank-code[=N]      The same for the answer's code blocks (only the Nth)
#       --split[=h|v]        Run in a new tmux pane, side by side (h) or one above the other (v), chosen from the pane's shape by default. With a question the answer goes there (and it stays as a chat) while you stay here; without, you chat there.
#       --popup              Run in a tmux popup: a question's answer is paged and quitting the pager closes it; without one, a chat until /quit
#       --theme THEME        Status bar theme: minimal, bubbles, powerline (default: minimal)
#       --pager CMD          Pager command for markdown output, run with bash -c (default: nvcat --pager less; plain text if nvcat is missing)
#       --no-pager           Disable pager, output raw text
#       --demo-themes        Show example status bars for all themes and exit
#       --demo-output        Simulate streaming with mock responses (small/medium/large) and exit
#       --no-stream          Don't stream output; show status bar only, render markdown when complete
#       --save-raw           Also save the raw JSON stream, as NAME.jsonl beside NAME.json
#       --history[=N]        List saved sessions (only the newest N)
#       --search TEXT        List the sessions with TEXT in a question or an answer, any case, with their --history numbers
#       --delete ID|N        Delete a saved session, asking first
#       --prune AGE          Delete sessions older than AGE (30d, 8w, 12h; a plain number is days), asking first
#       --force              Do not ask; without a terminal, needed to delete at all
#       --claude-arg WORD    One more word for claude's command line (repeat for each, so --claude-arg --add-dir --claude-arg ../src); -r keeps them and says which
#       --session [ID|N]     View a saved session by name/id or index number
#       --debug-log[=FILE]   Write debug messages to FILE (default: ~/.local/state/claude-ask/debug.log, or under XDG_STATE_HOME)
#       --completions SHELL  Print the completion script for bash, zsh or fish: eval "$(claude-ask --completions bash)", source <(claude-ask --completions zsh), claude-ask --completions fish | source
#       --version            Print the version and exit
#   -h, --help               Show this help message
#
# Examples:
#   claude-ask                                        # start a chat
#   claude-ask "What is the capital of France?"
#   claude-ask -i "Explain git rebase"                # answer, then keep chatting
#   claude-ask -r "And with --onto?"                  # follow up in the last session
#   claude-ask -r                                     # continue the last session as a chat
#   claude-ask --resume=3                             # chat in the third newest session
#   claude-ask -e high -m sonnet "Review this design"
#   claude-ask -Y "A bash loop over lines of a file"  # copy the code
#   claude-ask -y                                     # copy the last answer
#   claude-ask --split "Explain this error"           # answer in a new pane
#   claude-ask --popup                                # chat in a tmux popup
#   git diff | claude-ask                             # piped input is the question
#   git diff | claude-ask "Review this"               # or follows the question
#   claude-ask "List 3 colors" > colors.txt           # just the answer, no bar in it
#   claude-ask --theme powerline "Explain git rebase"
#   claude-ask --demo-themes
#   claude-ask --no-pager "List common bash shortcuts"
#   claude-ask --history                              # list saved sessions
#   claude-ask --session 1                            # view most recent session
#   claude-ask --session git-bare                     # view session by name
#   claude-ask --debug-log "What is 2+2?"             # enable debug logging
#
# Environment:
#   SESSION_DIR                   Where sessions are saved (default: ~/.local/share/claude-ask/sessions, or under XDG_DATA_HOME)
#   VISUAL, EDITOR                The editor for \e, with any arguments (default: vi)
#   CLAUDE_ASK_BIN                The claude command to run (default: claude)
#   CLAUDE_ASK_PAGER              The default pager command (default: nvcat --pager less)
#   CLAUDE_ASK_EFFORT             The default effort level (-e overrides it)
#   CLAUDE_ASK_MODEL              The default model (-m overrides it)
#   CLAUDE_ASK_DEMO_DELAY         Seconds between demo frames (default: 0.08 themes, 0.03 output)
#   CLAUDE_ASK_FORCE_INTERACTIVE  Chat even when stdin is not a terminal (tests)
#   CLAUDE_ASK_FORCE_TTY          Draw as if stdout were a terminal (tests)
#   CLAUDE_ASK_RENDER_EVERY       Milliseconds between pager runs while streaming (default: twice the time the last run took)
#   NO_COLOR                      When set and not empty, no colors
#   CLAUDE_ASK_COLORS             truecolor, 256, 16 or none (default: from COLORTERM and TERM)
#   CLAUDE_ASK_ARGS               Words for claude's command line, quoted as in a shell
#   CLAUDE_ASK_COLUMNS            The terminal width the status bar is fitted to (default: the terminal's own)
#   CLAUDE_ASK_CLIPBOARD          Command that copies stdin, run with bash -c (default: wl-copy, xclip, xsel or pbcopy)
#   CLAUDE_ASK_POPUP_SIZE         --popup's size, WIDTH or WIDTHxHEIGHT (default: 80%)
#   CLAUDE_ASK_POPUP_PAGER        Pager for the answer in --popup (default: less -R -+F)
set -euo pipefail

# First, before anything bash 3.2 (macOS's own) would stumble on: mapfile,
# coproc and EPOCHREALTIME are used from here on
require_bash() {
  if (($1 < 5)); then
    echo "claude-ask: needs bash 5 or newer, and this is bash $1 ($BASH)" >&2
    exit 1
  fi
}
require_bash "${BASH_VERSINFO[0]}"

# Started by --split or --popup: this shell's environment, which tmux would
# not pass on, from the private file launch_in_tmux wrote. Deleting it is also
# how launch_in_tmux can tell the run started.
if [[ -n "${_CLAUDE_ASK_ENV_FILE:-}" ]]; then
  if [[ -O "$_CLAUDE_ASK_ENV_FILE" ]]; then
    # shellcheck disable=SC1090 # written by launch_in_tmux
    # Not a reason to give up if one variable cannot be set
    source "$_CLAUDE_ASK_ENV_FILE" 2> /dev/null || true
    rm -f "$_CLAUDE_ASK_ENV_FILE"
  fi
  unset _CLAUDE_ASK_ENV_FILE
fi

# Numbers are formatted with "." whatever the user's locale (the cost comes
# from jq with a "." and printf would reject it under a comma-decimal
# LC_NUMERIC; EPOCHREALTIME would use a ","). LC_ALL would
# override LC_NUMERIC, so it moves to LANG, keeping the character encoding.
# That is for this script: restore_locale puts them back for what it starts on the
# user's behalf.
ORIG_LOCALE=()
for _var in LC_ALL LANG LC_NUMERIC; do
  if [[ -n "${!_var+set}" ]]; then ORIG_LOCALE+=("$_var=${!_var}"); fi
done
unset _var
restore_locale() {
  local entry
  unset LC_ALL LANG LC_NUMERIC
  for entry in "${ORIG_LOCALE[@]}"; do
    export "${entry%%=*}=${entry#*=}"
  done
}
if [[ -n "${LC_ALL:-}" ]]; then
  export LANG="$LC_ALL"
  unset LC_ALL
fi
export LC_NUMERIC=C

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------
THEME="minimal"
THEMES=(minimal bubbles powerline)
MODEL_ALIASES=(opus sonnet haiku fable)
# nvcat renders Markdown with Neovim; it pages with less only when writing to
# a terminal, so while streaming (output read back through a pipe) it prints
PAGER_CMD="${CLAUDE_ASK_PAGER:-nvcat --pager less}"
PAGER_IS_DEFAULT=1
USE_PAGER=1
STREAM_OUTPUT=1
SAVE_RAW=0
DEMO_THEMES=0
DEMO_OUTPUT=0
SHOW_HISTORY=0
HISTORY_LIMIT=0 # --history=N
SEARCH_TEXT=""
DELETE_SESSION=""
PRUNE_AGE=""
FORCE=0
CLAUDE_CLI_ARGS=() # --claude-arg words
VIEW_SESSION=""
INTERACTIVE=0
RESUME=0
RESUME_ARG="" # --resume=ID|N: the session to continue (empty: the newest)
DEBUG_LOG=""
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/claude-ask"
DEFAULT_DEBUG_LOG="$STATE_DIR/debug.log"
CHAT_HISTORY_FILE="$STATE_DIR/history"
MAX_DISPLAY_NAME=20
DEFAULT_SESSION_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/claude-ask/sessions"
OLD_SESSION_DIR="$HOME/.local/share/claude/cli-sessions" # before 0.10.0
SESSION_DIR_CHOSEN="${SESSION_DIR:+1}"
SESSION_DIR="${SESSION_DIR:-$DEFAULT_SESSION_DIR}"
CLAUDE_BIN="${CLAUDE_ASK_BIN:-claude}"
# Passed to claude as --effort and --model; empty means claude's own default.
# The stream never says which effort claude used, so only one set here is shown.
EFFORT="${CLAUDE_ASK_EFFORT:-}"
MODEL="${CLAUDE_ASK_MODEL:-}"
EFFORT_RE='^(low|medium|high|xhigh|max)$'
EFFORT_LEVELS="low, medium, high, xhigh, max"
# Terminal width for fitting the status bar (0: unknown, nothing is fitted);
# read_term_cols sets it, CLAUDE_ASK_COLUMNS overrides it
TERM_COLS=0
YANK=""          # answer or code: copy each new answer, or its code blocks
YANK_CODE_N=""   # with code: only this block
YANK_PREVIOUS=0  # -y/-Y with no question: copy a saved answer and exit
TMUX_MODE=""     # split or popup
SPLIT_DIR="auto" # h, v or auto

# ---------------------------------------------------------------------------
# Debug logging (must be defined before arg parsing)
# ---------------------------------------------------------------------------
# return 0, not return: in a trap a bare return gives the status from before
# the trap, and under set -e that ended cleanup at its first line
debug_log() {
  [[ -z "${DEBUG_LOG:-}" ]] && return 0
  local now="$EPOCHREALTIME" # seconds.microseconds, no date(1) needed
  local frac="${now#*[.,]}"
  printf '[%(%H:%M:%S)T.%s] %s\n' "${now%[.,]*}" "${frac:0:3}" "$*" >> "$DEBUG_LOG"
}

# ---------------------------------------------------------------------------
# CLI argument parsing
# ---------------------------------------------------------------------------
# In the script itself, so a copy of it knows; a test keeps it the same as VERSION
CLAUDE_ASK_VERSION="0.15.5"
print_version() {
  printf 'claude-ask %s\n' "$CLAUDE_ASK_VERSION"
}

# --help: the header comment, in color at a terminal and fitted to its width.
# Plain ANSI colors, which any depth of terminal shows, since the palette is not
# set up yet here.
usage() {
  local text head opt env dim off cols="${CLAUDE_ASK_COLUMNS:-}" size
  text=$(sed -n '2,/^$/s/^# \{0,1\}//p' "$0")
  if [[ -t 1 && -z "${NO_COLOR:-}" && "${CLAUDE_ASK_COLORS:-}" != none && "${TERM:-}" != dumb ]]; then
    head=$'\e[1;33m' opt=$'\e[36m' env=$'\e[32m' dim=$'\e[2m' off=$'\e[0m'
    # The headings last: the ranges below look for them without their color
    text=$(printf '%s\n' "$text" | sed -E \
      -e "/^Options/,/^Examples/s~^( +)(-([^ ]| [^ ])*)~\1$opt\2$off~" \
      -e "/^Examples/,/^Environment/s~(  +# .*)\$~$dim\1$off~" \
      -e "/^Environment/,\$s~^  ([A-Z]([^ ]| [^ ])*)~  $env\1$off~" \
      -e "s~^(Usage:)~$head\1$off~" \
      -e "s~^((Options|Examples|Environment).*:)\$~$head\1$off~")
  fi
  if [[ -z "$cols" && -t 1 ]] && size=$(stty size 2> /dev/null < /dev/tty); then
    cols="${size#* }"
  fi
  if [[ "$cols" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s\n' "$text" | awk -v cols="$cols" "$USAGE_WRAP_AWK"
  else
    printf '%s\n' "$text"
  fi
  exit 0
}

# Wrap --help to cols: a paragraph at the left edge, and an option's or a
# variable's description under where it starts. That is after the first two or
# more spaces past the name, which no name has. With under 20 columns left there,
# or a word that would not fit in them, it goes under a small indent instead, so
# nothing runs back into the names. Examples stay whole: a wrapped command
# would be a wrong one. Lengths are counted without color codes.
# shellcheck disable=SC2016 # awk program
USAGE_WRAP_AWK='
  function visible(s) { gsub(/\033\[[0-9;]*m/, "", s); return length(s) }
  function wrap(first, rest, indent, width,   n, words, i, line, pad) {
    pad = sprintf("%" indent "s", "")
    n = split(rest, words, " ")
    line = first
    used = visible(first)
    for (i = 1; i <= n; i++) {
      if (i > 1 && used + 1 + length(words[i]) > cols) {
        print line
        line = pad words[i]
        used = indent + length(words[i])
      } else if (i == 1) {
        line = line words[i]
        used += length(words[i])
      } else {
        line = line " " words[i]
        used += 1 + length(words[i])
      }
    }
    print line
  }
  {
    plain = $0
    gsub(/\033\[[0-9;]*m/, "", plain)
    if (plain ~ /^Options/) { section = "list" }
    else if (plain ~ /^Examples/) { section = "examples" }
    else if (plain ~ /^Environment/) { section = "list" }
    if (visible($0) <= cols || section == "examples" || plain ~ /^(Options|Environment)/) {
      print
    } else if (section == "list" && match($0, /[^ ]  +[^ ]/)) {
      headlen = RSTART + RLENGTH - 2
      first = substr($0, 1, headlen)
      rest = substr($0, headlen + 1)
      indent = visible(first)
      longest = 0
      n = split(rest, parts, " ")
      for (w = 1; w <= n; w++) if (length(parts[w]) > longest) longest = length(parts[w])
      if (cols - indent < 20 || longest > cols - indent) {
        sub(/ +$/, "", first)
        print first
        wrap("        ", rest, 8, cols)
      } else {
        wrap(first, rest, indent, cols)
      }
    } else {
      wrap("", $0, 0, cols)
    }
  }'

# print_completions SHELL: the completion script for SHELL. They are all here,
# so a script copied on its own can still print them. test/completion.bats runs
# each against its real shell; a new option needs adding to all three.
print_completions() {
  case "$1" in
    bash)
      cat << 'CLAUDE_ASK_COMPLETION'
# bash completion for claude-ask: eval "$(claude-ask --completions bash)", or
# save it as ${XDG_DATA_HOME:-~/.local/share}/bash-completion/completions/claude-ask

_claude_ask_options="-i --interactive -r --resume --resume= -e --effort --effort=
  -m --model --model= -y --yank -Y --yank-code --yank-code= --split --split= --popup
  --theme --theme= --pager --pager= --no-pager --demo-themes --demo-output --no-stream
  --save-raw --history --history= --session --session= --search --search= --delete --delete=
  --prune --prune= --force --claude-arg --claude-arg= --debug-log --debug-log= --completions --completions=
  --version -h --help"

# Saved session names (for --session and --resume=)
_claude_ask_sessions() {
  local dir="${SESSION_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/claude-ask/sessions}" f name
  for f in "$dir"/*.json; do
    [[ -e "$f" ]] || continue
    name="${f##*/}"
    printf '%s\n' "${name%.json}"
  done
}

# _claude_ask_reply WORD CANDIDATE...: COMPREPLY from the candidates that
# start with WORD
_claude_ask_reply() {
  local word="$1" c
  shift
  COMPREPLY=()
  for c in "$@"; do
    if [[ "$c" == "$word"* ]]; then COMPREPLY+=("$c"); fi
  done
}

_claude_ask() {
  local cur="${COMP_WORDS[COMP_CWORD]}" prev="" opt=""
  local -a names
  if ((COMP_CWORD > 0)); then prev="${COMP_WORDS[COMP_CWORD - 1]}"; fi

  # bash splits --opt=value at the = (COMP_WORDBREAKS): "--opt" "=" "value"
  if [[ "$cur" == "=" ]]; then
    opt="$prev"
    cur=""
  elif [[ "$prev" == "=" ]] && ((COMP_CWORD > 1)); then
    opt="${COMP_WORDS[COMP_CWORD - 2]}"
  elif [[ "$cur" == --*=* ]]; then
    # COMP_WORDBREAKS without =
    opt="${cur%%=*}"
    cur="${cur#*=}"
  fi
  if [[ -n "$opt" ]]; then
    case "$opt" in
      --resume | --session | --delete)
        mapfile -t names < <(_claude_ask_sessions)
        _claude_ask_reply "$cur" "${names[@]}"
        ;;
      --split) _claude_ask_reply "$cur" h v auto ;;
      --completions) _claude_ask_reply "$cur" bash zsh fish ;;
      --effort) _claude_ask_reply "$cur" low medium high xhigh max ;;
      --model) _claude_ask_reply "$cur" opus sonnet haiku fable ;;
      --theme) _claude_ask_reply "$cur" minimal bubbles powerline ;;
      --pager) mapfile -t COMPREPLY < <(compgen -c -- "$cur") ;;
      --debug-log) mapfile -t COMPREPLY < <(compgen -f -- "$cur") ;;
      *) COMPREPLY=() ;;
    esac
    return 0
  fi

  case "$prev" in
    -e | --effort)
      _claude_ask_reply "$cur" low medium high xhigh max
      return 0
      ;;
    -m | --model)
      _claude_ask_reply "$cur" opus sonnet haiku fable
      return 0
      ;;
    --theme)
      _claude_ask_reply "$cur" minimal bubbles powerline
      return 0
      ;;
    --completions)
      _claude_ask_reply "$cur" bash zsh fish
      return 0
      ;;
    --pager)
      mapfile -t COMPREPLY < <(compgen -c -- "$cur")
      return 0
      ;;
    --session | --delete)
      if [[ "$cur" != -* ]]; then
        mapfile -t names < <(_claude_ask_sessions)
        _claude_ask_reply "$cur" "${names[@]}"
        return 0
      fi
      ;;
  esac

  if [[ "$cur" == -* ]]; then
    # shellcheck disable=SC2086 # the option list is split into words
    _claude_ask_reply "$cur" $_claude_ask_options
    # An option ending in = takes its value with no space after it
    if [[ ${#COMPREPLY[@]} -eq 1 && "${COMPREPLY[0]}" == *= ]]; then
      compopt -o nospace 2> /dev/null || true
    fi
  else
    # The question
    COMPREPLY=()
  fi
  return 0
}

complete -F _claude_ask claude-ask
CLAUDE_ASK_COMPLETION
      ;;
    zsh)
      cat << 'CLAUDE_ASK_COMPLETION'
#compdef claude-ask
# zsh completion for claude-ask: source <(claude-ask --completions zsh), or save
# it as _claude-ask in a directory on fpath

# Saved session names (for --session and --resume=), newest first, as
# --history numbers them
_claude-ask_sessions() {
  local dir=${SESSION_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/claude-ask/sessions}
  local -a files names
  files=( $dir/*.json(N.om) )
  names=( ${${files:t}%.json} )
  _describe -V -t sessions 'saved session' names
}

_claude-ask() {
  local -a efforts=(low medium high xhigh max)
  local -a models=(opus sonnet haiku fable)
  local -a themes=(minimal bubbles powerline)

  _arguments -s -S \
    '(-i --interactive)'{-i,--interactive}'[keep the chat open after the answer]' \
    '(--resume)-r[continue the newest saved session]' \
    '(-r)--resume=-[continue the newest saved session, or the one named]::session:_claude-ask_sessions' \
    "(--effort)-e[effort (thinking) level]:level:($efforts)" \
    "(-e)--effort=[effort (thinking) level]:level:($efforts)" \
    "(--model)-m[model alias or full name]:model:($models)" \
    "(-m)--model=[model alias or full name]:model:($models)" \
    '(-y --yank -Y --yank-code)'{-y,--yank}'[copy the answer to the clipboard]' \
    '(-y --yank --yank-code)-Y[copy the code blocks of the answer]' \
    '(-y --yank -Y)--yank-code=-[copy the code blocks of the answer (only the Nth)]::block number: ' \
    '(--popup)--split=-[run in a new tmux pane]::direction:((h\:side\ by\ side v\:one\ above\ the\ other auto\:from\ the\ shape\ of\ the\ pane))' \
    '(--split)--popup[run in a tmux popup]' \
    "--theme=[status bar theme]:theme:($themes)" \
    '(--no-pager)--pager=[pager command, run with bash -c]:pager command:_command_names -e' \
    '(--pager)--no-pager[print plain text, no pager]' \
    '--demo-themes[show example status bars and exit]' \
    '--demo-output[simulate streamed answers and exit]' \
    '--no-stream[show the answer when it is complete]' \
    '--save-raw[also save the raw JSON stream]' \
    '--history=-[list saved sessions (only the newest N)]::number: ' \
    '--search=[list sessions with this text]:text: ' \
    '--delete=[delete a saved session]:session:_claude-ask_sessions' \
    '--prune=[delete sessions older than this]:age (30d, 8w, 12h): ' \
    '--force[do not ask before deleting]' \
    '*--claude-arg=[one more word for the claude command line]:word: ' \
    '--session=[view a saved session]::session:_claude-ask_sessions' \
    '--debug-log=-[write debug messages to a file]::file:_files' \
    '(- *)--completions=[print a completion script and exit]:shell:(bash zsh fish)' \
    '(- *)--version[print the version and exit]' \
    '(- *)'{-h,--help}'[show the help and exit]' \
    '*::question: '
}

# Autoloaded from fpath this file is the completion function's body; sourced, it
# has to register the function
if [[ "${funcstack[1]:-}" == _claude-ask ]]; then
  _claude-ask "$@"
else
  compdef _claude-ask claude-ask
fi
CLAUDE_ASK_COMPLETION
      ;;
    fish)
      cat << 'CLAUDE_ASK_COMPLETION'
# fish completion for claude-ask: claude-ask --completions fish | source, or save
# it as ${XDG_CONFIG_HOME:-~/.config}/fish/completions/claude-ask.fish

# Saved session names (for --session, --resume and --delete), newest first, as
# --history numbers them
function __claude_ask_sessions
    set -l dir $SESSION_DIR
    if test -z "$dir"
        set -l data $XDG_DATA_HOME
        test -n "$data"; or set data $HOME/.local/share
        set dir $data/claude-ask/sessions
    end
    command ls -t -- $dir 2>/dev/null | string match '*.json' | string replace -r '\.json$' ''
end

# The rest of the line is the question, not file names
complete -c claude-ask -f

complete -c claude-ask -s i -l interactive -d 'Keep the chat open after the answer'
complete -c claude-ask -s r -d 'Continue the newest saved session'
complete -c claude-ask -l resume -x -k -a '(__claude_ask_sessions)' -d 'Continue a saved session'
complete -c claude-ask -s e -l effort -x -a 'low medium high xhigh max' -d 'Effort (thinking) level'
complete -c claude-ask -s m -l model -x -a 'opus sonnet haiku fable' -d 'Model alias or full name'
complete -c claude-ask -s y -l yank -d 'Copy the answer to the clipboard'
complete -c claude-ask -s Y -l yank-code -d 'Copy the code blocks of the answer'
complete -c claude-ask -l split -f -a 'h v auto' -d 'Run in a new tmux pane'
complete -c claude-ask -l popup -d 'Run in a tmux popup'
complete -c claude-ask -l theme -x -a 'minimal bubbles powerline' -d 'Status bar theme'
complete -c claude-ask -l pager -x -a '(__fish_complete_command)' -d 'Pager command, run with bash -c'
complete -c claude-ask -l no-pager -d 'Print plain text, no pager'
complete -c claude-ask -l demo-themes -d 'Show example status bars and exit'
complete -c claude-ask -l demo-output -d 'Simulate streamed answers and exit'
complete -c claude-ask -l no-stream -d 'Show the answer when it is complete'
complete -c claude-ask -l save-raw -d 'Also save the raw JSON stream'
complete -c claude-ask -l history -d 'List saved sessions'
complete -c claude-ask -l session -x -k -a '(__claude_ask_sessions)' -d 'View a saved session'
complete -c claude-ask -l search -x -d 'List sessions with this text'
complete -c claude-ask -l delete -x -k -a '(__claude_ask_sessions)' -d 'Delete a saved session'
complete -c claude-ask -l prune -x -a '30d 8w 12h' -d 'Delete sessions older than this'
complete -c claude-ask -l force -d 'Do not ask before deleting'
complete -c claude-ask -l claude-arg -x -d 'One more word for the claude command line'
complete -c claude-ask -l debug-log -r -F -d 'Write debug messages to a file'
complete -c claude-ask -l completions -x -a 'bash zsh fish' -d 'Print a completion script and exit'
complete -c claude-ask -l version -d 'Print the version and exit'
complete -c claude-ask -s h -l help -d 'Show the help and exit'
CLAUDE_ASK_COMPLETION
      ;;
    *)
      echo "Error: --completions takes bash, zsh or fish" >&2
      exit 1
      ;;
  esac
}

# is_theme NAME: whether NAME is one of THEMES
is_theme() {
  [[ " ${THEMES[*]} " == *" $1 "* && "$1" != *" "* ]]
}

POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --theme=* | --effort=* | --model=* | --pager=* | --session=* | --search=* | --delete=* | --prune=* | --claude-arg=* | --completions=*)
      set -- "${1%%=*}" "${1#*=}" "${@:2}"
      continue
      ;;
    --theme)
      [[ $# -lt 2 ]] && {
        echo "Error: --theme requires an argument" >&2
        exit 1
      }
      THEME="$2"
      if ! is_theme "$THEME"; then
        echo "Error: --theme must be one of: ${THEMES[*]}" >&2
        exit 1
      fi
      shift 2
      ;;
    -e | --effort)
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "Error: $1 requires an argument" >&2
        exit 1
      fi
      EFFORT="$2"
      shift 2
      ;;
    -m | --model)
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "Error: $1 requires an argument" >&2
        exit 1
      fi
      MODEL="$2"
      shift 2
      ;;
    -y | --yank)
      YANK=answer
      shift
      ;;
    -Y | --yank-code)
      YANK=code
      shift
      ;;
    --yank-code=*)
      YANK=code
      YANK_CODE_N="${1#--yank-code=}"
      if [[ ! "$YANK_CODE_N" =~ ^[1-9][0-9]*$ ]]; then
        echo "Error: --yank-code=N takes a block number from 1" >&2
        exit 1
      fi
      shift
      ;;
    --split)
      TMUX_MODE="split"
      shift
      ;;
    --split=*)
      TMUX_MODE="split"
      SPLIT_DIR="${1#--split=}"
      if [[ ! "$SPLIT_DIR" =~ ^(h|v|auto)$ ]]; then
        echo "Error: --split= takes h, v or auto" >&2
        exit 1
      fi
      shift
      ;;
    --popup)
      TMUX_MODE=popup
      shift
      ;;
    --pager)
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "Error: --pager requires an argument" >&2
        exit 1
      fi
      PAGER_CMD="$2"
      PAGER_IS_DEFAULT=0
      shift 2
      ;;
    --no-pager)
      USE_PAGER=0
      shift
      ;;
    -i | --interactive)
      INTERACTIVE=1
      shift
      ;;
    -r | --resume)
      RESUME=1
      shift
      ;;
    --resume=*)
      RESUME=1
      RESUME_ARG="${1#--resume=}"
      if [[ -z "$RESUME_ARG" ]]; then
        echo "Error: --resume= takes a session name or number" >&2
        exit 1
      fi
      shift
      ;;
    --demo-themes)
      DEMO_THEMES=1
      shift
      ;;
    --demo-output)
      DEMO_OUTPUT=1
      shift
      ;;
    --no-stream)
      STREAM_OUTPUT=0
      shift
      ;;
    --save-raw)
      SAVE_RAW=1
      shift
      ;;
    --history)
      SHOW_HISTORY=1
      shift
      ;;
    --history=*)
      SHOW_HISTORY=1
      HISTORY_LIMIT="${1#--history=}"
      if [[ ! "$HISTORY_LIMIT" =~ ^[1-9][0-9]*$ ]]; then
        echo "Error: --history= takes a number from 1" >&2
        exit 1
      fi
      shift
      ;;
    --search)
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "Error: --search requires an argument" >&2
        exit 1
      fi
      SHOW_HISTORY=1
      SEARCH_TEXT="$2"
      shift 2
      ;;
    --delete)
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "Error: --delete requires a session name or number" >&2
        exit 1
      fi
      DELETE_SESSION="$2"
      shift 2
      ;;
    --prune)
      if [[ $# -lt 2 || ! "$2" =~ ^[0-9]+[hdw]?$ ]]; then
        echo "Error: --prune takes an age: 30d, 8w, 12h, or a number of days" >&2
        exit 1
      fi
      PRUNE_AGE="$2"
      shift 2
      ;;
    --force)
      FORCE=1
      shift
      ;;
    --claude-arg)
      if [[ $# -lt 2 ]]; then
        echo "Error: --claude-arg requires an argument" >&2
        exit 1
      fi
      CLAUDE_CLI_ARGS+=("$2")
      shift 2
      ;;
    --session)
      if [[ $# -ge 2 && -n "$2" && ! "$2" =~ ^- ]]; then
        VIEW_SESSION="$2"
        shift 2
      else
        VIEW_SESSION="__SHOW_HISTORY__"
        shift
      fi
      ;;
    --debug-log)
      DEBUG_LOG="$DEFAULT_DEBUG_LOG"
      shift
      ;;
    --debug-log=*)
      DEBUG_LOG="${1#--debug-log=}"
      if [[ -z "$DEBUG_LOG" ]]; then
        echo "Error: --debug-log= requires a file name" >&2
        exit 1
      fi
      shift
      ;;
    --completions)
      if [[ $# -lt 2 ]]; then
        echo "Error: --completions takes bash, zsh or fish" >&2
        exit 1
      fi
      print_completions "$2"
      exit 0
      ;;
    --version)
      print_version
      exit 0
      ;;
    -h | --help)
      usage
      ;;
    --)
      shift
      POSITIONAL+=("$@")
      break
      ;;
    -[a-zA-Z][a-zA-Z]*)
      # Bundled short flags: -ir is -i -r, and -ie high is -i -e high
      set -- "${1:0:2}" "-${1:2}" "${@:2}"
      continue
      ;;
    -*)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

if [[ -n "$DEBUG_LOG" ]]; then
  mkdir -p "$(dirname "$DEBUG_LOG")"
fi

# Checked after parsing so a bad CLAUDE_ASK_EFFORT is caught too
if [[ -n "$EFFORT" && ! "$EFFORT" =~ $EFFORT_RE ]]; then
  echo "Error: effort must be one of: $EFFORT_LEVELS" >&2
  exit 1
fi

# The words for claude's command line: CLAUDE_ASK_ARGS, split with its shell
# quoting (xargs, so nothing in it runs), then each --claude-arg. What
# claude-ask itself sets or reads the output of cannot be given here.
CLAUDE_ARGS=()
if [[ "${CLAUDE_ASK_ARGS:-}" =~ [^[:space:]] ]]; then
  if ! xargs printf '%s\0' <<< "$CLAUDE_ASK_ARGS" > /dev/null 2>&1; then
    echo "Error: CLAUDE_ASK_ARGS has unmatched quotes" >&2
    exit 1
  fi
  mapfile -d '' -t CLAUDE_ARGS < <(xargs printf '%s\0' <<< "$CLAUDE_ASK_ARGS")
fi
CLAUDE_ARGS+=("${CLAUDE_CLI_ARGS[@]}")
for _word in "${CLAUDE_ARGS[@]}"; do
  case "${_word%%=*}" in
    -p | --print | -r | --resume | -c | --continue | --output-format | --input-format | --verbose | --include-partial-messages)
      echo "Error: claude-ask sets $_word itself; it cannot be passed on" >&2
      exit 1
      ;;
    --effort | --model)
      echo "Error: use claude-ask's own ${_word%%=*} instead of passing it on" >&2
      exit 1
      ;;
  esac
done
unset _word

# Sessions from before 0.10.0 move once to the new default place. A failed move
# stays usable: the old place is used, and it is tried again next time.
if [[ -z "$SESSION_DIR_CHOSEN" && -d "$OLD_SESSION_DIR" && ! -e "$SESSION_DIR" ]]; then
  if (
    umask 077
    mkdir -p "${SESSION_DIR%/*}"
  ) && mv "$OLD_SESSION_DIR" "$SESSION_DIR" 2> /dev/null; then
    echo "claude-ask: moved saved sessions to $SESSION_DIR" >&2
  else
    SESSION_DIR="$OLD_SESSION_DIR"
    SESSION_DIR_CHOSEN=1
  fi
fi

# Fail early, with a clear message, when a required command is missing
require_cmds() {
  local cmd missing=()
  for cmd in "$@"; do
    command -v "$cmd" > /dev/null 2>&1 || missing+=("$cmd")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "claude-ask: required command not found: ${missing[*]}" >&2
    exit 127
  fi
}
require_cmds jq

# A default pager that is not installed means plain text, not a failed run;
# a --pager given on the command line is used as it is
if [[ "$USE_PAGER" -eq 1 && "$PAGER_IS_DEFAULT" -eq 1 ]]; then
  read -r pager_prog pager_rest <<< "$PAGER_CMD"
  if [[ "$pager_prog" == "command" ]]; then read -r pager_prog _ <<< "$pager_rest"; fi
  if ! command -v "$pager_prog" > /dev/null 2>&1; then
    debug_log "default pager $pager_prog not found, printing plain text"
    USE_PAGER=0
  fi
fi

debug_log "args parsed: EFFORT=${EFFORT:-default} MODEL=${MODEL:-default} THEME=$THEME USE_PAGER=$USE_PAGER SAVE_RAW=$SAVE_RAW SHOW_HISTORY=$SHOW_HISTORY VIEW_SESSION=$VIEW_SESSION"

question="${POSITIONAL[*]:-}"

# --split and --popup hand the question to the new claude-ask in a private
# temp file (a long piped question could be too big for a tmux command)
if [[ -n "${_CLAUDE_ASK_QUESTION_TMP:-}" ]]; then
  if [[ -z "$question" && -f "$_CLAUDE_ASK_QUESTION_TMP" ]]; then
    question=$(< "$_CLAUDE_ASK_QUESTION_TMP")
  fi
  rm -f "$_CLAUDE_ASK_QUESTION_TMP"
  unset _CLAUDE_ASK_QUESTION_TMP
fi

# Read all of stdin into PIPED_INPUT, saying so if it takes a while: a stdin
# that never ends (inherited from a parent) waits until Ctrl-C. The note's
# sleep has its own fds, so it cannot hold a caller's pipe open once killed.
read_piped_input() {
  local note
  (
    sleep 2 > /dev/null 2>&1
    echo "claude-ask: waiting for piped input (< /dev/null skips it)" >&2
  ) &
  note=$!
  PIPED_INPUT=$(cat)
  kill "$note" 2> /dev/null || true
  wait "$note" 2> /dev/null || true
}

# With a terminal on stdin (or the tests' stand-in, whose stdin is the typed
# input), no question means a chat, or with -y or -Y copying a saved answer.
# Otherwise stdin is input: the whole question, or what follows the one given
# (only a pipe or a file, so /dev/null or a socket is not waited on), and -i
# goes on to chat on the terminal, which it refuses to do when there is none
# rather than take lines of a pipe for questions.
if [[ "$DEMO_THEMES" -eq 0 && "$DEMO_OUTPUT" -eq 0 && "$SHOW_HISTORY" -eq 0 && -z "$VIEW_SESSION" && -z "$DELETE_SESSION" && -z "$PRUNE_AGE" ]]; then
  if [[ -t 0 || -n "${CLAUDE_ASK_FORCE_INTERACTIVE:-}" ]]; then
    if [[ -z "$question" ]]; then
      if [[ -n "$YANK" && "$INTERACTIVE" -eq 0 && "$RESUME" -eq 0 ]]; then
        YANK_PREVIOUS=1
      else
        INTERACTIVE=1
      fi
    fi
  else
    PIPED_INPUT=""
    if [[ -z "$question" || -p /dev/stdin || -f /dev/stdin ]]; then
      read_piped_input
      debug_log "piped input, length=${#PIPED_INPUT}"
    fi
    if [[ "$PIPED_INPUT" =~ [^[:space:]] ]]; then
      question+="${question:+$'\n\n'}$PIPED_INPUT"
    fi
    if [[ -z "$question" && "$INTERACTIVE" -eq 0 ]]; then
      echo "No question provided." >&2
      exit 1
    fi
    # A new pane or popup has its own terminal
    if [[ "$INTERACTIVE" -eq 1 && -z "$TMUX_MODE" ]]; then
      if ! { exec < /dev/tty; } 2> /dev/null; then
        echo "Error: -i needs a terminal to chat on" >&2
        exit 1
      fi
    fi
  fi
fi
debug_log "mode: INTERACTIVE=$INTERACTIVE RESUME=$RESUME YANK=${YANK:-none} TMUX_MODE=${TMUX_MODE:-none} question_len=${#question}"

if [[ -n "$TMUX_MODE" ]]; then
  if [[ "$DEMO_THEMES" -eq 1 || "$DEMO_OUTPUT" -eq 1 || "$SHOW_HISTORY" -eq 1 || -n "$VIEW_SESSION" || -n "$DELETE_SESSION" || -n "$PRUNE_AGE" || "$YANK_PREVIOUS" -eq 1 ]]; then
    echo "Error: --$TMUX_MODE runs a question or a chat" >&2
    exit 1
  fi
  if [[ -z "${TMUX:-}" ]] || ! command -v tmux > /dev/null 2>&1; then
    echo "Error: --$TMUX_MODE needs tmux: run it inside a tmux session" >&2
    exit 1
  fi
fi

# ---------------------------------------------------------------------------
# Catppuccin Mocha palette -> ANSI 256/truecolor escape sequences
# Using truecolor (24-bit) since modern terminals support it
# ---------------------------------------------------------------------------
# Foreground: \e[38;2;R;G;Bm   Background: \e[48;2;R;G;Bm
RST=$'\e[0m'
BOLD=$'\e[1m'

# Palette colors (catppuccin mocha)
FG_CLAUDE=$'\e[38;2;217;119;87m' # #D97757
BG_CLAUDE=$'\e[48;2;49;50;68m'   # #313244

FG_MODEL=$'\e[38;2;116;199;236m'  # #74c7ec
FG_EFFORT=$'\e[38;2;203;166;247m' # #cba6f7 mauve

FG_COST=$'\e[38;2;166;227;161m' # #a6e3a1
BG_COST=$'\e[48;2;69;71;90m'    # #45475a

FG_TOKENS=$'\e[38;2;137;220;235m' # #89dceb (directory color reused)
BG_TOKENS=$'\e[48;2;30;30;46m'    # #1e1e2e

FG_DURATION=$'\e[38;2;235;160;172m' # #eba0ac (git_branch color reused)
BG_DURATION=$'\e[48;2;49;50;68m'    # #313244

FG_DIM=$'\e[38;2;108;112;134m' # #6c7086 overlay0

# Separator characters for themed transitions
# Bubbles: round caps    Powerline: angular arrows
SEP_BUBBLE_LEFT=$'\ue0b6'  #
SEP_BUBBLE_RIGHT=$'\ue0b4' #
SEP_POWERLINE=$'\ue0b0'    #

# How many colors the terminal shows: CLAUDE_ASK_COLORS, else what COLORTERM and
# TERM say. Over ssh COLORTERM is often not passed on, which only means 256.
COLOR_DEPTH="${CLAUDE_ASK_COLORS:-}"
if [[ -n "${NO_COLOR:-}" ]]; then
  COLOR_DEPTH=none
elif [[ -z "$COLOR_DEPTH" && "${TERM:-}" == dumb && -z "${CLAUDE_ASK_FORCE_TTY:-}" ]]; then
  COLOR_DEPTH=none
elif [[ -z "$COLOR_DEPTH" ]]; then
  case "${COLORTERM:-}:${TERM:-}" in
    truecolor:* | 24bit:*) COLOR_DEPTH=truecolor ;;
    *:dumb) COLOR_DEPTH=none ;;
    *:*256*) COLOR_DEPTH=256 ;;
    *) COLOR_DEPTH=16 ;;
  esac
fi

# recolor ESCAPE: a palette color ("\e[38;2;R;G;Bm") at COLOR_DEPTH, in OUT_COLOR
recolor() {
  local esc="$1" kind r g b rest index
  rest="${esc#$'\e['}"
  kind="${rest%%;*}" # 38 foreground, 48 background
  rest="${rest#*;2;}"
  r="${rest%%;*}"
  rest="${rest#*;}"
  g="${rest%%;*}"
  b="${rest#*;}"
  b="${b%m}"
  if [[ "$COLOR_DEPTH" == 256 ]]; then
    if ((r / 11 == g / 11 && g / 11 == b / 11)); then
      # A grey: the finer grey ramp
      index=$((232 + (r + g + b) * 23 / 765))
    else
      index=$((16 + 36 * ((r * 5 + 127) / 255) + 6 * ((g * 5 + 127) / 255) + (b * 5 + 127) / 255))
    fi
    OUT_COLOR=$'\e['"$kind;5;${index}m"
  else
    # 16 colors: which channels are strong, and bright if any is very strong
    index=$(((b > 127) * 4 + (g > 127) * 2 + (r > 127)))
    local base=$((kind == 38 ? 30 : 40))
    if ((r > 199 || g > 199 || b > 199 || (index == 0 && kind == 38))); then base=$((base + 60)); fi
    OUT_COLOR=$'\e['"$((base + index))m"
  fi
}

case "$COLOR_DEPTH" in
  truecolor) ;;
  256 | 16)
    for _color in "${!FG_@}" "${!BG_@}"; do
      recolor "${!_color}"
      printf -v "$_color" '%s' "$OUT_COLOR"
    done
    unset _color OUT_COLOR
    ;;
  none)
    # no-color.org: every color variable empty; the layout stays
    for _color in RST BOLD "${!FG_@}" "${!BG_@}"; do
      printf -v "$_color" '%s' ""
    done
    unset _color
    ;;
  *)
    echo "Error: CLAUDE_ASK_COLORS must be one of: truecolor, 256, 16, none" >&2
    exit 1
    ;;
esac

# Where the status bar and notes go. stdout, when it is a terminal; otherwise
# stdout gets only the answer (no bar, cursor moves or colors in a file or a
# pipe) and they go to stderr if that is a terminal, else nowhere. The default
# pager is for terminals too: a --pager given on the command line still runs.
OUT_TTY=0
if [[ -t 1 || -n "${CLAUDE_ASK_FORCE_TTY:-}" ]]; then OUT_TTY=1; fi
if ((OUT_TTY)); then
  exec {BAR_FD}>&1
elif [[ -t 2 ]]; then
  exec {BAR_FD}>&2
else
  exec {BAR_FD}> /dev/null
fi
if ((!OUT_TTY)) && [[ "$PAGER_IS_DEFAULT" -eq 1 ]]; then USE_PAGER=0; fi

# A dumb terminal shows cursor moves as garbage: no redrawing there, just the
# final bar. The tests' stand-in for a terminal draws whatever TERM says.
CLEAR_BELOW=$'\e[J'
CURSOR_MOVES=1
if [[ "${TERM:-dumb}" == dumb && -z "${CLAUDE_ASK_FORCE_TTY:-}" ]]; then
  CLEAR_BELOW=""
  CURSOR_MOVES=0
fi

# Spinner frames
SPINNER=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")

# ---------------------------------------------------------------------------
# Renderers and format helpers
#
# Each one writes its result into the variable named by its first argument,
# like printf -v, instead of printing it: the status bar is redrawn on every
# stream event, and calling these in $(...) cost a subshell (and often a bc)
# per value. The output variable must not share a name with the function's
# own locals, which would shadow it, so every local here starts with "_" and
# output variable names must not.
# ---------------------------------------------------------------------------

# Theme renderers: OUT spinner_char model tokens_in tokens_out cost duration status
render_minimal() {
  local _out="$1" _spin="$2" _model="$3" _tok_in="$4" _tok_out="$5" _cost="$6" _dur="$7" _status="$8"
  local _line=""
  _line+="${FG_CLAUDE}${_spin}${RST} "
  _line+="${FG_MODEL}${_model}${RST}"
  if [[ -n "$_tok_in" ]]; then
    _line+=" ${FG_DIM}|${RST} ${FG_TOKENS}in:${_tok_in}${RST}"
  fi
  if [[ -n "$_tok_out" ]]; then
    _line+=" ${FG_TOKENS}out:${_tok_out}${RST}"
  fi
  if [[ -n "$_cost" ]]; then
    _line+=" ${FG_DIM}|${RST} ${FG_COST}${_cost}${RST}"
  fi
  if [[ -n "$_dur" ]]; then
    _line+=" ${FG_DIM}|${RST} ${FG_DURATION}${_dur}${RST}"
  fi
  if [[ "$_status" == "done" ]]; then
    _line+=" ${FG_DIM}|${RST} ${FG_COST}done${RST}"
  fi
  printf -v "$_out" '%s' "$_line"
}

render_bubbles() {
  local _out="$1" _spin="$2" _model="$3" _tok_in="$4" _tok_out="$5" _cost="$6" _dur="$7" _status="$8"
  local _line=""

  # Claude bubble (spinner + model)
  _line+="${FG_CLAUDE}${SEP_BUBBLE_LEFT}${BG_CLAUDE} ${FG_CLAUDE}${_spin} ${FG_MODEL}${_model} ${RST}${FG_CLAUDE}${SEP_BUBBLE_RIGHT}${RST}"

  # Tokens bubble
  if [[ -n "$_tok_in" || -n "$_tok_out" ]]; then
    local _tok_str=""
    [[ -n "$_tok_in" ]] && _tok_str+="in:${_tok_in}"
    [[ -n "$_tok_out" ]] && _tok_str+=" out:${_tok_out}"
    _line+=" ${FG_TOKENS}${SEP_BUBBLE_LEFT}${BG_TOKENS} ${FG_TOKENS}${_tok_str} ${RST}${FG_TOKENS}${SEP_BUBBLE_RIGHT}${RST}"
  fi

  # Cost bubble
  if [[ -n "$_cost" ]]; then
    _line+=" ${FG_COST}${SEP_BUBBLE_LEFT}${BG_COST} ${FG_COST}${_cost} ${RST}${FG_COST}${SEP_BUBBLE_RIGHT}${RST}"
  fi

  # Duration bubble
  if [[ -n "$_dur" ]]; then
    _line+=" ${FG_DURATION}${SEP_BUBBLE_LEFT}${BG_DURATION} ${FG_DURATION}${_dur} ${RST}${FG_DURATION}${SEP_BUBBLE_RIGHT}${RST}"
  fi

  # Status indicator
  if [[ "$_status" == "done" ]]; then
    _line+=" ${FG_COST}${SEP_BUBBLE_LEFT}${BG_COST} ${FG_COST}done ${RST}${FG_COST}${SEP_BUBBLE_RIGHT}${RST}"
  fi

  printf -v "$_out" '%s' "$_line"
}

render_powerline() {
  local _out="$1" _spin="$2" _model="$3" _tok_in="$4" _tok_out="$5" _cost="$6" _dur="$7" _status="$8"
  local _line=""
  # Each separator arrow takes the color of the segment before it
  local _prev_fg="${FG_CLAUDE}"

  # Decorative start + claude segment
  _line+="${FG_CLAUDE}░▒▓${BG_CLAUDE} ${FG_CLAUDE}${_spin} ${FG_MODEL}${_model} ${RST}"

  # Tokens segment
  if [[ -n "$_tok_in" || -n "$_tok_out" ]]; then
    local _tok_str=""
    [[ -n "$_tok_in" ]] && _tok_str+="in:${_tok_in}"
    [[ -n "$_tok_out" ]] && _tok_str+=" out:${_tok_out}"
    _line+="${BG_TOKENS}${_prev_fg}${SEP_POWERLINE}${RST}${BG_TOKENS} ${FG_TOKENS}${_tok_str} ${RST}"
    _prev_fg="${FG_TOKENS}"
  fi

  # Cost segment
  if [[ -n "$_cost" ]]; then
    _line+="${BG_COST}${_prev_fg}${SEP_POWERLINE}${RST}${BG_COST} ${FG_COST}${_cost} ${RST}"
    _prev_fg="${FG_COST}"
  fi

  # Duration segment
  if [[ -n "$_dur" ]]; then
    _line+="${BG_DURATION}${_prev_fg}${SEP_POWERLINE}${RST}${BG_DURATION} ${FG_DURATION}${_dur} ${RST}"
    _prev_fg="${FG_DURATION}"
  fi

  # Status / end cap
  if [[ "$_status" == "done" ]]; then
    _line+="${BG_COST}${_prev_fg}${SEP_POWERLINE}${RST}${BG_COST} ${FG_COST}done ${RST}${FG_COST}${SEP_POWERLINE}${RST}"
  else
    _line+="${_prev_fg}${SEP_POWERLINE}${RST}"
  fi

  printf -v "$_out" '%s' "$_line"
}

# OUT MODEL EFFORT: the model segment's text, "opus 5.5 · high" (just the
# model when EFFORT is empty). Only foreground colors, so it sits inside any
# theme's segment background.
model_label() {
  local _out="$1" _label="$2"
  if [[ -n "${3:-}" ]]; then
    _label+=" ${FG_DIM}·${FG_EFFORT} $3"
  fi
  printf -v "$_out" '%s' "$_label"
}

render_status_bar() {
  case "$THEME" in
    minimal) render_minimal "$@" ;;
    bubbles) render_bubbles "$@" ;;
    powerline) render_powerline "$@" ;;
  esac
}

# OUT TEXT: the number of columns TEXT takes, without its "\e[...m" color
# codes (characters are counted as one column each)
visible_width() {
  local _out="$1" _s="$2" _pre _rest
  while [[ "$_s" == *$'\e['* ]]; do
    _pre="${_s%%$'\e['*}"
    _rest="${_s#*$'\e['}"
    _rest="${_rest#*m}"
    _s="$_pre$_rest"
  done
  printf -v "$_out" '%d' "${#_s}"
}

# OUT TEXT: the terminal rows TEXT takes once it wraps at TERM_COLS
text_rows() {
  local _out="$1" _w
  visible_width _w "$2"
  if ((TERM_COLS > 0 && _w > TERM_COLS)); then
    printf -v "$_out" '%d' "$(((_w + TERM_COLS - 1) / TERM_COLS))"
  else
    printf -v "$_out" '%d' 1
  fi
}

# Same arguments as render_status_bar, but the bar is fitted to TERM_COLS by
# leaving out segments from the right: "done", then the duration, the cost
# and the tokens. The spinner and model segment always stay (and may still
# wrap in a very narrow terminal).
render_status_bar_fitted() {
  local _out="$1" _spin="$2" _model="$3" _tok_in="$4" _tok_out="$5" _cost="$6" _dur="$7" _status="$8"
  local _bar _w _step
  for _step in 0 1 2 3 4; do
    case "$_step" in
      1) if [[ "$_status" == "done" ]]; then _status="ended"; else continue; fi ;;
      2) if [[ -n "$_dur" ]]; then _dur=""; else continue; fi ;;
      3) if [[ -n "$_cost" ]]; then _cost=""; else continue; fi ;;
      4) if [[ -n "$_tok_in$_tok_out" ]]; then _tok_in="" _tok_out=""; else continue; fi ;;
    esac
    render_status_bar _bar "$_spin" "$_model" "$_tok_in" "$_tok_out" "$_cost" "$_dur" "$_status"
    ((TERM_COLS > 0)) || break
    visible_width _w "$_bar"
    ((_w > TERM_COLS)) || break
  done
  printf -v "$_out" '%s' "$_bar"
}

# Set TERM_COLS: CLAUDE_ASK_COLUMNS, else the terminal's width, else COLUMNS
read_term_cols() {
  local size
  if [[ -n "${CLAUDE_ASK_COLUMNS:-}" ]]; then
    TERM_COLS="$CLAUDE_ASK_COLUMNS"
  elif size=$(stty size 2> /dev/null < /dev/tty); then
    TERM_COLS="${size#* }"
  else
    TERM_COLS="${COLUMNS:-0}"
  fi
  [[ "$TERM_COLS" =~ ^[0-9]+$ ]] || TERM_COLS=0
}

# OUT N DIV: N / DIV with one decimal, truncated ("19.9" for 19900 / 1000),
# in integer arithmetic; this is what bc with scale=1 used to produce
_one_decimal() {
  printf -v "$1" '%d.%d' "$(($2 / $3))" "$((($2 % $3) * 10 / $3))"
}

# OUT N: 950, 19.9k, 2.5M
_format_magnitude() {
  local _out="$1" _n="$2"
  if ((_n >= 1000000)); then
    _one_decimal "$_out" "$_n" 1000000
    printf -v "$_out" '%sM' "${!_out}"
  elif ((_n >= 1000)); then
    _one_decimal "$_out" "$_n" 1000
    printf -v "$_out" '%sk' "${!_out}"
  else
    printf -v "$_out" '%d' "$_n"
  fi
}

# OUT N: a token count; empty for none or zero
format_tokens() {
  if [[ -z "$2" || "$2" == "0" ]]; then
    printf -v "$1" '%s' ""
  else
    _format_magnitude "$1" "$2"
  fi
}

# OUT N: a character count; 0 for none
format_count() {
  _format_magnitude "$1" "${2:-0}"
}

# OUT MS: 500ms, 7.4s, 1m30s; empty for none
format_duration() {
  local _out="$1" _ms="$2"
  if [[ -z "$_ms" ]]; then
    printf -v "$_out" '%s' ""
  elif ((_ms >= 60000)); then
    printf -v "$_out" '%dm%ds' "$((_ms / 60000))" "$(((_ms % 60000) / 1000))"
  elif ((_ms >= 1000)); then
    _one_decimal "$_out" "$_ms" 1000
    printf -v "$_out" '%ss' "${!_out}"
  else
    printf -v "$_out" '%dms' "$_ms"
  fi
}

# OUT USD: $0.0950; empty for none
format_cost() {
  if [[ -z "$2" ]]; then
    printf -v "$1" '%s' ""
  else
    printf -v "$1" '$%.4f' "$2"
  fi
}

# OUT SECONDS: 42s, 3m5s, 1h2m; 0s for none or negative
format_elapsed() {
  local _out="$1" _secs="$2"
  if [[ -z "$_secs" ]] || ((_secs <= 0)); then
    printf -v "$_out" '0s'
  elif ((_secs >= 3600)); then
    printf -v "$_out" '%dh%dm' "$((_secs / 3600))" "$(((_secs % 3600) / 60))"
  elif ((_secs >= 60)); then
    printf -v "$_out" '%dm%ds' "$((_secs / 60))" "$((_secs % 60))"
  else
    printf -v "$_out" '%ds' "$_secs"
  fi
}

# OUT tool agents: the row under the info line while streaming, naming the
# running tool and the background agents; empty when neither runs. It is cut
# to one row of TERM_COLS (or 120 columns when that is unknown).
render_stream_activity() {
  local _out="$1" _act="${2:-}" _room=120
  # The Agent call that starts a background agent already names it
  if [[ -n "${3:-}" && "$_act" != "Agent: $3" ]]; then _act+="${_act:+ | }agent: $3"; fi
  if [[ -z "$_act" ]]; then
    printf -v "$_out" '%s' ""
    return 0
  fi
  if ((TERM_COLS > 0)); then _room=$((TERM_COLS - 2)); fi
  if ((_room < 12)); then _room=12; fi
  if ((${#_act} > _room)); then _act="${_act:0:_room-1}…"; fi
  printf -v "$_out" '  %s%s%s' "$FG_DIM" "$_act" "$RST"
}

# OUT lines chars chunks elapsed status is_thinking [extra]: the line under
# the bar; extra (e.g. "turn 3 | $0.0412 total") is appended
render_stream_info() {
  local _out="$1" _lines="$2" _chars="$3" _chunks="$4" _elapsed="$5" _is_done="$6" _is_thinking="${7:-0}" _extra="${8:-}"
  local _info="  ${FG_DIM}" _count_str _elapsed_str
  if [[ "$_is_thinking" -eq 1 && "$_is_done" != "done" ]]; then
    _info+="thinking... ${FG_DIM}|${RST}${FG_DIM} "
  fi
  format_count _count_str "$_chars"
  _info+="${_lines} lines ${FG_DIM}|${RST}${FG_DIM} "
  _info+="${_count_str} chars ${FG_DIM}|${RST}${FG_DIM} "
  _info+="${_chunks} chunks"
  if [[ "$_is_done" != "done" && -n "$_elapsed" ]]; then
    format_elapsed _elapsed_str "$_elapsed"
    _info+=" ${FG_DIM}|${RST}${FG_DIM} ${_elapsed_str}"
  fi
  if [[ -n "$_extra" ]]; then
    _info+=" ${FG_DIM}|${RST}${FG_DIM} ${_extra}"
  fi
  _info+="${RST}"
  printf -v "$_out" '%s' "$_info"
}

# ---------------------------------------------------------------------------
# Stream parsing, shared by the main loop, --demo-output and the tests
# ---------------------------------------------------------------------------

# Shorten a model id to family and version: "claude-opus-4-6[1m]" is
# "opus 4.6", "claude-3-5-sonnet-20241022" is "sonnet 3.5" and
# "claude-opus-4-20250514" is "opus 4". Other ids naming a known family are
# shortened to the family; anything else is kept, without a "[...]" suffix.
short_model_name() {
  local m="${1%%\[*}" id
  id="${m,,}"
  if [[ "$id" == *claude-* ]]; then id="claude-${id#*claude-}"; fi
  if [[ "$id" =~ ^claude-([a-z]+)-([0-9]+)(-([0-9]{1,2}))?(-[0-9]{8})?$ ]]; then
    printf '%s %s%s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[4]:+.${BASH_REMATCH[4]}}"
    return
  fi
  if [[ "$id" =~ ^claude-([0-9]+)(-([0-9]{1,2}))?-([a-z]+)(-[0-9]{8})?$ ]]; then
    printf '%s %s%s' "${BASH_REMATCH[4]}" "${BASH_REMATCH[1]}" "${BASH_REMATCH[3]:+.${BASH_REMATCH[3]}}"
    return
  fi
  case "$id" in
    *haiku*) m="haiku" ;;
    *sonnet*) m="sonnet" ;;
    *opus*) m="opus" ;;
  esac
  printf '%s' "$m"
}

# Reset every variable process_stream_line writes
reset_stream_state() {
  model=""
  session_id=""
  spinner_idx=0
  input_tokens=""
  output_tokens=""
  cost=""
  duration_ms=""
  answer_text=""
  answer_message_id="" # the message answer_text last grew from
  stream_message_id="" # the message stream_event deltas belong to
  stream_text_unconfirmed=0 # deltas seen; their assistant event is a repeat
  REDRAW_MAY_WAIT=0
  BLOCK_ENDED=0
  LINE_COLS=0 # columns of answer text on the cursor's line, roughly
  RENDER_PENDING="" # with a pager: text not yet a whole line
  RENDER_BLOCK=""   # lines of the block being gathered
  RENDER_FENCE=""   # the fence of the code block it is in
  RENDER_IN_LIST=0  # it has a list item, so a blank line may not end it
  RENDER_BLANK=0    # a blank line in a list, waiting on the next line
  RENDER_READY=""   # finished blocks, waiting to go through the pager
  RENDER_NEXT=0     # when they can
  RENDER_SHOWN=0    # something has been shown
  result_text="" # the result event's text: the last message, or the error
  status="running" # running, done or error
  stream_error=""
  api_error="" # an assistant event's error code, e.g. model_not_found
  is_thinking=0
  current_tool="" # the tool running now, for the info line
  background_tasks="" # the agents running in the background, for the info line
  result_seen=0
  result_duration=0
  result_input=0
  result_output=0
  denied_tools="" # the tools the result says were denied
  answer_lines=0
  answer_chars=0
  text_chunks=0
  CHUNK=""
}

# Control characters but tab and newline, as a jq regex: what must not reach
# the terminal from an answer or a question (an escape sequence could set the
# clipboard or the title, and an answer may quote what a tool fetched). The
# NUL among them also keeps a record at STREAM_FIELD_COUNT fields.
CONTROL_CHARS_RE='[\u0000-\u0008\u000b-\u001f\u007f-\u009f]'

# The fields of one event, each NUL-terminated, with control characters taken
# out: type, model,
# session_id, text (every text block joined), has_thinking, input tokens,
# output tokens, cost, duration_ms, is_error, result text, error (an
# assistant event's error code), message id (one message can span events),
# the tool the event starts ("Bash: git status"), the tools a result says were
# denied; for a stream_event (--include-partial-messages) what it is
# ("content_block_delta:text_delta") and its value (the text, a tool's name or
# a message's id); the tool call of the subagent it comes from, if any; for a
# background_tasks_changed event "tasks:" and what is running.
# shellcheck disable=SC2016 # $u is a jq variable
STREAM_FIELDS_JQ='
  # A result with modelUsage: that has the whole run, with any subagent. Its usage
  # is only that part of the run
  ((.modelUsage // {}) | [.[]]) as $models
  | (if .type != "result" then .message.usage
     elif ($models | length) > 0 then
       {input_tokens: ($models | map(.inputTokens // 0) | add),
        output_tokens: ($models | map(.outputTokens // 0) | add)}
     else .usage end) as $u
  | [ .type, .model, .session_id,
      ([.message.content[]? | select(.type == "text") | .text] | join("")),
      (if any(.message.content[]?; .type == "thinking") then 1 else 0 end),
      $u.input_tokens, $u.output_tokens, .total_cost_usd, .duration_ms,
      (if .is_error == true then 1 else 0 end),
      (if .type == "result" then .result else null end),
      (if .type == "assistant" then .error else null end),
      .message.id,
      ([.message.content[]? | select(.type == "tool_use")] | last
       | if . == null then null
         else .name + (.input
           | (.command // .file_path // .path // .pattern // .url // .query // .description // "")
           | tostring | (split("\n")[0] // "") | if . == "" then "" else ": " + . end)
         end),
      ([.permission_denials[]?.tool_name] | unique | join(", ")),
      (if .type == "stream_event"
       then (.event.type // "") + ":" + (.event.delta.type // .event.content_block.type // "")
       else null end),
      (if .type == "stream_event"
       then (.event.delta.text // .event.content_block.name // .event.message.id)
       else null end),
      .parent_tool_use_id,
      (if .subtype == "background_tasks_changed"
       then "tasks:" + ([.tasks[]? | .description // "agent"] | join(", "))
       else null end),
      (if ($models | length) > 0 then 1 else null end) ]
  | map((. // "" | tostring | gsub("'"$CONTROL_CHARS_RE"'"; "")) + "\u0000") | add'
STREAM_FIELD_COUNT=20

# The parser is one jq that lives for the whole run, a coprocess fed one
# line at a time, instead of a jq started for every event. It reads raw
# lines (-R) and answers each with exactly one record: an empty one (every
# field "") for a line that is not a JSON object or that the program cannot
# handle, so the two sides never get out of step and jq never stops on bad
# input. --unbuffered sends each record at once.
# shellcheck disable=SC2016 # jq program
STREAM_COPROC_JQ='
  def record: '"$STREAM_FIELDS_JQ"';
  (try (fromjson | if type == "object" then record else error("not an object") end)
   catch null)
  // ([range('"$STREAM_FIELD_COUNT"')] | map("\u0000") | add)'
STREAM_JQ_PID=""

# Start the parser's jq. It closes every file descriptor it inherited past
# stderr first, so it never holds claude's output or a pipe of the caller's
# open after claude-ask closes it. SIGINT is ignored in it, so a Ctrl-C that stops
# an answer in a chat does not stop the parser too.
start_stream_jq() {
  # shellcheck disable=SC2034 # STREAM_JQ is the coprocess's fd array
  coproc STREAM_JQ {
    local _fd
    for _fd in /dev/fd/*; do
      _fd="${_fd##*/}"
      if ((_fd > 2)); then eval "exec ${_fd}>&-"; fi
    done 2> /dev/null
    trap '' INT
    exec jq -R -j --unbuffered "$STREAM_COPROC_JQ" 2> /dev/null
  }
  # coproc sets STREAM_JQ_PID (bash may unset it again once jq is gone)
  debug_log "stream parser started: pid=${STREAM_JQ_PID:-}"
}

# Stop the parser's jq (at exit; the next process_stream_line would start
# another)
stop_stream_jq() {
  if [[ -n "${STREAM_JQ_PID:-}" ]]; then
    kill "$STREAM_JQ_PID" 2> /dev/null || true
    STREAM_JQ_PID=""
  fi
}

# stream_fields LINE: set the array STREAM_F to LINE's fields, from the
# parser (started when it is not running)
stream_fields() {
  local i
  STREAM_F=()
  if [[ -z "${STREAM_JQ_PID:-}" ]] || ! kill -0 "$STREAM_JQ_PID" 2> /dev/null || [[ -z "${STREAM_JQ[1]:-}" ]]; then
    start_stream_jq
  fi
  # A raw newline can only be whitespace between JSON tokens (one inside a
  # string is invalid JSON anyway), and jq -R would read it as two lines
  printf '%s\n' "${1//$'\n'/ }" >&"${STREAM_JQ[1]}"
  for ((i = 0; i < STREAM_FIELD_COUNT; i++)); do
    STREAM_F[i]=""
    IFS= read -r -d '' "STREAM_F[i]" <&"${STREAM_JQ[0]}" || return 1
  done
}

# add_denied_tools "A, B": add to denied_tools, each tool once; a run can have
# several results, and each lists only its own
add_denied_tools() {
  local tool rest="$1"
  while [[ -n "$rest" ]]; do
    tool="${rest%%, *}"
    if [[ "$rest" == *", "* ]]; then rest="${rest#*, }"; else rest=""; fi
    if [[ ", $denied_tools, " != *", $tool, "* ]]; then
      denied_tools+="${denied_tools:+, }$tool"
    fi
  done
}

# add_answer_text TEXT MESSAGE_ID: add to the answer; CHUNK is what to show, with
# a blank line first when this is a new message (a tool call came between). The
# events of one message share its id.
add_answer_text() {
  CHUNK="$1"
  is_thinking=0
  current_tool=""
  if [[ -n "$answer_text" && -n "$2" && "$2" != "$answer_message_id" ]]; then
    CHUNK=$'\n\n'"$CHUNK"
  fi
  if [[ -n "$2" ]]; then answer_message_id="$2"; fi
  answer_text+="$CHUNK"
  text_chunks=$((text_chunks + 1))
  answer_chars=$((answer_chars + ${#CHUNK}))
  local newlines="${CHUNK//[!$'\n']/}"
  answer_lines=$((answer_lines + ${#newlines}))
}

# Parse one stream-json line into the state variables. CHUNK is set to the
# answer text the line added (empty if none); REDRAW_MAY_WAIT says this event
# need not redraw the bar at once, and BLOCK_ENDED that a block of text ended.
# Returns 1 for lines that change nothing on screen: blank, not JSON, no type,
# or a rate_limit_event.
#
# With --include-partial-messages text comes as stream_event deltas, and each
# finished block comes again, whole, in an assistant event: that repeat is
# skipped (stream_text_unconfirmed). A stream with no deltas still works.
process_stream_line() {
  local line="$1" f=()
  CHUNK=""
  REDRAW_MAY_WAIT=0
  BLOCK_ENDED=0
  [[ -n "$line" ]] || return 1
  stream_fields "$line" || return 1
  f=("${STREAM_F[@]}")
  [[ ${#f[@]} -eq $STREAM_FIELD_COUNT && -n "${f[0]}" ]] || return 1

  case "${f[0]}" in
    system)
      if [[ -n "${f[1]}" ]]; then model=$(short_model_name "${f[1]}"); fi
      # A run can go on after a result: with a background agent there is a
      # result, a new init and more answer, up to a last result
      if [[ -n "${f[1]}" && "$status" == "done" ]]; then status="running"; fi
      # The agents running in the background: until they finish more is coming
      if [[ "${f[18]}" == tasks:* ]]; then
        background_tasks="${f[18]#tasks:}"
        if [[ -n "$background_tasks" && "$status" == "done" ]]; then status="running"; fi
      fi
      if [[ -n "${f[2]}" ]]; then session_id="${f[2]}"; fi
      ;;
    assistant)
      if [[ -n "${f[11]}" ]]; then
        # An API error (unknown model, auth, ...): its text is the error
        # message, not part of the answer
        api_error="${f[11]}"
        stream_error="${f[3]:-$api_error}"
      elif [[ -n "${f[17]}" ]]; then
        # A subagent's own text is not the answer; what it reports back is
        :
      elif [[ -n "${f[3]}" ]]; then
        if ((stream_text_unconfirmed)); then
          stream_text_unconfirmed=0
        else
          add_answer_text "${f[3]}" "${f[12]}"
        fi
      fi
      if [[ -z "${f[3]}" && "${f[4]}" == 1 ]]; then is_thinking=1; fi
      if [[ -n "${f[13]}" ]]; then
        is_thinking=0
        current_tool="${f[13]}"
      fi
      ;;
    stream_event)
      REDRAW_MAY_WAIT=1
      case "${f[15]}" in
        message_start:*) stream_message_id="${f[16]}" ;;
        content_block_start:thinking) is_thinking=1 ;;
        content_block_start:tool_use)
          is_thinking=0
          current_tool="${f[16]}"
          ;;
        content_block_delta:text_delta)
          if [[ -z "${f[17]}" ]]; then
            add_answer_text "${f[16]}" "$stream_message_id"
            stream_text_unconfirmed=1
          fi
          ;;
        content_block_stop:* | message_stop:*) BLOCK_ENDED=1 ;;
      esac
      ;;
    user)
      # A tool's result: it has finished
      current_tool=""
      ;;
    result)
      # With an agent still running this is not the end (see system)
      if [[ -z "$background_tasks" ]]; then status="done"; fi
      result_seen=1
      current_tool=""
      add_denied_tools "${f[14]}"
      result_text="${f[10]}"
      # A run can have several results. The cost is the whole run's in each, the
      # duration only that part's, and the tokens the whole run's with modelUsage
      if [[ -n "${f[7]}" ]]; then cost="${f[7]}"; fi
      if [[ -n "${f[8]}" ]]; then
        result_duration=$((result_duration + ${f[8]%.*}))
        duration_ms="$result_duration"
      fi
      if [[ -n "${f[19]}" ]]; then
        result_input="${f[5]}"
        result_output="${f[6]}"
      else
        result_input=$((result_input + ${f[5]:-0}))
        result_output=$((result_output + ${f[6]:-0}))
      fi
      if [[ "${f[9]}" == 1 ]]; then
        result_seen=1
        status="error"
        stream_error="${f[10]:-claude reported an error}"
      fi
      ;;
    rate_limit_event)
      return 1
      ;;
  esac

  # Token counts: of its message for an assistant event, of the run so far for a
  # result
  if [[ "${f[0]}" == assistant ]]; then
    if [[ -n "${f[5]}" ]]; then input_tokens="${f[5]}"; fi
    if [[ -n "${f[6]}" ]]; then output_tokens="${f[6]}"; fi
  elif [[ "${f[0]}" == result && ( -n "${f[5]}" || -n "${f[6]}" ) ]]; then
    input_tokens="$result_input"
    output_tokens="$result_output"
  fi
  return 0
}

# Run the pager on stdin; bash -c so quotes inside PAGER_CMD are honored.
# While streaming, the pager writes to a pipe, so it cannot ask the terminal
# for its width: pass COLUMNS explicitly (bash may hold it as an unexported
# shell variable; otherwise ask the terminal).
run_pager() {
  local cols="${COLUMNS:-}" size
  if [[ -z "$cols" ]] && size=$(stty size 2> /dev/null < /dev/tty); then
    cols="${size#* }"
  fi
  if [[ -n "$cols" ]]; then
    COLUMNS="$cols" bash -c "$PAGER_CMD"
  else
    bash -c "$PAGER_CMD"
  fi
}

# ---------------------------------------------------------------------------
# Yanking: copy an answer, or its code blocks, to the clipboard
# ---------------------------------------------------------------------------
FENCE_OPEN_RE='^ {0,3}(```+|~~~+)'
FENCE_CLOSE_RE='^ {0,3}(```+|~~~+)[[:space:]]*$'

# Set CODE_BLOCKS to TEXT's fenced code blocks (``` or ~~~, indented up to
# three spaces), without the fence lines. A block closes at a fence of the
# same character at least as long; one still open at the end runs to it.
extract_code_blocks() {
  local line fence="" block="" open=0
  local re_open="$FENCE_OPEN_RE" re_close="$FENCE_CLOSE_RE"
  CODE_BLOCKS=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    if ((open)); then
      if [[ "$line" =~ $re_close && "${BASH_REMATCH[1]:0:1}" == "${fence:0:1}" && ${#BASH_REMATCH[1]} -ge ${#fence} ]]; then
        CODE_BLOCKS+=("$block")
        open=0
      else
        block+="$line"$'\n'
      fi
    elif [[ "$line" =~ $re_open ]]; then
      fence="${BASH_REMATCH[1]}"
      block=""
      open=1
    fi
  done <<< "$1"
  if ((open)); then CODE_BLOCKS+=("$block"); fi
}

# Set CLIP_CMD to the command that copies stdin to the clipboard:
# CLAUDE_ASK_CLIPBOARD, else wl-copy (Wayland), xclip or xsel (X11), pbcopy,
# clip.exe (WSL).
# Returns 1 when there is none.
clipboard_cmd() {
  CLIP_CMD="${CLAUDE_ASK_CLIPBOARD:-}"
  if [[ -z "$CLIP_CMD" ]]; then
    if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy > /dev/null 2>&1; then
      CLIP_CMD="wl-copy"
    elif [[ -n "${DISPLAY:-}" ]] && command -v xclip > /dev/null 2>&1; then
      CLIP_CMD="xclip -selection clipboard"
    elif [[ -n "${DISPLAY:-}" ]] && command -v xsel > /dev/null 2>&1; then
      CLIP_CMD="xsel --clipboard --input"
    elif command -v pbcopy > /dev/null 2>&1; then
      CLIP_CMD="pbcopy"
    elif command -v clip.exe > /dev/null 2>&1; then
      CLIP_CMD="clip.exe" # WSL
    fi
  fi
  [[ -n "$CLIP_CMD" ]]
}

# osc52_copy TEXT: ask the terminal to set the clipboard (OSC 52), which reaches
# the local one over ssh. Terminals limit its size, about 100000 characters at
# the least, and do not answer, so "worked" only means it was sent. tmux does not
# pass it on from a pane by default, which is why load-buffer -w is used there.
osc52_copy() {
  local encoded
  [[ "${TERM:-}" != dumb ]] || return 1
  { : > /dev/tty; } 2> /dev/null || return 1
  encoded=$(printf '%s' "$1" | base64 | tr -d '\n') || return 1
  if ((${#encoded} > 100000)); then
    echo "claude-ask: too long for the terminal's clipboard (OSC 52)" >&2
    return 1
  fi
  printf '\e]52;c;%s\a' "$encoded" > /dev/tty
}

# yank_text TEXT WHAT: copy TEXT to the clipboard and, inside tmux, a tmux
# buffer, or failing both ask the terminal, and say so on stderr ("yanked WHAT
# (N lines) to ...")
yank_text() {
  local text="$1" what="$2" to=() newlines
  # The clipboard tool's output goes nowhere: xclip and wl-copy stay behind
  # to serve the selection and would hold a pipe open
  if clipboard_cmd && printf '%s' "$text" | bash -c "$CLIP_CMD" > /dev/null 2>&1; then
    to+=("the clipboard")
  fi
  # -w: tmux also sends it to the outer terminal's clipboard (from tmux 3.2)
  if [[ -n "${TMUX:-}" ]]; then
    if printf '%s' "$text" | tmux load-buffer -w - > /dev/null 2>&1 \
      || printf '%s' "$text" | tmux load-buffer - > /dev/null 2>&1; then
      to+=("a tmux buffer")
    fi
  fi
  if ((${#to[@]} == 0)) && osc52_copy "$text"; then
    to+=("the terminal's clipboard")
  fi
  if ((${#to[@]} == 0)); then
    echo "claude-ask: nowhere to yank to: no clipboard command worked (set CLAUDE_ASK_CLIPBOARD), not in tmux, and no terminal" >&2
    return 1
  fi
  newlines="${text//[!$'\n']/}"
  printf '%syanked %s (%d lines) to %s%s\n' "$FG_DIM" "$what" "$((${#newlines} + 1))" \
    "${to[0]}${to[1]:+ and ${to[1]}}" "$RST" >&2
}

# yank_answer ANSWER answer|code [N]: copy the answer, all its code blocks
# (a blank line between them) or only the Nth. The last newline is left
# off, so a pasted command does not run before it can be read.
yank_answer() {
  local answer="$1" mode="$2" n="${3:-}" text="" what block count
  if [[ -z "$answer" ]]; then
    echo "claude-ask: there is no answer to yank" >&2
    return 1
  fi
  if [[ "$mode" == code ]]; then
    extract_code_blocks "$answer"
    count=${#CODE_BLOCKS[@]}
    if ((count == 0)); then
      echo "claude-ask: the answer has no code blocks" >&2
      return 1
    fi
    if [[ -n "$n" ]]; then
      if ((n < 1 || n > count)); then
        echo "claude-ask: there is no code block $n (the answer has $count)" >&2
        return 1
      fi
      text="${CODE_BLOCKS[n - 1]}"
      what="code block $n of $count"
    else
      for block in "${CODE_BLOCKS[@]}"; do
        text+="${text:+$'\n'}$block"
      done
      what="$count code block"
      if ((count != 1)); then what+="s"; fi
    fi
  else
    text="$answer"
    what="the answer"
  fi
  while [[ "$text" == *$'\n' ]]; do text="${text%$'\n'}"; done
  yank_text "$text" "$what"
}

# session_file_ok FILE: whether FILE is one JSON object; if not, says so
session_file_ok() {
  if ! jq -se 'length == 1 and (.[0] | type == "object")' "$1" > /dev/null 2>&1; then
    echo "claude-ask: $(basename "$1" .json) is not a valid session file ($1)" >&2
    return 1
  fi
}

# yank_session_file FILE: yank_answer with the session's last answer and
# the -y/-Y choice
yank_session_file() {
  local answer
  session_file_ok "$1" || return 1
  answer=$(jq -r "${SESSION_TURNS_JQ}"'.answer // empty | clean' "$1")
  yank_answer "$answer" "$YANK" "$YANK_CODE_N"
}

# session_files [DIR]: SESSION_FILES is the session files, newest first, the
# order --history numbers them in
session_files() {
  mapfile -t SESSION_FILES < <(ls -t "${1:-$SESSION_DIR}"/*.json 2> /dev/null)
}

# The newest session file, or nothing when there is none
newest_session_file() {
  session_files
  printf '%s' "${SESSION_FILES[0]:-}"
}

# shell_command OUT WORD...: the words as one command line for any shell
shell_command() {
  local _out="$1" _word _line=""
  shift
  for _word in "$@"; do
    _line+="${_line:+ }'${_word//\'/\'\\\'\'}'"
  done
  printf -v "$_out" '%s' "$_line"
}

# split_direction WIDTH HEIGHT: "h" (side by side) when the pane is more than
# twice as wide as it is tall (a cell is about half as wide as it is tall)
# and each half keeps 80 columns, else "v" (one above the other)
split_direction() {
  if (($1 > 2 * $2 && $1 / 2 >= 80)); then printf h; else printf v; fi
}

# ---------------------------------------------------------------------------
# Tab completion at the chat prompt
# ---------------------------------------------------------------------------
CHAT_COMMANDS=(/help /effort /model /theme /yank /status /new /editor /exit /quit)

# chat_complete LINE POINT: what Tab does with the cursor at POINT in LINE.
# A /command name before the cursor, or the argument of /effort, /model,
# /theme or /yank, is completed: one match in full (and a space), several
# as far as they agree. COMPLETE_LINE and COMPLETE_POINT are the line and
# cursor after it; COMPLETE_LIST holds the matches when Tab cannot extend
# them, to show. Anywhere else, or when nothing matches, Tab inserts a tab,
# so one in a pasted line is kept.
chat_complete() {
  local line="$1" point="$2" before word="" c add
  local -a cands=() matches=()
  before="${line:0:point}"
  COMPLETE_LIST=()
  if [[ "$before" =~ ^/[a-z]*$ ]]; then
    word="$before"
    cands=("${CHAT_COMMANDS[@]}")
  elif [[ "$before" =~ ^(/[a-z]+)[[:space:]]+([a-z0-9.-]*)$ ]]; then
    word="${BASH_REMATCH[2]}"
    case "${BASH_REMATCH[1]}" in
      /effort) IFS=" " read -ra cands <<< "${EFFORT_LEVELS//,/} default" ;;
      /model) cands=("${MODEL_ALIASES[@]}" default) ;;
      /theme) cands=("${THEMES[@]}") ;;
      /yank) cands=(code) ;;
    esac
  fi
  for c in "${cands[@]}"; do
    if [[ "$c" == "$word"* ]]; then matches+=("$c"); fi
  done

  if ((${#matches[@]} == 0)); then
    add=$'\t'
  elif ((${#matches[@]} == 1)); then
    add="${matches[0]#"$word"}"
    if [[ "${line:point:1}" != [[:space:]] ]]; then add+=" "; fi
  else
    # The longest prefix all the matches share, past what is typed
    add="${matches[0]}"
    for c in "${matches[@]:1}"; do
      while [[ "$c" != "$add"* ]]; do add="${add%?}"; done
    done
    add="${add#"$word"}"
    if [[ -z "$add" ]]; then COMPLETE_LIST=("${matches[@]}"); fi
  fi
  COMPLETE_LINE="$before$add${line:point}"
  COMPLETE_POINT=$((point + ${#add}))
}

# ---------------------------------------------------------------------------
# Session saving
# ---------------------------------------------------------------------------
# A session file holds one conversation: "turns" lists every question and
# answer; the top level keeps the first question, the last answer and the
# totals (cost, durations, tokens) so older readers still find them. Files
# saved before turns existed are read as a single turn (SESSION_TURNS_JQ).
#
# shellcheck disable=SC2016 # jq programs
SESSION_TURNS_JQ='
  def clean: gsub("'"$CONTROL_CHARS_RE"'"; "");
  def turns_of:
    if .turns then .turns
    else [{question, answer, is_error: (.is_error // false), thinking,
           cost_usd, duration_ms, duration_api_ms, usage, timestamp}]
    end;'

# Build one turn from a raw stream (NUL-free, one JSON event per line) and add
# it to $prev (the existing session, or none). The init event, not the first
# system event, has model and cwd: hook events come before it.
# shellcheck disable=SC2016 # jq program
SESSION_JQ="${SESSION_TURNS_JQ}"'
  def total(f): [.[] | f | numbers] | if length > 0 then add else null end;
  # What this turn added to a running total. A total that went down is a new one,
  # so all of it is this turn. Cost is rounded, or subtracting leaves float noise.
  def since($now; $before):
    if $now == null then null
    elif $before == null or $now < $before then $now
    else $now - $before end;
  def money: if . == null then null else (. * 100000000 | round) / 100000000 end;
  # Turns saved before totals were kept hold the running cost and API time as their
  # own, so they are put right the same way when such a file gets a new turn.
  def with_totals:
    reduce .[] as $t ({turns: [], cost: null, api: null};
      if $t.totals then
        .turns += [$t] | .cost = $t.totals.cost_usd | .api = $t.totals.duration_api_ms
      else
        .turns += [$t + {
          cost_usd: (since($t.cost_usd; .cost) | money),
          duration_api_ms: since($t.duration_api_ms; .api),
          totals: {cost_usd: $t.cost_usd, duration_api_ms: $t.duration_api_ms}}]
        | .cost = $t.cost_usd | .api = $t.duration_api_ms
      end)
    | .turns;
  [inputs | fromjson? | objects] as $events
  | ($events | map(select(.type == "system" and .subtype == "init")) | first) as $init
  | ($events | map(select(.type == "system")) | first) as $sys
  | ($events | map(select(.type == "result"))) as $results
  | ($results | last) as $res
  | ($prev | first) as $p
  | (if $p then ($p | turns_of | with_totals) else [] end) as $earlier
  | ($earlier | last | .totals // {}) as $before
  # What claude reports is a running total for the whole conversation, across
  # resumes: cost, API time and modelUsage. A turn saves its running totals, and
  # as its own numbers what they grew by. usage and the duration are per result,
  # and a run can have several (a background agent), the last perhaps empty.
  # modelUsage has the subagents too, so it is used when it can be compared.
  | ($res.modelUsage // {} | [.[]]) as $models
  | (def sum(f): [$results[] | f | numbers] | if length > 0 then add else null end;
     def model(f): if ($models | length) > 0 then ($models | map(f // 0) | add) else null end;
     def tokens($name; $now; f):
       if $now != null and ($earlier == [] or $before[$name] != null)
       then since($now; $before[$name])
       else sum(f) end;
     (model(.inputTokens)) as $in | (model(.outputTokens)) as $out
     | (model(.cacheCreationInputTokens)) as $cc | (model(.cacheReadInputTokens)) as $cr
     | {totals: {
          cost_usd: ($res.total_cost_usd // null),
          duration_api_ms: ([$results[].duration_api_ms | numbers] | max),
          input_tokens: $in, output_tokens: $out,
          cache_creation_input_tokens: $cc, cache_read_input_tokens: $cr},
        usage: {
          input_tokens: tokens("input_tokens"; $in; .usage.input_tokens),
          output_tokens: tokens("output_tokens"; $out; .usage.output_tokens),
          cache_creation_input_tokens: tokens("cache_creation_input_tokens"; $cc; .usage.cache_creation_input_tokens),
          cache_read_input_tokens: tokens("cache_read_input_tokens"; $cr; .usage.cache_read_input_tokens)}})
    as $counts
  # What was shown: every message, as process_stream_line joins them (a
  # blank line where the message id changes). The result event repeats only
  # the last one (or holds the error).
  | (reduce ($events[] | select(.type == "assistant" and (.error | not) and (.parent_tool_use_id == null))
             | {id: .message.id,
                text: ([.message.content[]? | select(.type == "text") | .text] | join(""))}
             | select(.text != "")) as $e
       ({id: null, text: ""};
        {id: ($e.id // .id),
         text: (.text + (if .text != "" and $e.id != null and $e.id != .id then "\n\n" else "" end) + $e.text)})
     | .text) as $shown
  | {
      question: $question,
      model: ($init.model // null),
      model_option: (if $model_option == "" then null else $model_option end),
      claude_args: (if ($claude_args | length) == 0 then null else $claude_args end),
      effort: (if $effort == "" then null else $effort end),
      answer: (if $shown != "" then $shown
               else ([$results[].result | strings | select(. != "")] | last) end),
      is_error: ($res.is_error // false),
      thinking: ([$events[] | select(.type == "assistant") | .message.content[]?
                  | select(.type == "thinking") | .thinking]
                 | if length > 0 then join("\n") else null end),
      cost_usd: (since($counts.totals.cost_usd; $before.cost_usd) | money),
      duration_ms: ([$results[].duration_ms | numbers] | if length > 0 then add else null end),
      duration_api_ms: since($counts.totals.duration_api_ms; $before.duration_api_ms),
      usage: $counts.usage,
      totals: $counts.totals,
      timestamp: (now | todate)
    } as $turn
  # Parenthesized: jq 1.7 binds "as" tighter than "+" (1.8 does not)
  | ($earlier + [$turn]) as $turns
  | {
      session_id: ($init.session_id // $sys.session_id // $p.session_id // null),
      model: ($init.model // $p.model // null),
      effort: ($turns | last | .effort),
      name: $name,
      cwd: ($p.cwd // $init.cwd // null),
      question: $turns[0].question,
      answer: ($turns | last | .answer),
      is_error: ($turns | last | .is_error),
      thinking: ($turns | last | .thinking),
      cost_usd: ($turns | total(.cost_usd) | money),
      duration_ms: ($turns | total(.duration_ms)),
      duration_api_ms: ($turns | total(.duration_api_ms)),
      usage: {
        input_tokens: ($turns | total(.usage.input_tokens)),
        output_tokens: ($turns | total(.usage.output_tokens)),
        cache_creation_input_tokens: ($turns | total(.usage.cache_creation_input_tokens)),
        cache_read_input_tokens: ($turns | total(.usage.cache_read_input_tokens))
      },
      turn_count: ($turns | length),
      turns: $turns,
      timestamp: $turn.timestamp
    }'

# Name for a new session file: the question's slug, or for a question with
# no ASCII letters or digits (e.g. CJK only) the session id or the time,
# rather than a hidden ".json"
new_session_name() {
  local raw="$1" question="$2" slug sid
  slug=$(slugify_question "$question")
  if [[ -z "$slug" ]]; then
    sid=$(jq -nR -r '[inputs | fromjson? | objects | select(.type == "system")]
      | first | .session_id // empty' "$raw")
    if [[ -n "$sid" ]]; then
      slug="session-${sid:0:8}"
    else
      printf -v slug 'session-%(%Y%m%d-%H%M%S)T' -1
    fi
  fi
  unique_session_name "$slug" "$SESSION_DIR"
}

# save_session RAW QUESTION [FILE]: add the turn in RAW to FILE (an existing
# session), or to a new session file named after QUESTION. With --save-raw
# the raw stream is also appended to NAME.jsonl. Prints the file's path.
# The turn records EFFORT and MODEL (the -e and -m it was asked with) as
# effort and model_option, and the model claude reported as model.
save_session() {
  local raw="$1" question="$2" file="${3:-}" name prev tmp args_json="[]"
  if ((${#CLAUDE_ARGS[@]})); then
    # A word each with --arg: jq 1.6 cuts raw input at a NUL
    local word i=0 names="" arg_opts=()
    for word in "${CLAUDE_ARGS[@]}"; do
      arg_opts+=(--arg "w$i" "$word")
      names+="${names:+,}\$w$i"
      i=$((i + 1))
    done
    args_json=$(jq -n -c "${arg_opts[@]}" "[$names]")
  fi
  if [[ -n "$file" && -f "$file" ]]; then
    name=$(basename "$file" .json)
    prev="$file"
  else
    name=$(new_session_name "$raw" "$question")
    file="${SESSION_DIR}/${name}.json"
    prev=/dev/null
  fi
  debug_log "saving session turn: name=$name file=$file"
  # Written beside the target and moved, so a failed save leaves the old file
  tmp="${file}.tmp.$$"
  # Private: questions and piped input can hold anything. Only here, since
  # the tools claude runs should keep the user's umask
  if (
    umask 077
    jq -nR --arg question "$question" --arg name "$name" --slurpfile prev "$prev" \
      --arg effort "${EFFORT:-}" --arg model_option "${MODEL:-}" \
      --argjson claude_args "$args_json" \
      "$SESSION_JQ" "$raw" > "$tmp"
  ); then
    mv -f "$tmp" "$file"
  else
    rm -f "$tmp"
    return 1
  fi
  if [[ "$SAVE_RAW" -eq 1 ]]; then
    (
      umask 077
      cat "$raw" >> "${SESSION_DIR}/${name}.jsonl"
    )
    chmod 600 "${SESSION_DIR}/${name}.jsonl"
  fi
  printf '%s\n' "$file"
}

# ---------------------------------------------------------------------------
# Theme demo mode: show all themes with sample data and exit
# ---------------------------------------------------------------------------
run_theme_demo() {
  local themes=("${THEMES[@]}")
  local sample_model
  model_label sample_model "opus 5.5" "high"
  local sample_in="19.9k"
  local sample_out="275"
  local sample_cost="\$0.0950"
  local sample_dur="7.4s"

  local bar_text
  for theme in "${themes[@]}"; do
    echo "${BOLD}${theme}${RST}"

    # In-progress state (with spinner)
    THEME="$theme"
    printf '  streaming: '
    local idx=0
    for _ in {1..10}; do
      local s="${SPINNER[$idx]}"
      printf '\r  streaming: '
      render_status_bar bar_text "$s" "$sample_model" "$sample_in" "$sample_out" "" "" "running"
      printf '%s' "$bar_text"
      idx=$(((idx + 1) % ${#SPINNER[@]}))
      sleep "${CLAUDE_ASK_DEMO_DELAY:-0.08}"
    done
    printf '\n'

    # Finished state
    printf '  finished:  '
    render_status_bar bar_text "✓" "$sample_model" "$sample_in" "$sample_out" "$sample_cost" "$sample_dur" "done"
    printf '%s' "$bar_text"
    printf '\n\n'
  done
}

if [[ "$DEMO_THEMES" -eq 1 ]]; then
  run_theme_demo
  exit 0
fi

