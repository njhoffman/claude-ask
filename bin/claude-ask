generate_mock_stream() {
  local size="${1:-small}" delay="${2:-0.05}"
  local mock_text input_tokens output_tokens cost duration_ms
  local chunk_size=80

  case "$size" in
    small)
      mock_text="$MOCK_SMALL_TEXT"
      input_tokens=150
      output_tokens=20
      cost="0.001200"
      duration_ms=1200
      ;;
    medium)
      mock_text="$MOCK_MEDIUM_TEXT"
      input_tokens=500
      output_tokens=275
      cost="0.012345"
      duration_ms=4500
      ;;
    large)
      mock_text="$MOCK_LARGE_TEXT"
      input_tokens=1200
      output_tokens=850
      cost="0.045600"
      duration_ms=12000
      ;;
    *)
      echo "Error: --demo-output size must be small, medium, or large" >&2
      return 1
      ;;
  esac

  # System init
  printf '{"type":"system","subtype":"init","cwd":"/tmp","session_id":"demo-%s","model":"claude-opus-4-6[1m]"}\n' "$size"
  sleep "$delay"

  # Thinking event
  printf '{"type":"assistant","message":{"content":[{"type":"thinking","thinking":"Let me think about this question."}],"usage":{"input_tokens":%d,"output_tokens":0}},"session_id":"demo-%s"}\n' "$input_tokens" "$size"
  sleep "$delay"

  # Stream text in chunks
  local text_len=${#mock_text}
  local offset=0 running_out=0
  while [[ $offset -lt $text_len ]]; do
    local chunk="${mock_text:$offset:$chunk_size}"
    running_out=$((running_out + ${#chunk} / 4))
    # Escape the chunk for JSON: handle backslashes, quotes, newlines, tabs
    local json_chunk
    json_chunk=$(printf '%s' "$chunk" | jq -Rs '.')
    # jq -Rs wraps in quotes; strip outer quotes for embedding
    json_chunk="${json_chunk:1:${#json_chunk}-2}"
    printf '{"type":"assistant","message":{"content":[{"type":"text","text":"%s"}],"usage":{"input_tokens":%d,"output_tokens":%d}},"session_id":"demo-%s"}\n' \
      "$json_chunk" "$input_tokens" "$running_out" "$size"
    offset=$((offset + chunk_size))
    sleep "$delay"
  done

  # Result
  printf '{"type":"result","subtype":"success","is_error":false,"duration_ms":%d,"duration_api_ms":%d,"num_turns":1,"result":"","total_cost_usd":%s,"usage":{"input_tokens":%d,"output_tokens":%d}}\n' \
    "$duration_ms" "$((duration_ms - 100))" "$cost" "$input_tokens" "$output_tokens"
}

run_demo_output() {
  local sizes=("small" "medium" "large")
  local modes=() mode size line save_stream

  if [[ "$STREAM_OUTPUT" -eq 1 ]]; then
    modes+=("stream")
  fi
  modes+=("batch")

  for mode in "${modes[@]}"; do
    for size in "${sizes[@]}"; do
      printf '\n%s%s response (%s mode)%s\n' "$BOLD" "$size" "$mode" "$RST"
      printf '%s%s%s\n' "$FG_DIM" "$(printf '%.0s─' {1..50})" "$RST"

      save_stream="$STREAM_OUTPUT"
      if [[ "$mode" == "batch" ]]; then
        STREAM_OUTPUT=0
      else
        STREAM_OUTPUT=1
      fi

      # Feed mock data through the same pipeline the real CLI uses
      reset_stream_state
      STATUS_BAR_VISIBLE=0
      STREAM_START=$SECONDS

      if [[ "$USE_PAGER" -eq 1 && "$STREAM_OUTPUT" -eq 1 ]]; then
        start_pager_pipe
      fi

      update_status_bar "${SPINNER[0]}" "connecting..." "" "" "" "" "running"

      while IFS= read -r line; do
        process_stream_line "$line" || continue
        if [[ -n "$CHUNK" && "$STREAM_OUTPUT" -eq 1 ]]; then
          write_chunk "$CHUNK"
        fi
        refresh_status_bar
      done < <(generate_mock_stream "$size" "${CLAUDE_ASK_DEMO_DELAY:-0.03}")

      stop_pager_pipe
      print_batch_answer
      show_final_status_bar

      STREAM_OUTPUT="$save_stream"
      printf '\n'
    done
  done
}

# ---------------------------------------------------------------------------
# Session naming helpers
# ---------------------------------------------------------------------------
slugify_question() {
  local q="$1" max="${2:-50}"
  printf '%s' "$q" \
    | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^a-z0-9]/-/g; s/--*/-/g; s/^-//; s/-$//' \
    | cut -c1-"$max"
}

unique_session_name() {
  local base="$1" dir="$2"
  if [[ ! -f "${dir}/${base}.json" ]]; then
    printf '%s' "$base"
    return
  fi
  local n=2
  while [[ -f "${dir}/${base}-${n}.json" ]]; do
    ((n++))
  done
  printf '%s' "${base}-${n}"
}

# ---------------------------------------------------------------------------
# History & session viewing helpers
# ---------------------------------------------------------------------------
# OUT SECONDS: an age such as "42 sec ago", "5 min ago", "2.5 hrs ago",
# "3d ago" or "2w ago"
format_age() {
  local _out="$1" _diff="$2" _hrs _tenths
  if ((_diff < 60)); then
    printf -v "$_out" '%d sec ago' "$_diff"
  elif ((_diff < 3600)); then
    printf -v "$_out" '%d min ago' "$((_diff / 60))"
  elif ((_diff < 86400)); then
    _hrs=$((_diff / 3600))
    _tenths=$(((_diff % 3600) * 10 / 3600))
    if ((_tenths > 0)); then
      printf -v "$_out" '%d.%d hrs ago' "$_hrs" "$_tenths"
    else
      printf -v "$_out" '%d hrs ago' "$_hrs"
    fi
  elif ((_diff < 604800)); then
    printf -v "$_out" '%dd ago' "$((_diff / 86400))"
  else
    printf -v "$_out" '%dw ago' "$((_diff / 604800))"
  fi
}

# --history's fields, five NUL-terminated ones per session file: the file,
# its last timestamp in epoch seconds ("" when missing or not ISO 8601 that
# jq reads the same way on GNU and BSD), the first question, the answer
# lines over all turns and the number of turns
# shellcheck disable=SC2016 # jq program
HISTORY_JQ="${SESSION_TURNS_JQ}"'
  inputs
  | turns_of as $t
  | [input_filename,
     (.timestamp // "" | try fromdateiso8601 catch ""),
     ($t[0].question // ""),
     ($t | map(.answer // "" | split("\n") | length) | add // 0),
     ($t | length)]
  | map(tostring | clean + "\u0000") | add'

# history_records FILE...: set HISTORY_RECORDS to the files' fields, with
# one jq for all of them. jq stops at a file that is not JSON, so when the
# fields do not come out as five per file each file is read on its own, and
# one that cannot be read keeps just its name.
history_records() {
  local f one=()
  HISTORY_RECORDS=()
  mapfile -d '' -t HISTORY_RECORDS < <(jq -n -j "$HISTORY_JQ" "$@" 2> /dev/null)
  ((${#HISTORY_RECORDS[@]} == 5 * $#)) && return 0
  debug_log "history: one jq for $# files gave ${#HISTORY_RECORDS[@]} fields, reading each file"
  HISTORY_RECORDS=()
  for f in "$@"; do
    mapfile -d '' -t one < <(jq -n -j "$HISTORY_JQ" "$f" 2> /dev/null)
    if ((${#one[@]} != 5)); then one=("$f" "" "" 0 1); fi
    HISTORY_RECORDS+=("${one[@]}")
  done
}

# display_width OUT TEXT: the columns TEXT takes. Only text that is not ASCII
# costs a process, for double-width characters (wc -L; else its characters).
display_width() {
  local _w=""
  if [[ "$2" == *[![:ascii:]]* ]]; then
    _w=$(printf '%s' "$2" | wc -L 2> /dev/null) || _w=""
  fi
  printf -v "$1" '%d' "${_w:-${#2}}"
}

# fit_column OUT TEXT WIDTH: TEXT cut (with an ellipsis) or padded with spaces
# to exactly WIDTH columns
fit_column() {
  local _t="$2" _width="$3" columns _over
  display_width columns "$_t"
  if ((columns > _width)); then
    _t="${_t:0:_width-1}"
    display_width columns "$_t"
    while ((columns > _width - 1)); do
      # At most two columns a character, so this does not overshoot by more
      _over=$(((columns - _width + 2) / 2))
      _t="${_t:0:${#_t}-_over}"
      display_width columns "$_t"
    done
    _t+="…"
    columns=$((columns + 1))
  fi
  printf -v "$1" '%s%*s' "$_t" "$((_width - columns))" ""
}

show_history() {
  local session_dir="$1"
  local files=() f

  while IFS= read -r f; do
    [[ -n "$f" ]] && files+=("$f")
  done < <(ls -t "$session_dir"/*.json 2> /dev/null)

  if [[ ${#files[@]} -eq 0 ]]; then
    echo "No saved sessions." >&2
    return 1
  fi

  history_records "${files[@]}"
  local idx=1 i now name epoch question_text answer_lines turn_count time_ago disp_name disp_q size
  # At a terminal the question gets what is left of the width, and in a very
  # narrow one the name goes too. 12 is the size column ("1234L 12T") and its
  # separator; to a pipe, or with no known width, it stays at the widest.
  local q_width=40 name_width=$((MAX_DISPLAY_NAME + 1)) idx_width=${#files[@]} room
  idx_width=${#idx_width}
  TERM_COLS=0
  if ((OUT_TTY)) || [[ -n "${CLAUDE_ASK_COLUMNS:-}" ]]; then read_term_cols; fi
  if ((TERM_COLS > 0)); then
    room=$((TERM_COLS - idx_width - 3 - 13 - 3 - name_width - 3 - 12))
    if ((room < 16)); then
      room=$((room + name_width + 3))
      name_width=0
    fi
    if ((room < 8)); then room=8; fi
    if ((room < q_width)); then q_width=$room; fi
  fi
  printf -v now '%(%s)T' -1
  for ((i = 0; i + 4 < ${#HISTORY_RECORDS[@]}; i += 5)); do
    name="${HISTORY_RECORDS[i]##*/}"
    name="${name%.json}"
    epoch="${HISTORY_RECORDS[i + 1]}"
    question_text="${HISTORY_RECORDS[i + 2]}"
    answer_lines="${HISTORY_RECORDS[i + 3]:-0}"
    turn_count="${HISTORY_RECORDS[i + 4]:-1}"

    disp_name=""
    if ((name_width > 0)); then
      fit_column disp_name "$name" "$name_width"
      disp_name+=" | "
    fi
    fit_column disp_q "${question_text//$'\n'/ }" "$q_width"

    time_ago=""
    if [[ "$epoch" =~ ^[0-9]+$ ]]; then format_age time_ago "$((now - epoch))"; fi

    size="${answer_lines}L"
    if [[ "$turn_count" -gt 1 ]]; then size+=" ${turn_count}T"; fi
    printf '%*d | %-13s | %s%s | %s\n' "$idx_width" "$idx" "$time_ago" "$disp_name" "$disp_q" "$size"

    ((idx++))
  done
}

# find_session ID|N: set FOUND_SESSION to the session file that ID names: a
# number is an index into --history (newest first), else a name, else a
# unique name prefix. Returns 1 when none matches, 2 when the prefix is
# ambiguous (the matches are listed on stderr).
find_session() {
  local arg="$1" f files=() matches=()
  FOUND_SESSION=""
  if [[ "$arg" =~ ^[0-9]+$ ]]; then
    while IFS= read -r f; do
      [[ -n "$f" ]] && files+=("$f")
    done < <(ls -t "$SESSION_DIR"/*.json 2> /dev/null)
    if ((arg >= 1 && arg <= ${#files[@]})); then
      FOUND_SESSION="${files[arg - 1]}"
      return 0
    fi
  fi
  if [[ -f "${SESSION_DIR}/${arg}.json" ]]; then
    FOUND_SESSION="${SESSION_DIR}/${arg}.json"
    return 0
  fi
  while IFS= read -r f; do
    [[ -n "$f" ]] && matches+=("$f")
  done < <(ls "${SESSION_DIR}/${arg}"*.json 2> /dev/null)
  if ((${#matches[@]} == 1)); then
    FOUND_SESSION="${matches[0]}"
    return 0
  fi
  if ((${#matches[@]} > 1)); then
    echo "Ambiguous session name '${arg}'. Matches:" >&2
    for f in "${matches[@]}"; do
      echo "  $(basename "$f" .json)" >&2
    done
    return 2
  fi
  return 1
}

view_session() {
  local arg="$1"
  local session_dir="${SESSION_DIR}"

  if [[ -z "$arg" || "$arg" == "__SHOW_HISTORY__" ]]; then
    show_history "$session_dir"
    return
  fi

  local session_file="" rc=0
  find_session "$arg" || rc=$?
  if ((rc == 2)); then return 1; fi
  session_file="$FOUND_SESSION"

  if [[ -z "$session_file" || ! -f "$session_file" ]]; then
    echo "Session not found: ${arg}" >&2
    echo "" >&2
    show_history "$session_dir"
    return 1
  fi

  if [[ -n "$YANK" ]]; then
    yank_session_file "$session_file"
    return
  fi
  session_file_ok "$session_file" || return 1
  debug_log "viewing session: $session_file"
  show_turns "$session_file" all
}

# show_turns FILE all|last: replay a session's turns (question, status bar,
# answer through the pager)
show_turns() {
  local file="$1" which="$2" fields=() i label
  read_term_cols
  # Nine NUL-terminated fields per turn: the turn's model (the session's for
  # turns saved before turns had one), its effort, then what show_turn takes
  mapfile -d '' -t fields < <(jq -j --arg which "$which" "${SESSION_TURNS_JQ}"'
    (.model // "unknown") as $model
    | turns_of | (if $which == "last" then [last] else . end)[]
    | [(.model // $model), .effort, .question, .answer, (.is_error // false),
       .cost_usd, .duration_ms, .usage.input_tokens, .usage.output_tokens]
    | map((. // "" | tostring | clean) + "\u0000") | add' "$file")
  # More than one turn at a terminal: one less over all of them, not the
  # renderer's own pager once per turn (writing to a pipe, it only renders).
  # -F: a replay that fits is just printed. Quitting early is not a failure.
  if [[ -t 1 && "$USE_PAGER" -eq 1 && ${#fields[@]} -gt 9 ]] && command -v less > /dev/null 2>&1; then
    show_turn_fields 1 | less -R -F -X || true
  else
    show_turn_fields "$BAR_FD"
  fi
}

# show_turns' loop, over its fields; the status bars go to fd $1
show_turn_fields() {
  local BAR_FD="$1"
  for ((i = 0; i + 8 < ${#fields[@]}; i += 9)); do
    if ((i > 0)); then printf '\n'; fi
    model_label label "$(short_model_name "${fields[i]}")" "${fields[i + 1]}"
    show_turn "$label" "${fields[@]:i+2:7}"
  done
}

# show_turn MODEL_LABEL QUESTION ANSWER IS_ERROR COST DURATION_MS IN OUT
show_turn() {
  local model="$1" q="$2" answer="$3" is_error="$4"
  local disp_in disp_out disp_cost disp_dur bar_text mark="✓" state="done"
  if [[ "$is_error" == "true" ]]; then
    mark="✗"
    state="error"
  fi
  format_cost disp_cost "$5"
  format_duration disp_dur "$6"
  format_tokens disp_in "$7"
  format_tokens disp_out "$8"

  if ((OUT_TTY)); then
    if [[ -n "$q" ]]; then
      printf '%s> %s%s\n' "$FG_DIM" "$q" "$RST"
    fi
  elif [[ -n "$q" ]]; then
    printf '> %s\n' "$q"
  fi
  render_status_bar_fitted bar_text "$mark" "$model" "$disp_in" "$disp_out" "$disp_cost" "$disp_dur" "$state"
  printf '%s\n' "$bar_text" >&"$BAR_FD"
  if ((OUT_TTY)); then printf '\n'; fi

  if [[ "$USE_PAGER" -eq 1 ]]; then
    printf '%s' "$answer" | run_pager
  else
    printf '%s' "$answer"
  fi
  printf '\n'
}

if [[ "$SHOW_HISTORY" -eq 1 ]]; then
  mkdir -p "$SESSION_DIR"
  show_history "$SESSION_DIR"
  exit 0
fi

if [[ -n "$VIEW_SESSION" ]]; then
  mkdir -p "$SESSION_DIR"
  rc=0
  view_session "$VIEW_SESSION" || rc=$?
  exit "$rc"
fi

if [[ "$YANK_PREVIOUS" -eq 1 ]]; then
  newest=$(newest_session_file)
  if [[ -z "$newest" ]]; then
    echo "claude-ask: no saved session to yank from" >&2
    exit 1
  fi
  yank_session_file "$newest"
  exit
fi

# Allow sourcing for tests: if _CLAUDE_ASK_SOURCED is set, stop here
if [[ -n "${_CLAUDE_ASK_SOURCED:-}" ]]; then
  # shellcheck disable=SC2317 # exit is reached only when executed, not sourced
  return 0 2> /dev/null || exit 0
fi

# ---------------------------------------------------------------------------
# Cursor tracking & status bar rendering (below content)
# ---------------------------------------------------------------------------
STATUS_BAR_VISIBLE=0
STREAM_START=0

# Text goes over the bar's rows, so they are cleared first (it is redrawn
# below the text after), or the end of a long bar line would stay beside it
emit_text() {
  [[ -n "$1" ]] || return 0
  if ((STATUS_BAR_VISIBLE)); then
    printf '\e[J' >&"$BAR_FD"
    STATUS_BAR_VISIBLE=0
  fi
  printf '%s' "$1"
}

# Arguments: those of render_status_bar, without OUT
#
# The bar is drawn under the text and the cursor put back where it was, with
# no idea which column that is, since counting one is wrong for wrapped lines,
# wide characters and a pager's colors. The rows it needs are made first (\eD,
# index: down one, scrolling at the bottom, in the same column, unlike \n),
# so nothing scrolls between saving the cursor and restoring it.
update_status_bar() {
  local bar_text info_text bar_rows info_rows rows i out=""
  render_status_bar_fitted bar_text "$@"
  render_stream_info info_text "$answer_lines" "$answer_chars" "$text_chunks" "$((SECONDS - STREAM_START))" "$status" "$is_thinking" "${CONV_INFO:-}" "$current_tool"
  text_rows bar_rows "$bar_text"
  text_rows info_rows "$info_text"
  rows=$((1 + bar_rows + info_rows))
  for ((i = 0; i < rows; i++)); do out+=$'\eD'; done
  # Clear below the cursor (the old bar and info), then draw two lines down
  printf '%s\e[%dA\e7\e[J\n\n\e[2K%s\n\e[2K%s\e8' "$out" "$rows" "$bar_text" "$info_text" >&"$BAR_FD"
  STATUS_BAR_VISIBLE=1
}

finalize_status_bar() {
  local bar_text info_text
  render_status_bar_fitted bar_text "$@"
  render_stream_info info_text "$answer_lines" "$answer_chars" "$text_chunks" "" "done" "$is_thinking" "${CONV_INFO:-}"
  # Clear from cursor to end of screen, and print the final status bar and
  # info line 2 lines below content (stdout's answer gets just its newline)
  if ((OUT_TTY)); then
    printf '\e[J\n\n%s\n%s\n' "$bar_text" "$info_text"
  else
    printf '\e[J%s\n%s\n' "$bar_text" "$info_text" >&"$BAR_FD"
    if [[ -n "$answer_text" && "$STREAM_OUTPUT" -eq 1 ]]; then printf '\n'; fi
  fi
  STATUS_BAR_VISIBLE=0
}

# Advance the spinner and redraw the status bar from the stream state
refresh_status_bar() {
  local spin_char
  spinner_idx=$(((spinner_idx + 1) % ${#SPINNER[@]}))
  spin_char="${SPINNER[$spinner_idx]}"
  if [[ "$status" == "done" ]]; then spin_char="✓"; fi
  if [[ "$status" == "error" ]]; then spin_char="✗"; fi

  # Drain any rendered output from the pager before updating the status bar
  drain_pager

  local disp_in disp_out disp_cost disp_dur label
  format_tokens disp_in "$input_tokens"
  format_tokens disp_out "$output_tokens"
  format_cost disp_cost "$cost"
  format_duration disp_dur "$duration_ms"
  model_label label "${model:-...}" "$EFFORT"
  update_status_bar "$spin_char" "$label" "$disp_in" "$disp_out" "$disp_cost" "$disp_dur" "$status"
}

# The status bar left below the answer once the stream has ended
show_final_status_bar() {
  local mark="✓"
  if [[ "$status" != "done" ]]; then mark="✗"; fi
  local disp_in disp_out disp_cost disp_dur label
  format_tokens disp_in "$input_tokens"
  format_tokens disp_out "$output_tokens"
  format_cost disp_cost "$cost"
  format_duration disp_dur "$duration_ms"
  model_label label "${model:-...}" "$EFFORT"
  finalize_status_bar "$mark" "$label" "$disp_in" "$disp_out" "$disp_cost" "$disp_dur" "$status"
}

# In batch mode (--no-stream), render the complete answer once it is in
print_batch_answer() {
  [[ "$STREAM_OUTPUT" -eq 0 && -n "$answer_text" ]] || return 0
  # Clear the status bar area (was showing progress only)
  printf '\e[J' >&"$BAR_FD"
  STATUS_BAR_VISIBLE=0
  if [[ "$USE_PAGER" -eq 1 ]]; then
    printf '%s' "$answer_text" | run_pager
  else
    printf '%s' "$answer_text"
  fi
  printf '\n'
}

# ---------------------------------------------------------------------------
# Per-run private directory (FIFO, raw stream, claude's stderr) and cleanup
# ---------------------------------------------------------------------------
run_dir_base="${XDG_RUNTIME_DIR:-}"
if [[ ! -d "$run_dir_base" || ! -w "$run_dir_base" ]]; then
  run_dir_base="${TMPDIR:-/tmp}"
fi
RUN_DIR=$(mktemp -d "${run_dir_base}/claude-ask.XXXXXX")

PAGER_PID=""
PAGER_FIFO=""
PAGER_OUT_FD=""
CLAUDE_PID=""

# shellcheck disable=SC2317 # called by trap
cleanup() {
  debug_log "cleanup called"
  # Clear any lingering status bar below content
  if [[ "${STATUS_BAR_VISIBLE:-0}" -eq 1 ]]; then
    printf '\e[J' >&"$BAR_FD"
  fi
  printf '\e[?25h' >&"$BAR_FD" # ensure cursor visible
  if [[ -n "$PAGER_PID" ]]; then kill "$PAGER_PID" 2> /dev/null || true; fi
  if [[ -n "$CLAUDE_PID" ]]; then kill "$CLAUDE_PID" 2> /dev/null || true; fi
  stop_stream_jq
  if [[ -n "$PAGER_OUT_FD" ]]; then exec {PAGER_OUT_FD}<&- 2> /dev/null || true; fi
  # The intr key, if the chat prompt had it undefined
  if [[ -n "${CHAT_STTY:-}" ]]; then stty "$CHAT_STTY" 2> /dev/null || true; fi
  rm -rf "$RUN_DIR" 2> /dev/null || true
}
# Ctrl-C: in a chat it stops the answer being streamed (or clears the prompt
# line) and the chat goes on; otherwise it ends the run like before
TURN_INTERRUPTED=0
# shellcheck disable=SC2317 # called by trap
on_interrupt() {
  TURN_INTERRUPTED=1
  if [[ "$INTERACTIVE" -eq 1 ]]; then
    if [[ -n "$CLAUDE_PID" ]]; then kill "$CLAUDE_PID" 2> /dev/null || true; fi
    return 0
  fi
  exit 130
}
trap cleanup EXIT
trap on_interrupt INT
trap 'exit 143' TERM
# Ctrl-\ too, so cleanup puts back the intr key the chat prompt undefines
trap 'exit 131' QUIT
# Re-read the width on a resize; a trapped WINCH does not cut a read short
trap read_term_cols WINCH

# ---------------------------------------------------------------------------
# Streaming pager: the pager reads chunks from a FIFO and its rendered output
# is read back here, so it can be drained in step with status bar updates
# ---------------------------------------------------------------------------
start_pager_pipe() {
  PAGER_FIFO="$RUN_DIR/pager.fifo"
  mkfifo "$PAGER_FIFO"
  exec {PAGER_OUT_FD}< <(run_pager < "$PAGER_FIFO" 2> /dev/null)
  PAGER_PID=$!
  exec 3> "$PAGER_FIFO"
  debug_log "pager pipeline: fifo=$PAGER_FIFO pid=$PAGER_PID out_fd=$PAGER_OUT_FD"
}

# Close the pager's input and print the rest of its output
stop_pager_pipe() {
  [[ -n "$PAGER_OUT_FD" ]] || return 0
  exec 3>&-
  drain_pager_final
  exec {PAGER_OUT_FD}<&-
  PAGER_OUT_FD=""
  wait "$PAGER_PID" 2> /dev/null || true
  PAGER_PID=""
  rm -f "$PAGER_FIFO"
  PAGER_FIFO=""
}

# Write a text chunk: through the pager if running, otherwise to the terminal
write_chunk() {
  local chunk="$1"
  if [[ -n "$PAGER_OUT_FD" ]]; then
    printf '%s' "$chunk" >&3
  else
    emit_text "$chunk"
  fi
}

# Drain available pager output into the terminal without blocking. Each read
# waits at most 10ms; on a timeout read keeps the text it got, so a line the
# pager has only partly written is printed as far as it goes instead of
# stalling the status bar until the pager finishes it.
drain_pager() {
  [[ -z "$PAGER_OUT_FD" ]] && return 0
  local pager_line
  while true; do
    pager_line=""
    if IFS= read -r -t 0.01 pager_line <&"${PAGER_OUT_FD}"; then
      emit_text "${pager_line}"$'\n'
    else
      # Timeout or EOF: print any partial line and stop
      emit_text "$pager_line"
      break
    fi
  done
}

# Drain all remaining pager output (blocking until EOF)
drain_pager_final() {
  [[ -z "$PAGER_OUT_FD" ]] && return 0
  local pager_line
  # The || keeps a last line that has no trailing newline
  while IFS= read -r pager_line <&"${PAGER_OUT_FD}" || [[ -n "$pager_line" ]]; do
    emit_text "${pager_line}"$'\n'
  done
}

# ---------------------------------------------------------------------------
# Demo output mode: run mock streams through the real rendering pipeline
# ---------------------------------------------------------------------------
if [[ "$DEMO_OUTPUT" -eq 1 ]]; then
  run_demo_output
  exit 0
fi

# ---------------------------------------------------------------------------
# Conversation state: the session file and claude session id the next
# question continues (empty for a new conversation), turns so far, total cost
# ---------------------------------------------------------------------------
CONV_FILE=""
CONV_SESSION_ID=""
CONV_TURNS=0
CONV_COST=""
CONV_INFO=""
LAST_TURN_STATUS=0
# The model to go back to when claude does not know MODEL: the last one that
# answered (empty: claude's default). MODEL_RESTORED is 1 while MODEL is one
# -r took from the session, which is retried with the default if it is gone.
MODEL_GOOD=""
MODEL_RESTORED=0
# The conversation's last answer, for /yank
LAST_ANSWER=""
# The model of the last answer (short name) and the -m or /model it was
# asked with, for the chat prompt
LAST_MODEL=""
LAST_MODEL_FOR=""

# ask_once QUESTION: stream one answer, continuing the conversation when
# there is one, and save the turn. Returns 0, 1 when claude failed, or 130
# when the answer was interrupted (chat mode only).
ask_once() {
  local q="$1" line claude_status=0 saved_file total
  local claude_args=(--output-format stream-json --verbose -p)
  if [[ -n "$CONV_SESSION_ID" ]]; then
    claude_args+=(--resume "$CONV_SESSION_ID")
  fi
  if [[ -n "$EFFORT" ]]; then claude_args+=(--effort "$EFFORT"); fi
  if [[ -n "$MODEL" ]]; then claude_args+=(--model "$MODEL"); fi

  : > "$RAW_JSON"
  : > "$CLAUDE_STDERR"
  read_term_cols
  reset_stream_state
  STREAM_START=$SECONDS
  TURN_INTERRUPTED=0
  CONV_INFO=""
  if ((CONV_TURNS > 0)); then CONV_INFO="turn $((CONV_TURNS + 1))"; fi

  if [[ "$USE_PAGER" -eq 1 && "$STREAM_OUTPUT" -eq 1 ]]; then
    start_pager_pipe
  fi
  update_status_bar "${SPINNER[0]}" "connecting..." "" "" "" "" "running"

  # claude runs on its own fd so its exit status can be collected afterwards.
  # The question goes in on stdin, so one starting with "-" is never read as
  # an option (and it stays out of the process list).
  debug_log "asking: resume=${CONV_SESSION_ID:-none} effort=${EFFORT:-default} model=${MODEL:-default} question_len=${#q}"
  exec {CLAUDE_FD}< <("$CLAUDE_BIN" "${claude_args[@]}" <<< "$q" 2> "$CLAUDE_STDERR")
  CLAUDE_PID=$!

  # A Ctrl-C interrupts the read; on_interrupt has already stopped claude
  while ((!TURN_INTERRUPTED)) && IFS= read -r line <&"$CLAUDE_FD"; do
    printf '%s\n' "$line" >> "$RAW_JSON"
    process_stream_line "$line" || continue
    if [[ -n "$CHUNK" && "$STREAM_OUTPUT" -eq 1 ]]; then
      write_chunk "$CHUNK"
    fi
    refresh_status_bar
  done

  exec {CLAUDE_FD}<&-
  if ((TURN_INTERRUPTED)); then kill "$CLAUDE_PID" 2> /dev/null || true; fi
  wait "$CLAUDE_PID" || claude_status=$?
  CLAUDE_PID=""
  debug_log "claude exited: status=$claude_status stream_status=$status interrupted=$TURN_INTERRUPTED"

  stop_pager_pipe

  # An interrupted answer is not saved: claude sent no result for it
  if ((TURN_INTERRUPTED)); then
    printf '\e[J\n%s(interrupted)%s\n' "$FG_DIM" "$RST" >&"$BAR_FD"
    STATUS_BAR_VISIBLE=0
    return 130
  fi

  print_batch_answer

  # A stream that ended without a result event did not finish
  if [[ "$status" == "running" ]]; then
    status="error"
  fi

  # An unknown model answered nothing: the turn is not saved and the
  # conversation stays where it was. Go back to the last model that worked;
  # one -r restored (not one asked for) is retried with it at once.
  if [[ "$api_error" == "model_not_found" ]]; then
    local bad_model="$MODEL" retry="$MODEL_RESTORED"
    MODEL="$MODEL_GOOD"
    MODEL_RESTORED=0
    show_final_status_bar
    printf 'claude-ask: %s\n' "$stream_error" >&2
    printf 'claude-ask: model %s not found; back to %s\n' "${bad_model:-?}" "${MODEL:-the default model}" >&2
    debug_log "model_not_found: model=$bad_model fallback=${MODEL:-default} retry=$retry"
    if ((retry)); then
      ask_once "$q"
      return
    fi
    return 1
  fi

  if [[ -n "$session_id" ]]; then
    CONV_SESSION_ID="$session_id"
    if [[ -s "$RAW_JSON" ]] && saved_file=$(save_session "$RAW_JSON" "$q" "$CONV_FILE"); then
      CONV_FILE="$saved_file"
      local fields=()
      mapfile -t fields < <(jq -r '.turn_count, (.cost_usd // "")' "$CONV_FILE")
      CONV_TURNS="${fields[0]:-1}"
      CONV_COST="${fields[1]:-}"
    fi
  fi
  if ((CONV_TURNS > 1)); then
    format_cost total "$CONV_COST"
    CONV_INFO="turn ${CONV_TURNS}${total:+ | $total total}"
  fi
  show_final_status_bar
  if [[ -n "$denied_tools" ]]; then
    printf 'claude-ask: not permitted: %s\n' "$denied_tools" >&2
  fi

  # Report failures: claude's exit status, an error result, or no result
  if [[ "$claude_status" -ne 0 || "$status" == "error" ]]; then
    if [[ -n "$stream_error" ]]; then
      printf 'claude-ask: %s\n' "$stream_error" >&2
    elif [[ "$claude_status" -ne 0 ]]; then
      printf 'claude-ask: %s exited with status %d\n' "$CLAUDE_BIN" "$claude_status" >&2
    else
      printf 'claude-ask: the response ended without a result\n' >&2
    fi
    if [[ -s "$CLAUDE_STDERR" ]]; then
      sed 's/^/  /' "$CLAUDE_STDERR" >&2
    fi
    return 1
  fi
  MODEL_GOOD="$MODEL"
  MODEL_RESTORED=0
  LAST_ANSWER="${answer_text:-$result_text}"
  LAST_MODEL="$model"
  LAST_MODEL_FOR="$MODEL"
  # -y/-Y copy every new answer; a failed copy is reported, the turn is fine
  if [[ -n "$YANK" ]]; then
    yank_answer "$LAST_ANSWER" "$YANK" "$YANK_CODE_N" || true
  fi
  return 0
}

# In a popup: the whole answer from the top in a pager (the Markdown pager's
# output read through CLAUDE_ASK_POPUP_PAGER, default "less -R -+F": -+F so
# a LESS with -F does not quit at once on a short answer). Quitting it ends
# claude-ask and so closes the popup. After a failure: wait for a key.
page_answer_in_popup() {
  local failed="$1" pager="${CLAUDE_ASK_POPUP_PAGER:-less -R -+F}"
  if ((failed)) || [[ -z "$LAST_ANSWER" ]]; then
    printf '\n%spress a key to close%s' "$FG_DIM" "$RST"
    read -r -s -n 1 < /dev/tty || true
    return
  fi
  if [[ "$USE_PAGER" -eq 1 ]]; then
    printf '%s\n' "$LAST_ANSWER" | run_pager | bash -c "$pager"
  else
    printf '%s\n' "$LAST_ANSWER" | bash -c "$pager"
  fi
}

# --split and --popup: start claude-ask again in a new tmux pane or a popup
# with the same choices, and the question (if any) in a private temp file.
# tmux runs it with the server's environment, so this shell's goes in a private
# file too, not on tmux's command line where ps shows it: all that is exported,
# but what belongs to the new pane.
launch_in_tmux() {
  local self child=() envs=() var qfile="" envfile w h dir size
  self=$(readlink -f "${BASH_SOURCE[0]}")
  child=(--theme "$THEME")
  if [[ -n "$EFFORT" ]]; then child+=(--effort "$EFFORT"); fi
  if [[ -n "$MODEL" ]]; then child+=(--model "$MODEL"); fi
  if [[ "$USE_PAGER" -eq 0 ]]; then
    child+=(--no-pager)
  elif [[ "$PAGER_IS_DEFAULT" -eq 0 ]]; then
    child+=(--pager "$PAGER_CMD")
  fi
  if [[ "$STREAM_OUTPUT" -eq 0 ]]; then child+=(--no-stream); fi
  if [[ "$SAVE_RAW" -eq 1 ]]; then child+=(--save-raw); fi
  if [[ -n "$DEBUG_LOG" ]]; then child+=("--debug-log=$DEBUG_LOG"); fi
  if [[ -n "$RESUME_ARG" ]]; then
    child+=("--resume=$RESUME_ARG")
  elif [[ "$RESUME" -eq 1 ]]; then
    child+=(-r)
  fi
  case "$YANK" in
    answer) child+=(--yank) ;;
    code) child+=("--yank-code${YANK_CODE_N:+=$YANK_CODE_N}") ;;
  esac

  envfile=$(mktemp "${run_dir_base}/claude-ask-env.XXXXXX")
  while IFS= read -r var; do
    case "$var" in
      TMUX | TMUX_PANE | TERM | COLUMNS | LINES | PWD | OLDPWD | SHLVL | _) ;;
      *) printf 'export %s=%q\n' "$var" "${!var}" ;;
    esac
  done < <(compgen -e) > "$envfile"
  envs=(-e "_CLAUDE_ASK_ENV_FILE=$envfile")
  if [[ -n "$question" ]]; then
    qfile=$(mktemp "${run_dir_base}/claude-ask-question.XXXXXX")
    printf '%s' "$question" > "$qfile"
    envs+=(-e "_CLAUDE_ASK_QUESTION_TMP=$qfile")
  fi

  local rc=0
  if [[ "$TMUX_MODE" == split ]]; then
    # With a question the answer goes to the new pane and it stays as a chat;
    # -d keeps the focus here. Without one the chat (and the focus) go there.
    local detach=()
    if [[ -n "$question" ]]; then
      child+=(-i)
      detach=(-d)
    fi
    dir="$SPLIT_DIR"
    if [[ "$dir" == auto ]]; then
      read -r w h < <(tmux display-message -p '#{pane_width} #{pane_height}')
      dir=$(split_direction "${w:-80}" "${h:-24}")
    fi
    debug_log "tmux split: -$dir ${detach[*]} ${child[*]}"
    tmux split-window "-$dir" "${detach[@]}" -c "$PWD" "${envs[@]}" -- "$self" "${child[@]}" || rc=$?
  else
    # A question is answered, then paged; quitting the pager closes the popup
    if [[ -n "$question" && "$INTERACTIVE" -eq 1 ]]; then child+=(-i); fi
    if [[ -n "$question" && "$INTERACTIVE" -eq 0 ]]; then envs+=(-e "_CLAUDE_ASK_PAGE_AFTER=1"); fi
    size="${CLAUDE_ASK_POPUP_SIZE:-80%}"
    w="${size%%x*}"
    h="${size#*x}"
    # display-popup -E waits for the run in the popup and returns its exit
    # status, so a failed answer is not tmux failing: the run deletes the
    # environment file as it starts, and then its status is passed on as it is
    debug_log "tmux popup: $w x $h ${child[*]}"
    tmux display-popup -E -w "$w" -h "$h" -d "$PWD" "${envs[@]}" -- "$self" "${child[@]}" || rc=$?
    if ((rc != 0)) && [[ ! -e "$envfile" ]]; then return "$rc"; fi
  fi
  if ((rc != 0)); then
    rm -f "$envfile"
    if [[ -n "$qfile" ]]; then rm -f "$qfile"; fi
    echo "claude-ask: tmux could not start the $TMUX_MODE (status $rc)" >&2
    return 1
  fi
}

# Continue a saved session, --resume=ID|N's or the newest: load it into the
# CONV_* state and show where it left off (a header and the last turn)
resume_session() {
  local file fields=() total="" header rc=0
  if [[ -n "$RESUME_ARG" ]]; then
    find_session "$RESUME_ARG" || rc=$?
    if ((rc == 1)); then
      echo "claude-ask: no session $RESUME_ARG (--history lists them)" >&2
    fi
    if ((rc != 0)); then return 1; fi
    file="$FOUND_SESSION"
  else
    file=$(newest_session_file)
    if [[ -z "$file" ]]; then
      echo "claude-ask: no saved session to resume" >&2
      return 1
    fi
  fi

  session_file_ok "$file" || return 1
  mapfile -d '' -t fields < <(jq -j "${SESSION_TURNS_JQ}"'
    (turns_of | last) as $last
    | [(.session_id // ""), (turns_of | length), (.cost_usd // ""), (.cwd // ""),
       ($last.effort // ""), ($last.model_option // ""), ($last.answer // ""),
       ($last.model // .model // "")]
    | map(tostring | clean + "\u0000") | add' "$file")
  if [[ -z "${fields[0]:-}" ]]; then
    echo "claude-ask: $(basename "$file" .json) has no session id and cannot be resumed" >&2
    return 1
  fi
  CONV_FILE="$file"
  CONV_SESSION_ID="${fields[0]}"
  CONV_TURNS="${fields[1]:-1}"
  CONV_COST="${fields[2]:-}"
  # -e, -m and the environment win over what the session was last asked with
  if [[ -z "$EFFORT" ]]; then EFFORT="${fields[4]:-}"; fi
  LAST_ANSWER="${fields[6]:-}"
  if [[ -n "${fields[7]:-}" ]]; then LAST_MODEL=$(short_model_name "${fields[7]}"); fi
  LAST_MODEL_FOR="${fields[5]:-}"
  if [[ -z "$MODEL" && -n "${fields[5]:-}" ]]; then
    MODEL="${fields[5]}"
    MODEL_RESTORED=1
  fi
  debug_log "resuming $file: session_id=$CONV_SESSION_ID turns=$CONV_TURNS effort=${EFFORT:-default} model=${MODEL:-default}"

  format_cost total "$CONV_COST"
  header="resuming $(basename "$file" .json) (${CONV_TURNS} turn"
  if ((CONV_TURNS != 1)); then header+="s"; fi
  header+="${total:+, $total}"
  header+=")${fields[3]:+ from ${fields[3]}}"
  printf '%s%s%s\n\n' "$FG_DIM" "$header" "$RST" >&"$BAR_FD"
  # stdout not a terminal: it is for the new answer, not the old one
  if ((OUT_TTY)); then show_turns "$file" last; fi
}

# Open $EDITOR for a multi-line question; sets COMPOSED, returns 1 if empty
compose_in_editor() {
  local f="$RUN_DIR/question.md"
  COMPOSED=""
  : > "$f"
  # As git does: the variable can hold arguments ("code --wait")
  bash -c "${VISUAL:-${EDITOR:-vi}} \"\$1\"" editor "$f" || return 1
  COMPOSED=$(< "$f")
  [[ "$COMPOSED" =~ [^[:space:]] ]]
}

# A dim note at the chat prompt
chat_note() {
  printf '%s%s%s\n' "$FG_DIM" "$*" "$RST" >&"$BAR_FD"
}

chat_help() {
  chat_note "/help              this list
/effort [LEVEL]    show or set the effort: $EFFORT_LEVELS, or default
/model [NAME]      show or set the model (opus, sonnet, haiku, fable, a full
                   name), or default
/theme [NAME]      show or set the status bar theme: minimal, bubbles, powerline
/yank [code [N]]   copy the last answer, its code blocks, or only block N
/status            the conversation, model, effort and theme
/new               start a new conversation
/editor, \\e        compose the question in \$EDITOR
/exit, /quit       end the chat (also exit, quit, Ctrl-D)
Tab completes a command and its argument. Effort and model apply from the
next question on."
}

chat_status() {
  local total="" conv="new conversation"
  if [[ -n "$CONV_FILE" ]]; then
    format_cost total "$CONV_COST"
    conv="$(basename "$CONV_FILE" .json) ($CONV_TURNS turn"
    if ((CONV_TURNS != 1)); then conv+="s"; fi
    conv+="${total:+, $total})"
  fi
  chat_note "session: $conv
model:   ${MODEL:-default}${model:+ (last answer: $model)}
effort:  ${EFFORT:-default}
theme:   $THEME"
}

# chat_command LINE: run a slash command typed at the chat prompt. Returns 0
# when LINE was a command, 1 when it is a question (not a "/word" first, so
# "/etc/hosts: what is this?" is still asked), 2 for /exit and /quit.
chat_command() {
  local cmd="${1%%[[:space:]]*}" arg=""
  [[ "$cmd" =~ ^/[a-z]+$ ]] || return 1
  arg="${1#"$cmd"}"
  arg="${arg#"${arg%%[![:space:]]*}"}"
  case "$cmd" in
    /help) chat_help ;;
    /exit | /quit) return 2 ;;
    /effort)
      if [[ -z "$arg" ]]; then
        chat_note "effort: ${EFFORT:-default}"
      elif [[ "$arg" == default ]]; then
        EFFORT=""
        chat_note "effort: default"
      elif [[ "$arg" =~ $EFFORT_RE ]]; then
        EFFORT="$arg"
        chat_note "effort: $EFFORT"
      else
        echo "claude-ask: effort must be one of: $EFFORT_LEVELS, or default" >&2
      fi
      ;;
    /model)
      if [[ -z "$arg" ]]; then
        chat_note "model: ${MODEL:-default}${model:+ (last answer: $model)}"
      elif [[ "$arg" =~ [[:space:]] ]]; then
        echo "claude-ask: a model name has no spaces" >&2
      elif [[ "$arg" == default ]]; then
        MODEL=""
        MODEL_RESTORED=0
        chat_note "model: default"
      else
        MODEL="$arg"
        MODEL_RESTORED=0
        chat_note "model: $MODEL"
      fi
      ;;
    /theme)
      if [[ -z "$arg" ]]; then
        chat_note "theme: $THEME"
      elif [[ "$arg" =~ ^(minimal|bubbles|powerline)$ ]]; then
        THEME="$arg"
        chat_note "theme: $THEME"
      else
        echo "claude-ask: theme must be one of: minimal, bubbles, powerline" >&2
      fi
      ;;
    /yank)
      if [[ -z "$arg" ]]; then
        yank_answer "$LAST_ANSWER" answer || true
      elif [[ "$arg" =~ ^code([[:space:]]+([1-9][0-9]*))?$ ]]; then
        yank_answer "$LAST_ANSWER" code "${BASH_REMATCH[2]}" || true
      else
        echo "claude-ask: /yank takes nothing, code, or code N" >&2
      fi
      ;;
    /status) chat_status ;;
    /new)
      CONV_FILE=""
      CONV_SESSION_ID=""
      CONV_TURNS=0
      CONV_COST=""
      CONV_INFO=""
      LAST_ANSWER=""
      chat_note "new conversation"
      ;;
    *) echo "claude-ask: unknown command $cmd (/help lists them)" >&2 ;;
  esac
  return 0
}

# The chat prompt's readline settings, in a file INPUTRC points at: the
# user's own (INPUTRC, ~/.inputrc or /etc/inputrc) and then two of ours.
# Bracketed paste is off: with it on, read -e keeps the first line of a
# multi-line paste and drops the rest, while without it each pasted line is
# read on its own and chat_loop gathers them into one question. Tab inserts
# a tab, so one in pasted code is not taken for file name completion; at a
# terminal chat_loop then binds it to chat_tab instead.
chat_inputrc() {
  local f="$RUN_DIR/inputrc" own="${INPUTRC:-$HOME/.inputrc}"
  if [[ ! -r "$own" ]]; then own=/etc/inputrc; fi
  {
    # shellcheck disable=SC2016 # $include is readline's, not a variable
    if [[ -r "$own" ]]; then printf '$include %s\n' "$own"; fi
    printf '%s\n' 'set enable-bracketed-paste off' '"\t": tab-insert'
  } > "$f"
  INPUTRC="$f"
}

# Tab at the chat prompt, bound with bind -x: chat_complete on readline's
# line, the matches listed (dim) when it cannot go further. At the ". "
# lines of a paste (CHAT_TAB_LITERAL) it only inserts a tab. bash clears
# the prompt line before running it and redraws it after, so the list
# takes that line.
CHAT_TAB_LITERAL=0
# shellcheck disable=SC2317 # called by readline (bind -x)
chat_tab() {
  # It runs inside chat_loop's "IFS= read", so IFS is empty here
  local IFS=$' \t\n'
  if ((CHAT_TAB_LITERAL)); then
    READLINE_LINE="${READLINE_LINE:0:READLINE_POINT}"$'\t'"${READLINE_LINE:READLINE_POINT}"
    READLINE_POINT=$((READLINE_POINT + 1))
    return 0
  fi
  chat_complete "$READLINE_LINE" "$READLINE_POINT"
  READLINE_LINE="$COMPLETE_LINE"
  READLINE_POINT="$COMPLETE_POINT"
  if ((${#COMPLETE_LIST[@]})); then
    printf '%s%s%s\n' "$FG_DIM" "${COMPLETE_LIST[*]}" "$RST" >&2
  fi
}

# Ctrl-C at the chat prompt, bound with bind -x: the line so far is shown
# with ^C after it and cleared, as a shell does, and the prompt starts again
# at once. The prompt reads with the terminal's intr key undefined
# (chat_read), so Ctrl-C reaches readline as a key: a trapped SIGINT does
# not end read -e, which kept reading until Enter.
CHAT_PROMPT_SHOWN=""
# shellcheck disable=SC2317 # called by readline (bind -x)
chat_ctrl_c() {
  printf '%s%s^C\n' "$CHAT_PROMPT_SHOWN" "$READLINE_LINE" >&2
  READLINE_LINE=""
  READLINE_POINT=0
}

# Bind Tab to chat_tab and Ctrl-C to chat_ctrl_c (at a terminal only), and
# keep the terminal settings in CHAT_STTY for chat_read to restore. bind
# needs line editing, which a script does not have until set -o emacs; the
# inputrc's editing-mode still wins, so vi users keep vi mode (the keys are
# bound in the vi keymaps too).
CHAT_STTY=""
chat_bind_keys() {
  [[ -t 0 ]] || return 0
  set -o emacs
  bind -x '"\t": chat_tab' 2> /dev/null || true
  bind -m vi-insert -x '"\t": chat_tab' 2> /dev/null || true
  local map
  for map in emacs vi-insert vi-command; do
    bind -m "$map" -x '"\C-c": chat_ctrl_c' 2> /dev/null || true
  done
  CHAT_STTY=$(stty -g 2> /dev/null) || CHAT_STTY=""
}

# chat_read VAR PROMPT: read a line at the chat prompt into VAR. At a
# terminal the intr key is undefined for the read (Ctrl-C is chat_ctrl_c's
# key there) and put back after it, so Ctrl-C still stops an answer.
chat_read() {
  local _rc=0
  CHAT_PROMPT_SHOWN="${2//[$'\001\002']/}"
  if [[ -n "$CHAT_STTY" ]]; then stty intr undef 2> /dev/null || true; fi
  IFS= read -r -e -p "$2" "$1" || _rc=$?
  if [[ -n "$CHAT_STTY" ]]; then stty "$CHAT_STTY" 2> /dev/null || true; fi
  return "$_rc"
}

# OUT: the chat prompt, "opus 5.5 · high > ", with what is known in front,
# dim: the model of the last answer when it was asked with the current -m or
# /model (or both are the default), else the model asked for; the effort
# when one is set. Before anything is known it is just "> ".
chat_prompt() {
  local _out="$1" _m="" _label="" _p=""
  if [[ -n "$LAST_MODEL" && "$MODEL" == "$LAST_MODEL_FOR" ]]; then
    _m="$LAST_MODEL"
  elif [[ -n "$MODEL" ]]; then
    _m=$(short_model_name "$MODEL")
  fi
  _label="$_m"
  if [[ -n "$EFFORT" ]]; then _label+="${_label:+ · }$EFFORT"; fi
  # \001 and \002 tell readline the color codes take no width
  if [[ -n "$_label" ]]; then _p=$'\001'"${FG_DIM}"$'\002'"$_label "; fi
  _p+=$'\001'"${FG_CLAUDE}"$'\002''> '$'\001'"${RST}"$'\002'
  printf -v "$_out" '%s' "$_p"
}

# Whether more of a paste is waiting: at once, or after a moment, since over
# ssh or from tmux a paste can arrive in pieces. Nobody types the next line
# that fast. The terminal does not echo in that moment, or a piece arriving
# in it would show twice.
chat_more_pasted() {
  read -r -t 0 && return 0
  if [[ -n "$CHAT_STTY" ]]; then stty -echo 2> /dev/null || true; fi
  sleep 0.1
  if [[ -n "$CHAT_STTY" ]]; then stty "$CHAT_STTY" 2> /dev/null || true; fi
  read -r -t 0
}

CHAT_NEWLINE_MARK="⏎"

# The chat: read questions at a "> " prompt and ask each one in the same
# conversation. Ctrl-D, exit or quit ends it; \e opens the editor; lines
# starting with a /command go to chat_command.
chat_loop() {
  local line rc eof=0 trimmed prompt more pasted
  local cont=$'\001'"${FG_DIM}"$'\002''. '$'\001'"${RST}"$'\002'
  chat_inputrc
  chat_bind_keys

  mkdir -p "$STATE_DIR"
  HISTFILE="$CHAT_HISTORY_FILE"
  HISTSIZE=1000
  HISTFILESIZE=1000
  set -o history
  if [[ -f "$HISTFILE" ]]; then history -r; fi

  chat_note "/help for commands"
  while ((!eof)); do
    line=""
    rc=0
    TURN_INTERRUPTED=0
    chat_prompt prompt
    chat_read line "$prompt" || rc=$?
    if ((rc > 128 || TURN_INTERRUPTED)); then
      # A SIGINT at the prompt (chat_ctrl_c handles Ctrl-C): drop the line
      printf '\n'
      continue
    fi
    if ((rc != 0)); then
      # End of input (Ctrl-D, or the last piped line without a newline)
      eof=1
      if [[ -z "$line" ]]; then
        if [[ -t 0 ]]; then printf '\n'; fi
        break
      fi
    fi

    # The lines of a paste arrive at once, so any already waiting belong to
    # the same question (each shows at a ". " prompt). Only at a terminal:
    # piped chat input is one question per line.
    pasted=0
    if ((rc == 0)) && [[ -t 0 ]]; then
      CHAT_TAB_LITERAL=1
      while chat_more_pasted; do
        more=""
        chat_read more "$cont" || break
        line+=$'\n'"$more"
        pasted=1
      done
      CHAT_TAB_LITERAL=0
    fi

    trimmed="${line#"${line%%[![:space:]]*}"}"
    trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
    if [[ -z "$trimmed" ]]; then continue; fi
    # A multi-line question recalled from the history: read -e stops at a
    # newline, so history holds it on one line, with this mark for each
    if [[ "$line" == *"$CHAT_NEWLINE_MARK"* ]]; then
      line="${line//"$CHAT_NEWLINE_MARK"/$'\n'}"
      pasted=1
    fi
    # A paste is a question, even one that starts with /word or exit
    if ((pasted)); then trimmed=""; fi
    case "$trimmed" in
      "") ;;
      exit | quit) break ;;
      '\e' | /editor)
        compose_in_editor || continue
        line="$COMPOSED"
        printf '%s%s%s\n' "$FG_DIM" "$line" "$RST"
        ;;
      /*)
        rc=0
        chat_command "$trimmed" || rc=$?
        if ((rc == 2)); then break; fi
        if ((rc == 0)); then
          history -s "$trimmed"
          history -a 2> /dev/null || true
          continue
        fi
        ;;
    esac

    history -s "${line//$'\n'/$CHAT_NEWLINE_MARK}"
    history -a 2> /dev/null || true

    rc=0
    ask_once "$line" || rc=$?
    if ((rc != 130)); then LAST_TURN_STATUS=$rc; fi
    printf '\n' >&"$BAR_FD"
  done
  # Or bash goes on recording the rest of this script as it reads it
  set +o history
}

# ---------------------------------------------------------------------------
# Ask claude: an optional resume, the question, then the chat
# ---------------------------------------------------------------------------
if [[ -n "$TMUX_MODE" ]]; then
  launch_in_tmux
  exit
fi

require_cmds "$CLAUDE_BIN"
# Private when created here; the default directory is tightened if it exists,
# one the user chose is left as it is
(
  umask 077
  mkdir -p "$SESSION_DIR"
)
if [[ -z "$SESSION_DIR_CHOSEN" ]]; then chmod 700 "$SESSION_DIR"; fi

RAW_JSON="$RUN_DIR/stream.jsonl"
CLAUDE_STDERR="$RUN_DIR/claude.stderr"

if [[ "$RESUME" -eq 1 ]]; then
  resume_session || exit 1
  printf '\n' >&"$BAR_FD"
fi

if [[ -n "$question" ]]; then
  ask_once "$question" || LAST_TURN_STATUS=$?
  if [[ -n "${_CLAUDE_ASK_PAGE_AFTER:-}" && "$INTERACTIVE" -eq 0 ]]; then
    page_answer_in_popup "$((LAST_TURN_STATUS != 0))"
  fi
fi

if [[ "$INTERACTIVE" -eq 1 ]]; then
  if [[ -n "$question" ]]; then printf '\n'; fi
  chat_loop
fi

if [[ "$LAST_TURN_STATUS" -ne 0 ]]; then
  exit 1
fi
exit 0
