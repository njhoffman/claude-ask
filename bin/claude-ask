#!/bin/bash
#
# claude-ask - Ask Claude a question from the terminal with a styled status bar
#
# Usage: claude-ask [OPTIONS] ["question"]
#
# Options:
#   --theme THEME      Status bar theme: minimal, bubbles, powerline (default: minimal)
#   --pager CMD        Pager command for markdown output, run with bash -c (default: nvimpager)
#   --no-pager         Disable pager, output raw text
#   --demo-themes       Show example status bars for all themes and exit
#   --demo-output       Simulate streaming with mock responses (small/medium/large) and exit
#   --no-stream        Don't stream output; show status bar only, render markdown when complete
#   --save-raw         Also save the raw JSON stream, as NAME.jsonl beside NAME.json
#   --history          List saved sessions
#   --session [ID|N]   View a saved session by name/id or index number
#   --debug-log[=FILE] Write debug messages to FILE
#                      (default: ${XDG_STATE_HOME:-~/.local/state}/claude-ask/debug.log)
#   --version          Print the version and exit
#   -h, --help         Show this help message
#
# Examples:
#   claude-ask                                    # opens $EDITOR to compose question
#   claude-ask "What is the capital of France?"
#   claude-ask --theme powerline "Explain git rebase"
#   claude-ask --demo-themes
#   claude-ask --no-pager "List common bash shortcuts"
#   claude-ask --history                          # list saved sessions
#   claude-ask --session 1                        # view most recent session
#   claude-ask --session git-bare                 # view session by name
#   claude-ask --debug-log "What is 2+2?"         # enable debug logging
#
# Environment:
#   SESSION_DIR        Where sessions are saved (default: ~/.local/share/claude/cli-sessions)
#   CLAUDE_ASK_BIN     The claude command to run (default: claude)
#   CLAUDE_ASK_DEMO_DELAY  Seconds between demo frames (default: 0.08 themes, 0.03 output)

set -euo pipefail

# Numbers are formatted with "." whatever the user's locale (bc prints "."
# and printf would reject it under a comma-decimal LC_NUMERIC). LC_ALL would
# override LC_NUMERIC, so it moves to LANG, keeping the character encoding.
if [[ -n "${LC_ALL:-}" ]]; then
  export LANG="$LC_ALL"
  unset LC_ALL
fi
export LC_NUMERIC=C

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------
THEME="minimal"
# PAGER_CMD="bat --color=always -l markdown --paging=never --wrap=auto"
PAGER_CMD='command nvimpager -c -- -c "colorscheme nord-nick | set termguicolors | set ft=markdown"'
USE_PAGER=1
STREAM_OUTPUT=1
SAVE_RAW=0
DEMO_THEMES=0
DEMO_OUTPUT=0
SHOW_HISTORY=0
VIEW_SESSION=""
DEBUG_LOG=""
DEFAULT_DEBUG_LOG="${XDG_STATE_HOME:-$HOME/.local/state}/claude-ask/debug.log"
MAX_DISPLAY_NAME=20
SESSION_DIR="${SESSION_DIR:-$HOME/.local/share/claude/cli-sessions}"
CLAUDE_BIN="${CLAUDE_ASK_BIN:-claude}"

# ---------------------------------------------------------------------------
# Debug logging (must be defined before arg parsing)
# ---------------------------------------------------------------------------
debug_log() {
  [[ -z "${DEBUG_LOG:-}" ]] && return
  local now="$EPOCHREALTIME" # seconds.microseconds, no date(1) needed
  local frac="${now#*[.,]}"
  printf '[%(%H:%M:%S)T.%s] %s\n' "${now%[.,]*}" "${frac:0:3}" "$*" >> "$DEBUG_LOG"
}

# ---------------------------------------------------------------------------
# CLI argument parsing
# ---------------------------------------------------------------------------
# Print the version from the VERSION file next to bin/ (the script is
# usually installed as a symlink into the repo, so resolve it first)
print_version() {
  local root version="unknown"
  root="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.."
  if [[ -r "$root/VERSION" ]]; then
    version=$(< "$root/VERSION")
  fi
  printf 'claude-ask %s\n' "$version"
}

usage() {
  sed -n '2,/^$/s/^# \{0,1\}//p' "$0"
  exit 0
}

POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --theme)
      [[ $# -lt 2 ]] && {
        echo "Error: --theme requires an argument" >&2
        exit 1
      }
      THEME="$2"
      if [[ ! "$THEME" =~ ^(minimal|bubbles|powerline)$ ]]; then
        echo "Error: --theme must be one of: minimal, bubbles, powerline" >&2
        exit 1
      fi
      shift 2
      ;;
    --pager)
      [[ $# -lt 2 ]] && {
        echo "Error: --pager requires an argument" >&2
        exit 1
      }
      PAGER_CMD="$2"
      shift 2
      ;;
    --no-pager)
      USE_PAGER=0
      shift
      ;;
    --demo-themes)
      DEMO_THEMES=1
      shift
      ;;
    --demo-output)
      DEMO_OUTPUT=1
      shift
      ;;
    --no-stream)
      STREAM_OUTPUT=0
      shift
      ;;
    --save-raw)
      SAVE_RAW=1
      shift
      ;;
    --history)
      SHOW_HISTORY=1
      shift
      ;;
    --session)
      if [[ $# -ge 2 && ! "$2" =~ ^- ]]; then
        VIEW_SESSION="$2"
        shift 2
      else
        VIEW_SESSION="__SHOW_HISTORY__"
        shift
      fi
      ;;
    --debug-log)
      DEBUG_LOG="$DEFAULT_DEBUG_LOG"
      shift
      ;;
    --debug-log=*)
      DEBUG_LOG="${1#--debug-log=}"
      if [[ -z "$DEBUG_LOG" ]]; then
        echo "Error: --debug-log= requires a file name" >&2
        exit 1
      fi
      shift
      ;;
    --version)
      print_version
      exit 0
      ;;
    -h | --help)
      usage
      ;;
    --)
      shift
      POSITIONAL+=("$@")
      break
      ;;
    -*)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

if [[ -n "$DEBUG_LOG" ]]; then
  mkdir -p "$(dirname "$DEBUG_LOG")"
fi

# Fail early, with a clear message, when a required command is missing
require_cmds() {
  local cmd missing=()
  for cmd in "$@"; do
    command -v "$cmd" > /dev/null 2>&1 || missing+=("$cmd")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "claude-ask: required command not found: ${missing[*]}" >&2
    exit 127
  fi
}
require_cmds jq bc

debug_log "args parsed: THEME=$THEME USE_PAGER=$USE_PAGER SAVE_RAW=$SAVE_RAW SHOW_HISTORY=$SHOW_HISTORY VIEW_SESSION=$VIEW_SESSION"

if [[ "$DEMO_THEMES" -eq 0 && "$DEMO_OUTPUT" -eq 0 && "$SHOW_HISTORY" -eq 0 && -z "$VIEW_SESSION" && ${#POSITIONAL[@]} -eq 0 ]]; then
  # No question provided -- open $EDITOR for interactive input
  debug_log "no positional args, opening editor"
  tmpfile="$(mktemp "${TMPDIR:-/tmp}/claude-ask-XXXXXX")"
  "${EDITOR:-vi}" "$tmpfile"
  question="$(cat "$tmpfile")"
  rm -f "$tmpfile"
  debug_log "editor returned, question_len=${#question}"
  if [[ ! "$question" =~ [^[:space:]] ]]; then
    echo "No question provided." >&2
    exit 1
  fi
else
  question="${POSITIONAL[*]:-}"
fi

# ---------------------------------------------------------------------------
# Catppuccin Mocha palette -> ANSI 256/truecolor escape sequences
# Using truecolor (24-bit) since modern terminals support it
# ---------------------------------------------------------------------------
# Foreground: \e[38;2;R;G;Bm   Background: \e[48;2;R;G;Bm
RST=$'\e[0m'
BOLD=$'\e[1m'

# Palette colors (catppuccin mocha)
FG_CLAUDE=$'\e[38;2;217;119;87m' # #D97757
BG_CLAUDE=$'\e[48;2;49;50;68m'   # #313244

FG_MODEL=$'\e[38;2;116;199;236m' # #74c7ec

FG_COST=$'\e[38;2;166;227;161m' # #a6e3a1
BG_COST=$'\e[48;2;69;71;90m'    # #45475a

FG_TOKENS=$'\e[38;2;137;220;235m' # #89dceb (directory color reused)
BG_TOKENS=$'\e[48;2;30;30;46m'    # #1e1e2e

FG_DURATION=$'\e[38;2;235;160;172m' # #eba0ac (git_branch color reused)
BG_DURATION=$'\e[48;2;49;50;68m'    # #313244

FG_DIM=$'\e[38;2;108;112;134m' # #6c7086 overlay0

# Separator characters for themed transitions
# Bubbles: round caps    Powerline: angular arrows
SEP_BUBBLE_LEFT=$'\ue0b6'  #
SEP_BUBBLE_RIGHT=$'\ue0b4' #
SEP_POWERLINE=$'\ue0b0'    #

# Spinner frames
SPINNER=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")

# ---------------------------------------------------------------------------
# Theme renderers
# Each takes: spinner_char model tokens_in tokens_out cost duration status
# ---------------------------------------------------------------------------
render_minimal() {
  local spin="$1" model="$2" tok_in="$3" tok_out="$4" cost="$5" dur="$6" status="$7"
  local line=""
  line+="${FG_CLAUDE}${spin}${RST} "
  line+="${FG_MODEL}${model}${RST}"
  if [[ -n "$tok_in" ]]; then
    line+=" ${FG_DIM}|${RST} ${FG_TOKENS}in:${tok_in}${RST}"
  fi
  if [[ -n "$tok_out" ]]; then
    line+=" ${FG_TOKENS}out:${tok_out}${RST}"
  fi
  if [[ -n "$cost" ]]; then
    line+=" ${FG_DIM}|${RST} ${FG_COST}${cost}${RST}"
  fi
  if [[ -n "$dur" ]]; then
    line+=" ${FG_DIM}|${RST} ${FG_DURATION}${dur}${RST}"
  fi
  if [[ "$status" == "done" ]]; then
    line+=" ${FG_DIM}|${RST} ${FG_COST}done${RST}"
  fi
  printf '%s' "$line"
}

render_bubbles() {
  local spin="$1" model="$2" tok_in="$3" tok_out="$4" cost="$5" dur="$6" status="$7"
  local line=""

  # Claude bubble (spinner + model)
  line+="${FG_CLAUDE}${SEP_BUBBLE_LEFT}${BG_CLAUDE} ${FG_CLAUDE}${spin} ${FG_MODEL}${model} ${RST}${FG_CLAUDE}${SEP_BUBBLE_RIGHT}${RST}"

  # Tokens bubble
  if [[ -n "$tok_in" || -n "$tok_out" ]]; then
    local tok_str=""
    [[ -n "$tok_in" ]] && tok_str+="in:${tok_in}"
    [[ -n "$tok_out" ]] && tok_str+=" out:${tok_out}"
    line+=" ${FG_TOKENS}${SEP_BUBBLE_LEFT}${BG_TOKENS} ${FG_TOKENS}${tok_str} ${RST}${FG_TOKENS}${SEP_BUBBLE_RIGHT}${RST}"
  fi

  # Cost bubble
  if [[ -n "$cost" ]]; then
    line+=" ${FG_COST}${SEP_BUBBLE_LEFT}${BG_COST} ${FG_COST}${cost} ${RST}${FG_COST}${SEP_BUBBLE_RIGHT}${RST}"
  fi

  # Duration bubble
  if [[ -n "$dur" ]]; then
    line+=" ${FG_DURATION}${SEP_BUBBLE_LEFT}${BG_DURATION} ${FG_DURATION}${dur} ${RST}${FG_DURATION}${SEP_BUBBLE_RIGHT}${RST}"
  fi

  # Status indicator
  if [[ "$status" == "done" ]]; then
    line+=" ${FG_COST}${SEP_BUBBLE_LEFT}${BG_COST} ${FG_COST}done ${RST}${FG_COST}${SEP_BUBBLE_RIGHT}${RST}"
  fi

  printf '%s' "$line"
}

render_powerline() {
  local spin="$1" model="$2" tok_in="$3" tok_out="$4" cost="$5" dur="$6" status="$7"
  local line=""
  # Each separator arrow takes the color of the segment before it
  local prev_fg="${FG_CLAUDE}"

  # Decorative start + claude segment
  line+="${FG_CLAUDE}░▒▓${BG_CLAUDE} ${FG_CLAUDE}${spin} ${FG_MODEL}${model} ${RST}"

  # Tokens segment
  if [[ -n "$tok_in" || -n "$tok_out" ]]; then
    local tok_str=""
    [[ -n "$tok_in" ]] && tok_str+="in:${tok_in}"
    [[ -n "$tok_out" ]] && tok_str+=" out:${tok_out}"
    line+="${BG_TOKENS}${prev_fg}${SEP_POWERLINE}${RST}${BG_TOKENS} ${FG_TOKENS}${tok_str} ${RST}"
    prev_fg="${FG_TOKENS}"
  fi

  # Cost segment
  if [[ -n "$cost" ]]; then
    line+="${BG_COST}${prev_fg}${SEP_POWERLINE}${RST}${BG_COST} ${FG_COST}${cost} ${RST}"
    prev_fg="${FG_COST}"
  fi

  # Duration segment
  if [[ -n "$dur" ]]; then
    line+="${BG_DURATION}${prev_fg}${SEP_POWERLINE}${RST}${BG_DURATION} ${FG_DURATION}${dur} ${RST}"
    prev_fg="${FG_DURATION}"
  fi

  # Status / end cap
  if [[ "$status" == "done" ]]; then
    line+="${BG_COST}${prev_fg}${SEP_POWERLINE}${RST}${BG_COST} ${FG_COST}done ${RST}${FG_COST}${SEP_POWERLINE}${RST}"
  else
    line+="${prev_fg}${SEP_POWERLINE}${RST}"
  fi

  printf '%s' "$line"
}

render_status_bar() {
  case "$THEME" in
    minimal) render_minimal "$@" ;;
    bubbles) render_bubbles "$@" ;;
    powerline) render_powerline "$@" ;;
  esac
}

# ---------------------------------------------------------------------------
# Format helpers
# ---------------------------------------------------------------------------
format_tokens() {
  local n="$1"
  if [[ -z "$n" || "$n" == "0" ]]; then
    echo ""
    return
  fi
  if [[ "$n" -ge 1000000 ]]; then
    printf '%.1fM' "$(echo "scale=1; $n / 1000000" | bc)"
  elif [[ "$n" -ge 1000 ]]; then
    printf '%.1fk' "$(echo "scale=1; $n / 1000" | bc)"
  else
    echo "$n"
  fi
}

format_duration() {
  local ms="$1"
  if [[ -z "$ms" ]]; then
    echo ""
    return
  fi
  if [[ "$ms" -ge 60000 ]]; then
    printf '%dm%ds' "$((ms / 60000))" "$(((ms % 60000) / 1000))"
  elif [[ "$ms" -ge 1000 ]]; then
    printf '%.1fs' "$(echo "scale=1; $ms / 1000" | bc)"
  else
    printf '%dms' "$ms"
  fi
}

format_cost() {
  local c="$1"
  if [[ -z "$c" ]]; then
    echo ""
    return
  fi
  printf '$%.4f' "$c"
}

format_count() {
  local n="$1"
  [[ -z "$n" ]] && n=0
  if [[ "$n" -ge 1000000 ]]; then
    printf '%.1fM' "$(echo "scale=1; $n / 1000000" | bc)"
  elif [[ "$n" -ge 1000 ]]; then
    printf '%.1fk' "$(echo "scale=1; $n / 1000" | bc)"
  else
    echo "$n"
  fi
}

format_elapsed() {
  local secs="$1"
  [[ -z "$secs" || "$secs" -le 0 ]] && {
    echo "0s"
    return
  }
  if [[ "$secs" -ge 3600 ]]; then
    printf '%dh%dm' "$((secs / 3600))" "$(((secs % 3600) / 60))"
  elif [[ "$secs" -ge 60 ]]; then
    printf '%dm%ds' "$((secs / 60))" "$((secs % 60))"
  else
    printf '%ds' "$secs"
  fi
}

render_stream_info() {
  local lines="$1" chars="$2" chunks="$3" elapsed="$4" is_done="$5" is_thinking="${6:-0}"
  local info="  ${FG_DIM}"
  if [[ "$is_thinking" -eq 1 && "$is_done" != "done" ]]; then
    info+="thinking... ${FG_DIM}|${RST}${FG_DIM} "
  fi
  info+="${lines} lines ${FG_DIM}|${RST}${FG_DIM} "
  info+="$(format_count "$chars") chars ${FG_DIM}|${RST}${FG_DIM} "
  info+="${chunks} chunks"
  if [[ "$is_done" != "done" && -n "$elapsed" ]]; then
    info+=" ${FG_DIM}|${RST}${FG_DIM} $(format_elapsed "$elapsed")"
  fi
  info+="${RST}"
  printf '%s' "$info"
}

# ---------------------------------------------------------------------------
# Stream parsing, shared by the main loop, --demo-output and the tests
# ---------------------------------------------------------------------------

# Shorten a model id such as "claude-opus-4-6[1m]" to "opus"
short_model_name() {
  local m="${1%%\[*}"
  case "${m,,}" in
    *haiku*) m="haiku" ;;
    *sonnet*) m="sonnet" ;;
    *opus*) m="opus" ;;
  esac
  printf '%s' "$m"
}

# Reset every variable process_stream_line writes
reset_stream_state() {
  model=""
  session_id=""
  spinner_idx=0
  input_tokens=""
  output_tokens=""
  cost=""
  duration_ms=""
  answer_text=""
  status="running" # running, done or error
  stream_error=""
  is_thinking=0
  answer_lines=0
  answer_chars=0
  text_chunks=0
  CHUNK=""
}

# One jq call per event. The fields come back NUL-terminated, so text may
# hold any character: type, model, session_id, text (every text block
# joined), has_thinking, input tokens, output tokens, cost, duration_ms,
# is_error, result text.
# shellcheck disable=SC2016 # $u is a jq variable
STREAM_FIELDS_JQ='
  (if .type == "result" then .usage else .message.usage end) as $u
  | [ .type, .model, .session_id,
      ([.message.content[]? | select(.type == "text") | .text] | join("")),
      (if any(.message.content[]?; .type == "thinking") then 1 else 0 end),
      $u.input_tokens, $u.output_tokens, .total_cost_usd, .duration_ms,
      (if .is_error == true then 1 else 0 end),
      (if .type == "result" then .result else null end) ]
  | map((. // "" | tostring) + "\u0000") | add'
STREAM_FIELD_COUNT=11

# Parse one stream-json line into the state variables. CHUNK is set to the
# answer text the line added (empty if none). Returns 1 for lines that change
# nothing on screen: blank, not JSON, no type, or a rate_limit_event.
process_stream_line() {
  local line="$1" f=()
  CHUNK=""
  [[ -n "$line" ]] || return 1
  mapfile -d '' -t f < <(printf '%s' "$line" | jq -j "$STREAM_FIELDS_JQ" 2> /dev/null)
  [[ ${#f[@]} -eq $STREAM_FIELD_COUNT && -n "${f[0]}" ]] || return 1

  case "${f[0]}" in
    system)
      if [[ -n "${f[1]}" ]]; then model=$(short_model_name "${f[1]}"); fi
      if [[ -n "${f[2]}" ]]; then session_id="${f[2]}"; fi
      ;;
    assistant)
      if [[ -n "${f[3]}" ]]; then
        is_thinking=0
        CHUNK="${f[3]}"
        answer_text+="$CHUNK"
        text_chunks=$((text_chunks + 1))
        answer_chars=$((answer_chars + ${#CHUNK}))
        local newlines="${CHUNK//[!$'\n']/}"
        answer_lines=$((answer_lines + ${#newlines}))
      elif [[ "${f[4]}" == 1 ]]; then
        is_thinking=1
      fi
      ;;
    result)
      status="done"
      if [[ -n "${f[7]}" ]]; then cost="${f[7]}"; fi
      if [[ -n "${f[8]}" ]]; then duration_ms="${f[8]}"; fi
      if [[ "${f[9]}" == 1 ]]; then
        status="error"
        stream_error="${f[10]:-claude reported an error}"
      fi
      ;;
    rate_limit_event)
      return 1
      ;;
  esac

  # Token counts: under .message for assistant events, top-level for result
  if [[ "${f[0]}" == assistant || "${f[0]}" == result ]]; then
    if [[ -n "${f[5]}" ]]; then input_tokens="${f[5]}"; fi
    if [[ -n "${f[6]}" ]]; then output_tokens="${f[6]}"; fi
  fi
  return 0
}

# Run the pager on stdin; bash -c so quotes inside PAGER_CMD are honored
run_pager() {
  bash -c "$PAGER_CMD"
}

# ---------------------------------------------------------------------------
# Session saving
# ---------------------------------------------------------------------------
# shellcheck disable=SC2016 # jq program
SESSION_JQ='
  (map(select(.type == "system")) | first) as $init
  | (map(select(.type == "result")) | last) as $res
  | {
      session_id: ($init.session_id // null),
      model: ($init.model // null),
      name: $name,
      question: $question,
      answer: ($res.result // null),
      is_error: ($res.is_error // false),
      thinking: ([.[] | select(.type == "assistant") | .message.content[]?
                  | select(.type == "thinking") | .thinking]
                 | if length > 0 then join("\n") else null end),
      cost_usd: ($res.total_cost_usd // null),
      duration_ms: ($res.duration_ms // null),
      duration_api_ms: ($res.duration_api_ms // null),
      usage: {
        input_tokens: ($res.usage.input_tokens // null),
        output_tokens: ($res.usage.output_tokens // null),
        cache_creation_input_tokens: ($res.usage.cache_creation_input_tokens // null),
        cache_read_input_tokens: ($res.usage.cache_read_input_tokens // null)
      },
      timestamp: (now | todate)
    }'

# Save a raw stream-json file as a session in SESSION_DIR, plus a copy of the
# raw stream as NAME.jsonl with --save-raw; prints the session file's path
save_session() {
  local raw="$1" question="$2" name file
  name=$(unique_session_name "$(slugify_question "$question")" "$SESSION_DIR")
  file="${SESSION_DIR}/${name}.json"
  debug_log "saving session: name=$name file=$file"
  # Lines that are not JSON objects are skipped rather than failing the save
  jq -nR --arg question "$question" --arg name "$name" \
    "[inputs | fromjson? | objects] | ${SESSION_JQ}" "$raw" > "$file"
  if [[ "$SAVE_RAW" -eq 1 ]]; then
    cp "$raw" "${SESSION_DIR}/${name}.jsonl"
  fi
  printf '%s\n' "$file"
}

# ---------------------------------------------------------------------------
# Theme demo mode: show all themes with sample data and exit
# ---------------------------------------------------------------------------
run_theme_demo() {
  local themes=("minimal" "bubbles" "powerline")
  local sample_model="opus"
  local sample_in="19.9k"
  local sample_out="275"
  local sample_cost="\$0.0950"
  local sample_dur="7.4s"

  for theme in "${themes[@]}"; do
    echo "${BOLD}${theme}${RST}"

    # In-progress state (with spinner)
    THEME="$theme"
    printf '  streaming: '
    local idx=0
    for _ in {1..10}; do
      local s="${SPINNER[$idx]}"
      printf '\r  streaming: '
      render_status_bar "$s" "$sample_model" "$sample_in" "$sample_out" "" "" "running"
      idx=$(((idx + 1) % ${#SPINNER[@]}))
      sleep "${CLAUDE_ASK_DEMO_DELAY:-0.08}"
    done
    printf '\n'

    # Finished state
    printf '  finished:  '
    render_status_bar "✓" "$sample_model" "$sample_in" "$sample_out" "$sample_cost" "$sample_dur" "done"
    printf '\n\n'
  done
}

if [[ "$DEMO_THEMES" -eq 1 ]]; then
  run_theme_demo
  exit 0
fi

# ---------------------------------------------------------------------------
# Mock stream-json data generator for demo-output mode
# Generates realistic stream-json events with configurable size and delay.
# Usage: generate_mock_stream SIZE [DELAY]
#   SIZE:  small, medium, large
#   DELAY: seconds between chunks (default: 0.05)
# ---------------------------------------------------------------------------
MOCK_SMALL_TEXT='The capital of France is **Paris**.'
MOCK_MEDIUM_TEXT='## The Capital of France

The capital of France is **Paris**. It is located in northern France on the River Seine.

### Key Facts

- **Population**: ~2.1 million (city proper), ~12 million (metro area)
- **Founded**: 3rd century BC (as Lutetia)
- **Area**: 105.4 km²

### Notable Landmarks

1. **Eiffel Tower** - Built in 1889, standing 330 meters tall
2. **Louvre Museum** - Home to the Mona Lisa and 380,000 objects
3. **Notre-Dame Cathedral** - Gothic masterpiece begun in 1163
4. **Arc de Triomphe** - Honors those who fought for France

### Code Example

```python
cities = {"France": "Paris", "Germany": "Berlin", "Spain": "Madrid"}
print(f"The capital is {cities['"'"'France'"'"']}")
```

Paris has been the capital since the 10th century and remains the political,
economic, and cultural center of France.'

# shellcheck disable=SC2016 # markdown sample text, not an expansion
MOCK_LARGE_TEXT='## Comprehensive Guide to France'\''s Capital

### Introduction

The capital of France is **Paris**, one of the most visited cities in the world.
Located in northern France on the River Seine, Paris has been the nation'\''s
capital since the Capetian dynasty established it in the 10th century.

### Geography and Climate

Paris sits in the **Ile-de-France** region at approximately 48.8566°N, 2.3522°E.
The city proper covers 105.4 km² and is divided into 20 arrondissements that
spiral outward from the center like a snail shell.

| Season | Avg High | Avg Low | Rainfall |
|--------|----------|---------|----------|
| Spring | 16°C     | 7°C     | 50mm     |
| Summer | 25°C     | 15°C    | 55mm     |
| Autumn | 16°C     | 8°C     | 55mm     |
| Winter | 7°C      | 2°C     | 50mm     |

### Historical Timeline

1. **3rd century BC** - Celtic Parisii tribe settles on Ile de la Cite
2. **52 BC** - Romans conquer and rename it Lutetia
3. **508 AD** - Clovis I makes Paris capital of the Frankish kingdom
4. **1163** - Construction of Notre-Dame Cathedral begins
5. **1789** - French Revolution begins with the storming of the Bastille
6. **1889** - Eiffel Tower built for the World'\''s Fair
7. **1900** - Paris Metro opens its first line
8. **1944** - Liberation of Paris from Nazi occupation
9. **2024** - Paris hosts the Summer Olympic Games

### Cultural Significance

Paris is often called the **"City of Light"** (La Ville Lumiere), a nickname that
dates back to the Age of Enlightenment and the city'\''s early adoption of street
lighting.

#### Museums and Galleries

- **Louvre Museum**: World'\''s largest art museum with 380,000+ objects
- **Musee d'\''Orsay**: Impressionist masterpieces in a former railway station
- **Centre Pompidou**: Modern and contemporary art
- **Rodin Museum**: Sculptures including The Thinker

#### Architecture Styles

```
Gothic       -> Notre-Dame, Sainte-Chapelle (12th-14th century)
Renaissance  -> Fontainebleau influence (16th century)
Baroque      -> Les Invalides, Val-de-Grace (17th century)
Haussmann    -> Boulevard redesign (19th century)
Art Nouveau  -> Metro entrances, department stores (early 20th)
Modern       -> La Defense, Fondation Louis Vuitton (20th-21st)
```

### Transportation

The Paris Metro system has **16 lines** and **302 stations**, making it one of
the densest metro networks in the world. The RER commuter rail extends service
to the greater Ile-de-France region.

```bash
# Example: finding a route
metro_lines=("1:La Defense-Chateau de Vincennes"
             "4:Porte de Clignancourt-Mairie de Montrouge"
             "6:Charles de Gaulle Etoile-Nation"
             "14:Saint-Lazare-Olympiades")

for line in "${metro_lines[@]}"; do
  number="${line%%:*}"
  route="${line#*:}"
  echo "Line $number: $route"
done
```

### Economy

Paris and the Ile-de-France region generate approximately **31% of France'\''s GDP**.
Major industries include:

- Finance and banking (La Defense business district)
- Fashion and luxury goods (LVMH, Kering, Hermes)
- Technology (Station F startup campus)
- Tourism (~30 million international visitors annually)
- Aerospace (nearby facilities for Airbus, Safran)

### Summary

Paris continues to evolve while preserving its rich heritage. From the medieval
streets of the Marais to the modern towers of La Defense, the city bridges
centuries of history with contemporary innovation.'

generate_mock_stream() {
  local size="${1:-small}" delay="${2:-0.05}"
  local mock_text input_tokens output_tokens cost duration_ms
  local chunk_size=80

  case "$size" in
    small)
      mock_text="$MOCK_SMALL_TEXT"
      input_tokens=150
      output_tokens=20
      cost="0.001200"
      duration_ms=1200
      ;;
    medium)
      mock_text="$MOCK_MEDIUM_TEXT"
      input_tokens=500
      output_tokens=275
      cost="0.012345"
      duration_ms=4500
      ;;
    large)
      mock_text="$MOCK_LARGE_TEXT"
      input_tokens=1200
      output_tokens=850
      cost="0.045600"
      duration_ms=12000
      ;;
    *)
      echo "Error: --demo-output size must be small, medium, or large" >&2
      return 1
      ;;
  esac

  # System init
  printf '{"type":"system","subtype":"init","cwd":"/tmp","session_id":"demo-%s","model":"claude-opus-4-6[1m]"}\n' "$size"
  sleep "$delay"

  # Thinking event
  printf '{"type":"assistant","message":{"content":[{"type":"thinking","thinking":"Let me think about this question."}],"usage":{"input_tokens":%d,"output_tokens":0}},"session_id":"demo-%s"}\n' "$input_tokens" "$size"
  sleep "$delay"

  # Stream text in chunks
  local text_len=${#mock_text}
  local offset=0 running_out=0
  while [[ $offset -lt $text_len ]]; do
    local chunk="${mock_text:$offset:$chunk_size}"
    running_out=$((running_out + ${#chunk} / 4))
    # Escape the chunk for JSON: handle backslashes, quotes, newlines, tabs
    local json_chunk
    json_chunk=$(printf '%s' "$chunk" | jq -Rs '.')
    # jq -Rs wraps in quotes; strip outer quotes for embedding
    json_chunk="${json_chunk:1:${#json_chunk}-2}"
    printf '{"type":"assistant","message":{"content":[{"type":"text","text":"%s"}],"usage":{"input_tokens":%d,"output_tokens":%d}},"session_id":"demo-%s"}\n' \
      "$json_chunk" "$input_tokens" "$running_out" "$size"
    offset=$((offset + chunk_size))
    sleep "$delay"
  done

  # Result
  printf '{"type":"result","subtype":"success","is_error":false,"duration_ms":%d,"duration_api_ms":%d,"num_turns":1,"result":"","total_cost_usd":%s,"usage":{"input_tokens":%d,"output_tokens":%d}}\n' \
    "$duration_ms" "$((duration_ms - 100))" "$cost" "$input_tokens" "$output_tokens"
}

run_demo_output() {
  local sizes=("small" "medium" "large")
  local modes=() mode size line save_stream

  if [[ "$STREAM_OUTPUT" -eq 1 ]]; then
    modes+=("stream")
  fi
  modes+=("batch")

  for mode in "${modes[@]}"; do
    for size in "${sizes[@]}"; do
      printf '\n%s%s response (%s mode)%s\n' "$BOLD" "$size" "$mode" "$RST"
      printf '%s%s%s\n' "$FG_DIM" "$(printf '%.0s─' {1..50})" "$RST"

      save_stream="$STREAM_OUTPUT"
      if [[ "$mode" == "batch" ]]; then
        STREAM_OUTPUT=0
      else
        STREAM_OUTPUT=1
      fi

      # Feed mock data through the same pipeline the real CLI uses
      reset_stream_state
      CURSOR_COL=1
      STATUS_BAR_VISIBLE=0
      STREAM_START=$SECONDS

      if [[ "$USE_PAGER" -eq 1 && "$STREAM_OUTPUT" -eq 1 ]]; then
        start_pager_pipe
      fi

      update_status_bar "${SPINNER[0]}" "connecting..." "" "" "" "" "running"

      while IFS= read -r line; do
        process_stream_line "$line" || continue
        if [[ -n "$CHUNK" && "$STREAM_OUTPUT" -eq 1 ]]; then
          write_chunk "$CHUNK"
        fi
        refresh_status_bar
      done < <(generate_mock_stream "$size" "${CLAUDE_ASK_DEMO_DELAY:-0.03}")

      stop_pager_pipe
      print_batch_answer
      show_final_status_bar

      STREAM_OUTPUT="$save_stream"
      printf '\n'
    done
  done
}

# ---------------------------------------------------------------------------
# Session naming helpers
# ---------------------------------------------------------------------------
slugify_question() {
  local q="$1" max="${2:-50}"
  printf '%s' "$q" \
    | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^a-z0-9]/-/g; s/--*/-/g; s/^-//; s/-$//' \
    | cut -c1-"$max"
}

unique_session_name() {
  local base="$1" dir="$2"
  if [[ ! -f "${dir}/${base}.json" ]]; then
    printf '%s' "$base"
    return
  fi
  local n=2
  while [[ -f "${dir}/${base}-${n}.json" ]]; do
    ((n++))
  done
  printf '%s' "${base}-${n}"
}

# ---------------------------------------------------------------------------
# History & session viewing helpers
# ---------------------------------------------------------------------------
format_time_ago() {
  local ts="$1"
  local then_epoch now_epoch diff
  # jq parses the ISO 8601 timestamp the same way on GNU and BSD systems
  then_epoch=$(jq -rn --arg ts "$ts" '$ts | fromdateiso8601' 2> /dev/null) || return 0
  printf -v now_epoch '%(%s)T' -1
  diff=$((now_epoch - then_epoch))

  if [[ $diff -lt 60 ]]; then
    printf '%d sec ago' "$diff"
  elif [[ $diff -lt 3600 ]]; then
    printf '%d min ago' "$((diff / 60))"
  elif [[ $diff -lt 86400 ]]; then
    local hrs tenths
    hrs=$((diff / 3600))
    tenths=$(((diff % 3600) * 10 / 3600))
    if [[ $tenths -gt 0 ]]; then
      printf '%d.%d hrs ago' "$hrs" "$tenths"
    else
      printf '%d hrs ago' "$hrs"
    fi
  elif [[ $diff -lt 604800 ]]; then
    printf '%dd ago' "$((diff / 86400))"
  else
    printf '%dw ago' "$((diff / 604800))"
  fi
}

show_history() {
  local session_dir="$1"
  local files=()

  while IFS= read -r f; do
    [[ -n "$f" ]] && files+=("$f")
  done < <(ls -t "$session_dir"/*.json 2> /dev/null)

  if [[ ${#files[@]} -eq 0 ]]; then
    echo "No saved sessions." >&2
    return 1
  fi

  local idx=1
  for f in "${files[@]}"; do
    local name ts question_text answer_lines time_ago disp_name disp_q
    name=$(basename "$f" .json)
    ts=$(jq -r '.timestamp // empty' "$f" 2> /dev/null) || true
    question_text=$(jq -r '.question // empty' "$f" 2> /dev/null) || true
    answer_lines=$(jq -r '.answer // "" | split("\n") | length' "$f" 2> /dev/null) || true

    # Truncate name with ellipsis
    disp_name="$name"
    if [[ ${#disp_name} -gt $MAX_DISPLAY_NAME ]]; then
      disp_name="${disp_name:0:$((MAX_DISPLAY_NAME))}…"
    fi

    # Truncate question
    disp_q="$question_text"
    if [[ ${#disp_q} -gt 40 ]]; then
      disp_q="${disp_q:0:39}…"
    fi

    time_ago=""
    [[ -n "$ts" ]] && time_ago=$(format_time_ago "$ts")

    printf '%d | %-13s | %-*s | %-40s | %sL\n' \
      "$idx" "$time_ago" "$((MAX_DISPLAY_NAME + 1))" "$disp_name" "$disp_q" "$answer_lines"

    ((idx++))
  done
}

view_session() {
  local arg="$1"
  local session_dir="${SESSION_DIR}"

  if [[ -z "$arg" || "$arg" == "__SHOW_HISTORY__" ]]; then
    show_history "$session_dir"
    return
  fi

  local session_file=""

  # Check if arg is a numeric index
  if [[ "$arg" =~ ^[0-9]+$ ]]; then
    local files=()
    while IFS= read -r f; do
      [[ -n "$f" ]] && files+=("$f")
    done < <(ls -t "$session_dir"/*.json 2> /dev/null)

    local idx=$((arg))
    if [[ $idx -ge 1 && $idx -le ${#files[@]} ]]; then
      session_file="${files[$((idx - 1))]}"
    fi
  fi

  # If not found by index, try as name/id
  if [[ -z "$session_file" ]]; then
    if [[ -f "${session_dir}/${arg}.json" ]]; then
      session_file="${session_dir}/${arg}.json"
    else
      # Try prefix match
      local matches=()
      while IFS= read -r f; do
        [[ -n "$f" ]] && matches+=("$f")
      done < <(ls "${session_dir}/${arg}"*.json 2> /dev/null)
      if [[ ${#matches[@]} -eq 1 ]]; then
        session_file="${matches[0]}"
      elif [[ ${#matches[@]} -gt 1 ]]; then
        echo "Ambiguous session name '${arg}'. Matches:" >&2
        for m in "${matches[@]}"; do
          echo "  $(basename "$m" .json)" >&2
        done
        return 1
      fi
    fi
  fi

  if [[ -z "$session_file" || ! -f "$session_file" ]]; then
    echo "Session not found: ${arg}" >&2
    echo "" >&2
    show_history "$session_dir"
    return 1
  fi

  debug_log "viewing session: $session_file"

  # Extract session data
  local s_model s_cost s_dur s_input s_output s_answer
  s_model=$(jq -r '.model // "unknown"' "$session_file")
  s_cost=$(jq -r '.cost_usd // empty' "$session_file")
  s_dur=$(jq -r '.duration_ms // empty' "$session_file")
  s_input=$(jq -r '.usage.input_tokens // empty' "$session_file")
  s_output=$(jq -r '.usage.output_tokens // empty' "$session_file")
  s_answer=$(jq -r '.answer // ""' "$session_file")

  s_model=$(short_model_name "$s_model")

  # Format display values
  local disp_in disp_out disp_cost disp_dur
  disp_in=$(format_tokens "$s_input")
  disp_out=$(format_tokens "$s_output")
  disp_cost=$(format_cost "$s_cost")
  disp_dur=$(format_duration "$s_dur")

  # Render status bar inline (not pinned to terminal row 1)
  render_status_bar "✓" "$s_model" "$disp_in" "$disp_out" "$disp_cost" "$disp_dur" "done"
  printf '\n\n'

  # Pipe answer through pager
  if [[ "$USE_PAGER" -eq 1 ]]; then
    printf '%s' "$s_answer" | run_pager
  else
    printf '%s' "$s_answer"
  fi
  printf '\n'
}

if [[ "$SHOW_HISTORY" -eq 1 ]]; then
  mkdir -p "$SESSION_DIR"
  show_history "$SESSION_DIR"
  exit 0
fi

if [[ -n "$VIEW_SESSION" ]]; then
  mkdir -p "$SESSION_DIR"
  view_session "$VIEW_SESSION"
  exit 0
fi

# Allow sourcing for tests: if _CLAUDE_ASK_SOURCED is set, stop here
if [[ -n "${_CLAUDE_ASK_SOURCED:-}" ]]; then
  # shellcheck disable=SC2317 # exit is reached only when executed, not sourced
  return 0 2> /dev/null || exit 0
fi

# ---------------------------------------------------------------------------
# Cursor tracking & status bar rendering (below content)
# ---------------------------------------------------------------------------
CURSOR_COL=1 # 1-indexed terminal column position
STATUS_BAR_VISIBLE=0
STREAM_START=0

emit_text() {
  local text="$1"
  [[ -z "$text" ]] && return
  printf '%s' "$text"
  # Track column position after last newline
  if [[ "$text" == *$'\n'* ]]; then
    local after="${text##*$'\n'}"
    CURSOR_COL=$((${#after} + 1))
  else
    CURSOR_COL=$((CURSOR_COL + ${#text}))
  fi
}

update_status_bar() {
  local content info_content elapsed
  content="$(render_status_bar "$@")"
  elapsed=$((SECONDS - STREAM_START))
  info_content="$(render_stream_info "$answer_lines" "$answer_chars" "$text_chunks" "$elapsed" "$status" "$is_thinking")"
  # Clear from cursor to end of screen (removes old status bar + info)
  printf '\e[J'
  # Move down 2 lines, print status bar, then info line below
  printf '\n\n\e[2K%s\n\e[2K%s' "$content" "$info_content"
  # Move back up 3 lines (blank + status + info) and restore column
  printf '\e[3A\e[%dG' "$CURSOR_COL"
  STATUS_BAR_VISIBLE=1
}

finalize_status_bar() {
  local content info_content
  content="$(render_status_bar "$@")"
  info_content="$(render_stream_info "$answer_lines" "$answer_chars" "$text_chunks" "" "done" "$is_thinking")"
  # Clear from cursor to end of screen
  printf '\e[J'
  # Print final status bar + info line 2 lines below content
  printf '\n\n%s\n%s\n' "$content" "$info_content"
  STATUS_BAR_VISIBLE=0
}

# Advance the spinner and redraw the status bar from the stream state
refresh_status_bar() {
  local spin_char
  spinner_idx=$(((spinner_idx + 1) % ${#SPINNER[@]}))
  spin_char="${SPINNER[$spinner_idx]}"
  if [[ "$status" == "done" ]]; then spin_char="✓"; fi
  if [[ "$status" == "error" ]]; then spin_char="✗"; fi

  # Drain any rendered output from the pager before updating the status bar
  drain_bat

  update_status_bar "$spin_char" "${model:-...}" \
    "$(format_tokens "$input_tokens")" "$(format_tokens "$output_tokens")" \
    "$(format_cost "$cost")" "$(format_duration "$duration_ms")" "$status"
}

# The status bar left below the answer once the stream has ended
show_final_status_bar() {
  local mark="✓"
  if [[ "$status" != "done" ]]; then mark="✗"; fi
  finalize_status_bar "$mark" "${model:-...}" \
    "$(format_tokens "$input_tokens")" "$(format_tokens "$output_tokens")" \
    "$(format_cost "$cost")" "$(format_duration "$duration_ms")" "$status"
}

# In batch mode (--no-stream), render the complete answer once it is in
print_batch_answer() {
  [[ "$STREAM_OUTPUT" -eq 0 && -n "$answer_text" ]] || return 0
  # Clear the status bar area (was showing progress only)
  printf '\e[J'
  STATUS_BAR_VISIBLE=0
  if [[ "$USE_PAGER" -eq 1 ]]; then
    printf '%s' "$answer_text" | run_pager
  else
    printf '%s' "$answer_text"
  fi
  printf '\n'
}

# ---------------------------------------------------------------------------
# Per-run private directory (FIFO, raw stream, claude's stderr) and cleanup
# ---------------------------------------------------------------------------
run_dir_base="${XDG_RUNTIME_DIR:-}"
if [[ ! -d "$run_dir_base" || ! -w "$run_dir_base" ]]; then
  run_dir_base="${TMPDIR:-/tmp}"
fi
RUN_DIR=$(mktemp -d "${run_dir_base}/claude-ask.XXXXXX")

BAT_PID=""
BAT_FIFO=""
BAT_OUT_FD=""
CLAUDE_PID=""

cleanup() {
  debug_log "cleanup called"
  # Clear any lingering status bar below content
  if [[ "${STATUS_BAR_VISIBLE:-0}" -eq 1 ]]; then
    printf '\e[J'
  fi
  printf '\e[?25h' # ensure cursor visible
  if [[ -n "$BAT_PID" ]]; then kill "$BAT_PID" 2> /dev/null || true; fi
  if [[ -n "$CLAUDE_PID" ]]; then kill "$CLAUDE_PID" 2> /dev/null || true; fi
  if [[ -n "$BAT_OUT_FD" ]]; then exec {BAT_OUT_FD}<&- 2> /dev/null || true; fi
  rm -rf "$RUN_DIR" 2> /dev/null || true
}
trap cleanup EXIT INT TERM

# ---------------------------------------------------------------------------
# Streaming pager: the pager reads chunks from a FIFO and its rendered output
# is read back here, so it can be drained in step with status bar updates
# ---------------------------------------------------------------------------
start_pager_pipe() {
  BAT_FIFO="$RUN_DIR/pager.fifo"
  mkfifo "$BAT_FIFO"
  exec {BAT_OUT_FD}< <(run_pager < "$BAT_FIFO" 2> /dev/null)
  BAT_PID=$!
  exec 3> "$BAT_FIFO"
  debug_log "pager pipeline: fifo=$BAT_FIFO pid=$BAT_PID out_fd=$BAT_OUT_FD"
}

# Close the pager's input and print the rest of its output
stop_pager_pipe() {
  [[ -n "$BAT_OUT_FD" ]] || return 0
  exec 3>&-
  drain_bat_final
  exec {BAT_OUT_FD}<&-
  BAT_OUT_FD=""
  wait "$BAT_PID" 2> /dev/null || true
  BAT_PID=""
  rm -f "$BAT_FIFO"
  BAT_FIFO=""
}

# Write a text chunk: through the pager if running, otherwise to the terminal
write_chunk() {
  local chunk="$1"
  if [[ -n "$BAT_OUT_FD" ]]; then
    printf '%s' "$chunk" >&3
  else
    emit_text "$chunk"
  fi
}

# Drain available pager output into the terminal without blocking. Each read
# waits at most 10ms; on a timeout read keeps the text it got, so a line the
# pager has only partly written is printed as far as it goes instead of
# stalling the status bar until the pager finishes it.
drain_bat() {
  [[ -z "$BAT_OUT_FD" ]] && return
  local bat_line
  while true; do
    bat_line=""
    if IFS= read -r -t 0.01 bat_line <&"${BAT_OUT_FD}"; then
      emit_text "${bat_line}"$'\n'
    else
      # Timeout or EOF: print any partial line and stop
      emit_text "$bat_line"
      break
    fi
  done
}

# Drain all remaining pager output (blocking until EOF)
drain_bat_final() {
  [[ -z "$BAT_OUT_FD" ]] && return
  local bat_line
  # The || keeps a last line that has no trailing newline
  while IFS= read -r bat_line <&"${BAT_OUT_FD}" || [[ -n "$bat_line" ]]; do
    emit_text "${bat_line}"$'\n'
  done
}

# ---------------------------------------------------------------------------
# Demo output mode: run mock streams through the real rendering pipeline
# ---------------------------------------------------------------------------
if [[ "$DEMO_OUTPUT" -eq 1 ]]; then
  run_demo_output
  exit 0
fi

# ---------------------------------------------------------------------------
# Ask claude
# ---------------------------------------------------------------------------
require_cmds "$CLAUDE_BIN"
mkdir -p "$SESSION_DIR"

RAW_JSON="$RUN_DIR/stream.jsonl"
CLAUDE_STDERR="$RUN_DIR/claude.stderr"
: > "$RAW_JSON"

reset_stream_state
STREAM_START=$SECONDS

if [[ "$USE_PAGER" -eq 1 && "$STREAM_OUTPUT" -eq 1 ]]; then
  start_pager_pipe
fi

update_status_bar "${SPINNER[0]}" "connecting..." "" "" "" "" "running"

# claude runs on its own fd so its exit status can be collected afterwards.
# The question goes in on stdin, so one starting with "-" is never read as an
# option (and it stays out of the process list).
debug_log "starting main loop, streaming from $CLAUDE_BIN"
exec {CLAUDE_FD}< <("$CLAUDE_BIN" --output-format stream-json --verbose -p <<< "$question" 2> "$CLAUDE_STDERR")
CLAUDE_PID=$!

while IFS= read -r line <&"$CLAUDE_FD"; do
  printf '%s\n' "$line" >> "$RAW_JSON"
  process_stream_line "$line" || continue
  if [[ -n "$CHUNK" && "$STREAM_OUTPUT" -eq 1 ]]; then
    write_chunk "$CHUNK"
  fi
  refresh_status_bar
done

exec {CLAUDE_FD}<&-
claude_status=0
wait "$CLAUDE_PID" || claude_status=$?
CLAUDE_PID=""
debug_log "claude exited: status=$claude_status stream_status=$status"

stop_pager_pipe
print_batch_answer

# A stream that ended without a result event did not finish
if [[ "$status" == "running" ]]; then
  status="error"
fi
show_final_status_bar

if [[ -n "$session_id" && -s "$RAW_JSON" ]]; then
  save_session "$RAW_JSON" "$question" > /dev/null
fi

# ---------------------------------------------------------------------------
# Report failures: claude's exit status, an error result, or no result
# ---------------------------------------------------------------------------
if [[ "$claude_status" -ne 0 || "$status" == "error" ]]; then
  if [[ -n "$stream_error" ]]; then
    printf 'claude-ask: %s\n' "$stream_error" >&2
  elif [[ "$claude_status" -ne 0 ]]; then
    printf 'claude-ask: %s exited with status %d\n' "$CLAUDE_BIN" "$claude_status" >&2
  else
    printf 'claude-ask: the response ended without a result\n' >&2
  fi
  if [[ -s "$CLAUDE_STDERR" ]]; then
    sed 's/^/  /' "$CLAUDE_STDERR" >&2
  fi
  exit 1
fi
